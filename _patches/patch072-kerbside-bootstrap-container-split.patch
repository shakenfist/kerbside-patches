diff --git a/ansible/roles/kerbside/templates/kerbside_bootstrap.json.j2 b/ansible/roles/kerbside/templates/kerbside_bootstrap.json.j2
new file mode 100644
index 0000000..d04bfec
--- /dev/null
+++ b/ansible/roles/kerbside/templates/kerbside_bootstrap.json.j2
@@ -0,0 +1,24 @@
+{
+    "command": "/etc/kerbside/kerbside_alembic_wrapper",
+    "config_files": [
+        {
+            "source": "{{ container_config_directory }}/kerbside_config",
+            "dest": "/etc/kerbside/kerbside_config",
+            "owner": "kerbside",
+            "perm": "0600"
+        },
+        {
+            "source": "{{ container_config_directory }}/kerbside_alembic_wrapper",
+            "dest": "/etc/kerbside/kerbside_alembic_wrapper",
+            "owner": "kerbside",
+            "perm": "0700"
+        }
+    ],
+    "permissions": [
+        {
+            "path": "/var/log/kolla/kerbside",
+            "owner": "kerbside:kerbside",
+            "recurse": true
+        }
+    ]
+}
