commit 8eae52d37a3ff0c9bc56475bdfd3ef281afdf490
Author: Michael Still <mikal@stillhq.com>
Date:   Wed Oct 28 17:40:01 2026 +1100

    l3: Finish deleting an HA router that failed to initialize
    
    If HaRouter.initialize() fails after setting the HA port but before
    creating the keepalived manager, as an HA port with no fixed IP makes it
    do, the cleanup's delete() builds the state change monitor's command
    from that manager and stops with an AttributeError before radvd.
    
    Skip the monitor when there is no keepalived manager, since it is only
    spawned after the manager exists, so the rest of the router is deleted.
    
    Assisted-By: Claude Opus 5.5 (high effort)
    Change-Id: I96fc6e87504998aede426093534bb2a55fdc2e3b
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/neutron/agent/l3/ha_router.py b/neutron/agent/l3/ha_router.py
index dee944db3e..3254243b01 100644
--- a/neutron/agent/l3/ha_router.py
+++ b/neutron/agent/l3/ha_router.py
@@ -516,6 +516,12 @@ class HaRouter(router.RouterInfo):
             LOG.debug('Error while destroying state change monitor for %s - '
                       'no port', self.router_id)
             return
+        # The monitor is only spawned once the keepalived manager exists. If
+        # initialize() failed before creating it, there is nothing to stop.
+        if self.keepalived_manager is None:
+            LOG.debug('Error while destroying state change monitor for %s - '
+                      'no keepalived manager', self.router_id)
+            return
         pm = self._get_state_change_monitor_process_manager()
         process_monitor.unregister(
             self.router_id, IP_MONITOR_PROCESS_SERVICE)
