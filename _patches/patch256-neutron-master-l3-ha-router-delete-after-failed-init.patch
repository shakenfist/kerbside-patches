diff --git a/releasenotes/notes/l3-ha-router-delete-after-failed-initialize-e4fce5e2b1a94d7b.yaml b/releasenotes/notes/l3-ha-router-delete-after-failed-initialize-e4fce5e2b1a94d7b.yaml
