+
+from oslo_service import backend as service_backend
+
+# Placement is served by a WSGI server and has no use for the eventlet
+# oslo.service backend, which is the default if nothing has chosen one by the
+# time oslo.messaging is first imported, and which makes the process load
+# eventlet. Register the threading backend as the default instead. This is
+# only a default: init_backend() called earlier by a deployer, or a test,
+# still wins. It has to happen here, ahead of anything that imports
+# oslo.messaging, such as the audit middleware imported by placement.deploy.
+service_backend.register_backend_default_hook(
+    lambda: service_backend.BackendType.THREADING)
diff --git a/placement/tests/unit/test_deploy.py b/placement/tests/unit/test_deploy.py
index bcd5308..644334e 100644
--- a/placement/tests/unit/test_deploy.py
+++ b/placement/tests/unit/test_deploy.py
@@ -76,3 +76,22 @@ class DeployTest(testtools.TestCase):
         auth_header = response.headers['www-authenticate']
         self.assertIn(www_authenticate_uri, auth_header)
         self.assertIn('keystone uri=', auth_header.lower())
+
+    def test_threading_backend_is_default(self):
+        """Importing deploy leaves oslo.service on the threading backend."""
+        out = self._run_fresh("""
+            import placement.deploy
+            from oslo_service import backend
+            print(backend.get_backend().__class__.__name__)
+        """)
+        self.assertEqual('ThreadingBackend', out)
+
+    def test_explicit_backend_wins(self):
+        """A backend chosen before placement is imported is not replaced."""
+        out = self._run_fresh("""
+            from oslo_service import backend
+            backend.init_backend(backend.BackendType.EVENTLET)
+            import placement.deploy
+            print(backend.get_backend().__class__.__name__)
+        """)
+        self.assertEqual('EventletBackend', out)
diff --git a/releasenotes/notes/placement-threading-service-backend-3f1c2a9d7b4e5a60.yaml b/releasenotes/notes/placement-threading-service-backend-3f1c2a9d7b4e5a60.yaml
