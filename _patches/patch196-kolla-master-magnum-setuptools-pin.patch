diff --git a/kolla/docker/magnum/magnum-base/Dockerfile.j2 b/kolla/docker/magnum/magnum-base/Dockerfile.j2
index ef070f88f..eeac470b0 100644
--- a/kolla/docker/magnum/magnum-base/Dockerfile.j2
+++ b/kolla/docker/magnum/magnum-base/Dockerfile.j2
@@ -13,9 +13,14 @@ LABEL maintainer="{{ maintainer }}" name="{{ image_name }}"
 
 ADD magnum-base-archive /magnum-base-source
 
+# NOTE(mikal): magnum-cluster-api imports pkg_resources, which setuptools
+# 82 removed [1]. Pin setuptools until the importlib.resources migration
+# in https://github.com/vexxhost/magnum-cluster-api/pull/925 merges.
+# [1] https://setuptools.pypa.io/en/stable/history.html#v82-0-0
 {% set magnum_base_pip_packages = [
     '/magnum[osprofiler]',
-    'magnum-cluster-api'
+    'magnum-cluster-api',
+    'setuptools<82'
 ] %}
 
