+class ServerOnlyImportsTestCase(base.BaseTestCase):
+    # The DHCP, L3 and metadata agents use this module only to report their
+    # state; the resource cache is for the L2 agents.
+    MODULES = ('neutron.agent.dhcp.agent', 'neutron.agent.dhcp_agent',
+               'neutron.agent.l3.agent', 'neutron.agent.l3_agent',
+               'neutron.agent.linux.dhcp', 'neutron.agent.metadata.agent',
+               'neutron.agent.metadata_agent')
+
+    def test_agents_do_not_import_server_only_modules(self):
+        result = tools.check_imports(self.MODULES, tools.SERVER_ONLY_MODULES)
+        self.assertEqual([], result['holders'])
+
+    def test_agents_do_not_load_server_only_modules(self):
+        result = tools.check_imports(self.MODULES, tools.SERVER_ONLY_MODULES)
+        if result['preloaded']:
+            self.skipTest('neutron_lib loads %s itself' %
+                          ', '.join(result['preloaded']))
+        self.assertEqual([], result['loaded'])
