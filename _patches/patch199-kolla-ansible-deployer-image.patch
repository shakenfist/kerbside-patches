diff --git a/kolla/docker/kolla-ansible/Dockerfile.j2 b/kolla/docker/kolla-ansible/Dockerfile.j2
new file mode 100644
index 000000000..ddf399019
--- /dev/null
+++ b/kolla/docker/kolla-ansible/Dockerfile.j2
@@ -0,0 +1,91 @@
+FROM {{ namespace }}/{{ image_prefix }}openstack-base:{{ tag }}
+{% block labels %}
+LABEL maintainer="{{ maintainer }}" name="{{ image_name }}" kolla_ansible_launcher_protocol="1" openstack_release="{{ openstack_release }}"
+{% endblock %}
+
+{% block kolla_ansible_header %}{% endblock %}
+
+{% import "macros.j2" as macros with context %}
+
+{# NOTE: Collections are installed into one fixed path, which is the only
+   path Ansible searches. Without this, a collection installed into the
+   user's ~/.ansible/collections (for example by "kolla-ansible
+   install-deps") would silently shadow the ones baked into the image. #}
+{% set kolla_ansible_collections_path = '/usr/share/ansible/collections' %}
+{% set kolla_ansible_home = '/var/lib/kolla-ansible' %}
+{% set kolla_ansible_share = '/var/lib/kolla/venv/share/kolla-ansible' %}
+
+{{ macros.kolla_enable_base_repos() }}
+
+{{ macros.configure_user(name='ansible', homedir=kolla_ansible_home) }}
+
+{% if base_package_type == 'rpm' %}
+    {% set kolla_ansible_packages = [
+        'libcap',
+        'openssh-clients'
+    ] %}
+{% elif base_package_type == 'deb' %}
+    {% set kolla_ansible_packages = [
+        'libcap2-bin',
+        'openssh-client'
+    ] %}
+{% endif %}
+
+{{ macros.install_packages(kolla_ansible_packages | customizable("packages")) }}
+
+ENV ANSIBLE_COLLECTIONS_PATH={{ kolla_ansible_collections_path }}
+
+{% block kolla_ansible_install %}
+ADD kolla-ansible-archive /kolla-ansible-source
+ADD plugins-archive /
+
+{% set kolla_ansible_pip_packages = [
+    '/kolla-ansible'
+] %}
+
+RUN ln -s kolla-ansible-source/* kolla-ansible \
+    && {{ macros.install_pip(kolla_ansible_pip_packages | customizable("pip_packages")) }}
+{% endblock %}
+
+{% block kolla_ansible_collections_install %}
+RUN fail=1; for i in $(seq 1 5); do if \
+ansible-galaxy collection install --timeout 120 -p {{ kolla_ansible_collections_path }} -r {{ kolla_ansible_share }}/requirements-core.yml \
+; then fail=0; break; fi; echo "Collection download failed, retrying"; sleep 5; done; \
+if [ "$fail" -eq 1 ]; then exit 1; fi \
+    && ansible-galaxy collection install -p {{ kolla_ansible_collections_path }} /plugins/*ansible-collection-kolla* \
+    && rm -rf /root/.ansible
+{% endblock %}
+
+COPY kolla_ansible_deployer_info.py /usr/local/bin/kolla_ansible_deployer_info
+
+RUN chmod 755 /usr/local/bin/kolla_ansible_deployer_info \
+    && mkdir -p /etc/kolla-ansible \
+    && kolla_ansible_deployer_info \
+        --source kolla-ansible=/kolla-ansible \
+        --source ansible-collection-kolla=$(ls -d /plugins/*ansible-collection-kolla* | head -n 1) \
+        --output /etc/kolla-ansible/deployer.json \
+    && chmod 644 /etc/kolla-ansible/deployer.json \
+    && rm -rf /root/.ansible \
+    && setcap cap_sys_admin,cap_sys_ptrace,cap_sys_chroot+ep "$(readlink -f /usr/bin/nsenter)" \
+    && chmod 1777 {{ kolla_ansible_home }}
+
+{{ macros.kolla_patch_sources() }}
+
+{% block kolla_ansible_footer %}{% endblock %}
+{% block footer %}{% endblock %}
+{{ macros.kolla_cleanup_repos() }}
+
+{# NOTE: HOME is world writable and sticky so that the image can be run as
+   an arbitrary UID with no passwd entry, as Ansible needs a writable home
+   for its local temporary directory and SSH control path. It is set last
+   so that nothing the build runs as root writes into it. #}
+ENV HOME={{ kolla_ansible_home }}
+
+{% if use_dumb_init %}
+ENTRYPOINT ["dumb-init", "--single-child", "--", "kolla-ansible"]
+{% else %}
+ENTRYPOINT ["kolla-ansible"]
+{% endif %}
+CMD ["--help"]
+
+USER ansible
diff --git a/kolla/docker/kolla-ansible/kolla_ansible_deployer_info.py b/kolla/docker/kolla-ansible/kolla_ansible_deployer_info.py
new file mode 100644
index 000000000..1fe5ff700
--- /dev/null
+++ b/kolla/docker/kolla-ansible/kolla_ansible_deployer_info.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Record what a kolla-ansible deployer image was built from.
+
+This runs once, at image build time, and writes a JSON document describing
+the Kolla-Ansible version, the git commit of each source tree the image was
+built from, and the Ansible collections installed into the image. Image
+labels cannot be set from the output of a build step, so this file is where
+that information lives.
+"""
+
+import argparse
+from importlib import metadata
+import json
+import os
+import subprocess  # nosec
+import sys
+
+UNKNOWN = 'unknown'
+
+
+def package_version(name):
+    try:
+        return metadata.version(name)
+    except metadata.PackageNotFoundError:
+        return UNKNOWN
+
+
+def git_sha(path):
+    """Return the commit a source tree was built from, if it is known.
+
+    Sources fetched as tarballs have no git metadata, so their commit is
+    reported as unknown rather than guessed.
+    """
+    if not os.path.exists(os.path.join(path, '.git')):
+        return UNKNOWN
+    try:
+        return subprocess.check_output(  # nosec
+            ['git', '-c', 'safe.directory=*', '-C', path,
+             'rev-parse', 'HEAD'],
+            text=True).strip()
+    except (OSError, subprocess.CalledProcessError):
+        return UNKNOWN
+
+
+def installed_collections():
+    output = subprocess.check_output(  # nosec
+        ['ansible-galaxy', 'collection', 'list', '--format', 'json'],
+        text=True)
+    return json.loads(output)
+
+
+def parse_source(value):
+    name, sep, path = value.partition('=')
+    if not sep or not name or not path:
+        raise argparse.ArgumentTypeError(
+            'Sources must be given as NAME=PATH, not %r' % value)
+    return name, path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('--source', action='append', default=[],
+                        type=parse_source,
+                        help='A source tree, as NAME=PATH. May be repeated.')
+    parser.add_argument('--output', required=True,
+                        help='The file to write the JSON document to.')
+    args = parser.parse_args()
+
+    info = {
+        'kolla_ansible_version': package_version('kolla-ansible'),
+        'ansible_core_version': package_version('ansible-core'),
+        'sources': {name: {'path': path, 'git_sha': git_sha(path)}
+                    for name, path in args.source},
+        'collections': installed_collections(),
+    }
+
+    with open(args.output, 'w') as f:
+        json.dump(info, f, indent=2, sort_keys=True)
+        f.write('\n')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/releasenotes/notes/add-kolla-ansible-image-0746f6311029c37f.yaml b/releasenotes/notes/add-kolla-ansible-image-0746f6311029c37f.yaml
