+import subprocess
+import sys
+
+import testtools
+
+
+class OsloServiceBackendTestCase(testtools.TestCase):
+    """Check which oslo.service backend keystone selects.
+
+    The backend is process wide and cannot be unselected, so each case runs
+    in a fresh interpreter.
+    """
+
+    def _run(self, script):
+        result = subprocess.run(
+            [sys.executable, '-c', script], capture_output=True, text=True
+        )
+        self.assertEqual(0, result.returncode, result.stderr)
+        return result.stdout.strip()
+
+    def test_default_is_threading(self):
+        out = self._run(
+            'import keystone\n'
+            'from oslo_service import backend\n'
+            'backend.get_backend()\n'
+            'print(backend.get_backend_type().value)\n'
+        )
+        self.assertEqual('threading', out)
+
+    def test_importing_oslo_messaging_selects_threading(self):
+        # oslo.messaging fixes the backend when it is first imported, so the
+        # default has to be registered before that happens.
+        out = self._run(
+            'import keystone\n'
+            'import oslo_messaging\n'
+            'from oslo_service import backend\n'
+            'print(backend.get_backend_type().value)\n'
+        )
+        self.assertEqual('threading', out)
+
+    def test_explicit_backend_wins(self):
+        out = self._run(
+            'from oslo_service import backend\n'
+            'backend.init_backend(backend.BackendType.EVENTLET)\n'
+            'import keystone\n'
+            'backend.get_backend()\n'
+            'print(backend.get_backend_type().value)\n'
+        )
+        self.assertEqual('eventlet', out)
diff --git a/releasenotes/notes/oslo-service-threading-backend-5f0c1d7a3b9e4c28.yaml b/releasenotes/notes/oslo-service-threading-backend-5f0c1d7a3b9e4c28.yaml
