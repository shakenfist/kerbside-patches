+from oslo_service import backend
+
+# Keystone does not use eventlet. Make the threading backend the default
+# for oslo.service so that oslo.messaging, which asks for a backend when it
+# is first imported, does not select eventlet and import it. This must be
+# registered before anything imports oslo.messaging, so it lives here in the
+# package __init__. It sets a default only: an operator or a test that has
+# already called backend.init_backend() keeps its choice.
+backend.register_backend_default_hook(lambda: backend.BackendType.THREADING)
