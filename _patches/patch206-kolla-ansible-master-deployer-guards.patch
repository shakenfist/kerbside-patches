+def _deployer(release='2026.1', version='23.0.0', tag='2026.1-debian-trixie',
+              sha='a' * 40):
+    return {
+        'kolla_ansible_version': version,
+        'openstack_release': release,
+        'tag': tag,
+        'sources': {'kolla-ansible': {'path': '/kolla-ansible',
+                                      'git_sha': sha}},
+    }
+
+
+def _record(release='2026.1', version='23.0.0', **kwargs):
+    record = {
+        'format_version': 1,
+        'openstack_release': release,
+        'openstack_tag': '%s-debian-trixie' % release,
+        'kolla_ansible_version': version,
+        'kolla_ansible_git_sha': 'b' * 40,
+        'deployer_tag': '%s-debian-trixie' % release,
+        'kolla_action': 'deploy',
+        'timestamp': '2026-10-11T01:02:03Z',
+    }
+    record.update(kwargs)
+    return json.dumps(record)
