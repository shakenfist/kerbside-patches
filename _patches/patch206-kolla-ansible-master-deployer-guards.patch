+class TestReleases(unittest.TestCase):
+
+    def test_parse(self):
+        self.assertEqual((2025, 1), dc.parse_release('2025.1'))
+        self.assertEqual((2026, 2), dc.parse_release('2026.2'))
+        self.assertGreater(dc.parse_release('master'),
+                           dc.parse_release('2099.2'))
+
+    def test_parse_invalid(self):
+        for release in ('zed', '2025.3', '2025', '25.1', '', None,
+                        'stable/2025.1'):
+            with self.subTest(release=release):
+                self.assertRaises(dc.ReleaseError, dc.parse_release, release)
+
+    def test_compare(self):
+        ordered = ['2025.1', '2025.2', '2026.1', '2026.2', 'master']
+        for i, older in enumerate(ordered):
+            self.assertEqual(0, dc.compare_releases(older, older))
+            for newer in ordered[i + 1:]:
+                with self.subTest(older=older, newer=newer):
+                    self.assertEqual(-1, dc.compare_releases(older, newer))
+                    self.assertEqual(1, dc.compare_releases(newer, older))
+
+    def test_upgrade_targets(self):
+        self.assertEqual(['2025.2', '2026.1'], dc.upgrade_targets('2025.1'))
+        self.assertEqual(['2026.1'], dc.upgrade_targets('2025.2'))
+        self.assertEqual([], dc.upgrade_targets('master'))
+
