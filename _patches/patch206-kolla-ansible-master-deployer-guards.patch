diff --git a/kolla_ansible/deployer_checks.py b/kolla_ansible/deployer_checks.py
new file mode 100644
index 000000000..bbb5e9c1c
--- /dev/null
+++ b/kolla_ansible/deployer_checks.py
@@ -0,0 +1,331 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Checks of a containerised deployer against its configuration and targets.
+
+A Kolla Ansible deployer image records what it was built from in a JSON
+document (deployer.json). Every successful deploy, reconfigure or upgrade
+records on each target what changed it last (the deployment record). The
+filters here compare the two, so that a deployer is not run against a
+configuration naming images it was not built with, against a deployment last
+changed by a newer deployer, or as an upgrade upstream does not support.
+"""
+
+import datetime
+from importlib import metadata
+import json
+import math
+import re
+
+from packaging import version as packaging_version
+
+OVERRIDE_OPTION = '--override-deployer-checks'
+OVERRIDE_HINT = 'Pass %s to override this check.' % OVERRIDE_OPTION
+UNKNOWN = 'unknown'
+RECORD_FORMAT_VERSION = 1
+
+# Actions, as the kolla_action variable names them, which may run with a
+# deployer for a newer release than the deployment, before it is upgraded.
+PRE_UPGRADE_ACTIONS = ('bootstrap-servers', 'pull', 'precheck',
+                       'gather-facts')
+# The same, as an operator types them.
+PRE_UPGRADE_COMMANDS = 'bootstrap-servers, pull, prechecks, gather-facts'
+UPGRADE_ACTION = 'upgrade'
+# Actions which change only the deploy host, and so are not checked against
+# the deployment records of the targets.
+DEPLOY_HOST_ACTIONS = ('certificates', 'octavia-certificates', 'post-deploy')
+
+_RELEASE_RE = re.compile(r'^(\d{4})\.([12])$')
+_MASTER = 'master'
+
+
+class ReleaseError(ValueError):
+    """A release name which cannot be compared."""
+
+
+def parse_release(release):
+    """Return a sortable key for an OpenStack release series.
+
+    Series are named YYYY.1 and YYYY.2. master sorts above every series.
+    """
+    if release == _MASTER:
+        return (math.inf, math.inf)
+    match = _RELEASE_RE.match(str(release)) if release else None
+    if not match:
+        raise ReleaseError(release)
+    return (int(match.group(1)), int(match.group(2)))
+
+
+def compare_releases(a, b):
+    """Return -1, 0 or 1 as release a is older than, equal to or newer than b.
+
+    Raises ReleaseError if either cannot be parsed.
+    """
+    key_a = parse_release(a)
+    key_b = parse_release(b)
+    return (key_a > key_b) - (key_a < key_b)
+
+
+def upgrade_targets(release):
+    """Return the series a deployment at release may be upgraded to.
+
+    A series may be upgraded to the next one, and a .1 series, which is a
+    skip-level upgrade release (SLURP), also to the next .1. An upgrade to
+    master is handled separately, because master's place among the series
+    cannot be known.
+    """
+    if release == _MASTER:
+        return []
+    year, minor = parse_release(release)
+    if minor == 1:
+        return ['%d.2' % year, '%d.1' % (year + 1)]
+    return ['%d.1' % (year + 1)]
+
+
+def compare_versions(a, b):
+    """Return -1, 0 or 1 as version a is older than, equal to or newer than b.
+
+    Versions are compared as PEP 440 versions, which orders pbr's .devN
+    versions correctly. Returns None if either cannot be parsed.
+    """
+    try:
+        version_a = packaging_version.Version(str(a))
+        version_b = packaging_version.Version(str(b))
+    except packaging_version.InvalidVersion:
+        return None
+    return (version_a > version_b) - (version_a < version_b)
+
+
+def _installed_version():
+    try:
+        return metadata.version('kolla-ansible')
+    except metadata.PackageNotFoundError:
+        return UNKNOWN
+
+
+def _installed_git_sha():
+    """Return the commit pbr recorded when Kolla Ansible was installed."""
+    try:
+        pbr_json = metadata.distribution('kolla-ansible').read_text(
+            'pbr.json')
+        return json.loads(pbr_json).get('git_version') or UNKNOWN
+    except (metadata.PackageNotFoundError, TypeError, ValueError,
+            AttributeError):
+        return UNKNOWN
+
+
+def deployer_identity(deployer_info):
+    """Return what this deployer is.
+
+    In a deployer image, this comes from its deployer.json. Otherwise, for
+    example in a virtualenv, the version and commit come from the installed
+    package and there is no tag or release.
+    """
+    deployer_info = deployer_info or {}
+    sha = (deployer_info.get('sources', {}).get('kolla-ansible', {})
+           .get('git_sha'))
+    if not sha or sha == UNKNOWN:
+        sha = _installed_git_sha()
+    return {
+        'kolla_ansible_version': (deployer_info.get('kolla_ansible_version') or
+                                  _installed_version()),
+        'kolla_ansible_git_sha': sha,
+        'tag': deployer_info.get('tag'),
+        'openstack_release': deployer_info.get('openstack_release'),
+    }
+
+
+def _result(errors, warnings, override):
+    if override:
+        warnings = warnings + [
+            'Overriding this refusal because %s was given: %s'
+            % (OVERRIDE_OPTION, error) for error in errors]
+        errors = []
+    return {'errors': errors, 'warnings': warnings}
+
+
+def deployer_config_check(deployer_info, openstack_release, openstack_tag,
+                          override=False):
+    """Check a deployer image against the configuration.
+
+    Returns a dict of the refusals ('errors') and 'warnings'. With override,
+    refusals are returned as warnings instead.
+    """
+    identity = deployer_identity(deployer_info)
+    errors = []
+    warnings = []
+
+    tag = identity['tag']
+    if not tag:
+        warnings.append(
+            "This deployer's deployer.json does not record its tag, so "
+            "openstack_tag was not checked.")
+    elif tag != openstack_tag:
+        errors.append(
+            'This deployer was built with tag %s, but openstack_tag is %s. '
+            'Use the deployer built with %s, or set openstack_tag to %s. %s'
+            % (tag, openstack_tag, openstack_tag, tag, OVERRIDE_HINT))
+
+    release = identity['openstack_release']
+    if not release:
+        warnings.append(
+            "This deployer's deployer.json does not record its release, so "
+            "openstack_release was not checked.")
+    elif release != openstack_release:
+        errors.append(
+            'This deployer was built for release %s, but openstack_release '
+            'is %s. Use a deployer built for %s, or set openstack_release to '
+            '%s. %s'
+            % (release, openstack_release, openstack_release, release,
+               OVERRIDE_HINT))
+
+    return _result(errors, warnings, override)
+
+
+def _describe_record(record, host, path):
+    return ("%s's deployment record %s says it was last changed by "
+            "Kolla Ansible %s for release %s (commit %s, action %s, %s)."
+            % (host, path,
+               record.get('kolla_ansible_version'),
+               record.get('openstack_release'),
+               record.get('kolla_ansible_git_sha') or UNKNOWN,
+               record.get('kolla_action') or UNKNOWN,
+               record.get('timestamp') or UNKNOWN))
+
+
+def _describe_deployer(identity):
+    return ('This deployer is Kolla Ansible %s for release %s '
+            '(commit %s, tag %s).'
+            % (identity['kolla_ansible_version'],
+               identity['openstack_release'],
+               identity['kolla_ansible_git_sha'] or UNKNOWN,
+               identity['tag'] or UNKNOWN))
+
+
+def deployer_record_check(record_text, deployer_info, kolla_action, host,
+                          path, override=False):
+    """Check a deployer image against one target's deployment record.
+
+    record_text is the record's content, or None if the target has none.
+    Returns a dict of the refusals ('errors') and 'warnings'. With override,
+    refusals are returned as warnings instead.
+    """
+    errors = []
+    warnings = []
+    action = kolla_action or ''
+
+    if record_text is None or action in DEPLOY_HOST_ACTIONS:
+        return _result(errors, warnings, override)
+
+    try:
+        record = json.loads(record_text)
+        if not isinstance(record, dict):
+            raise ValueError('the record is not a JSON object')
+        missing = [field for field in ('openstack_release',
+                                       'kolla_ansible_version')
+                   if not record.get(field)]
+        if missing:
+            raise ValueError('the record has no %s' % ' or '.join(missing))
+    except ValueError as e:
+        errors.append(
+            "%s's deployment record %s could not be read: %s. Correct or "
+            "remove it. %s" % (host, path, e, OVERRIDE_HINT))
+        return _result(errors, warnings, override)
+
+    identity = deployer_identity(deployer_info)
+    if not identity['openstack_release']:
+        warnings.append(
+            "This deployer's deployer.json does not record its release, so "
+            "it was not checked against %s's deployment record." % host)
+        return _result(errors, warnings, override)
+
+    described = '%s %s' % (_describe_record(record, host, path),
+                           _describe_deployer(identity))
+    d_release = identity['openstack_release']
+    r_release = record['openstack_release']
+    d_version = identity['kolla_ansible_version']
+    r_version = record['kolla_ansible_version']
+
+    try:
+        releases = compare_releases(d_release, r_release)
+    except ReleaseError as e:
+        errors.append(
+            '%s Release %s cannot be compared: releases must be master, '
+            'YYYY.1 or YYYY.2. %s' % (described, e, OVERRIDE_HINT))
+        return _result(errors, warnings, override)
+
+    if releases < 0:
+        errors.append(
+            '%s Release %s is older than %s, and an older deployer cannot '
+            'manage a newer deployment. Use a deployer for %s or later. %s'
+            % (described, d_release, r_release, r_release, OVERRIDE_HINT))
+
+    elif releases == 0:
+        versions = compare_versions(d_version, r_version)
+        if versions is None:
+            warnings.append(
+                '%s Kolla Ansible versions %s and %s cannot be compared, so '
+                'only the releases were checked.'
+                % (described, d_version, r_version))
+        elif versions < 0:
+            errors.append(
+                '%s Kolla Ansible %s is older than %s. Use a deployer at '
+                'Kolla Ansible %s or later. %s'
+                % (described, d_version, r_version, r_version,
+                   OVERRIDE_HINT))
+
+    elif action in PRE_UPGRADE_ACTIONS:
+        pass
+
+    elif action == UPGRADE_ACTION:
+        if d_release == _MASTER:
+            warnings.append(
+                '%s Upgrading from %s to master: whether this is a '
+                'supported upgrade cannot be known from the deployer. Check '
+                'the release notes before continuing.'
+                % (described, r_release))
+        elif d_release not in upgrade_targets(r_release):
+            errors.append(
+                '%s Upgrading from %s to %s is not a supported upgrade '
+                'path. From %s the supported upgrades are to %s. Upgrade '
+                'through each release in turn. %s'
+                % (described, r_release, d_release, r_release,
+                   '%s or %s' % (', '.join(upgrade_targets(r_release)),
+                                 _MASTER),
+                   OVERRIDE_HINT))
+
+    else:
+        errors.append(
+            '%s Release %s is newer than %s, so %s cannot run until the '
+            'deployment is upgraded. Before an upgrade only %s and upgrade '
+            'may run. Run kolla-ansible upgrade first. %s'
+            % (described, d_release, r_release, action or 'this action',
+               PRE_UPGRADE_COMMANDS, OVERRIDE_HINT))
+
+    return _result(errors, warnings, override)
+
+
+def deployment_record(deployer_info, openstack_release, openstack_tag,
+                      kolla_action):
+    """Return the deployment record to write on a target."""
+    identity = deployer_identity(deployer_info)
+    now = datetime.datetime.now(datetime.timezone.utc)
+    return {
+        'format_version': RECORD_FORMAT_VERSION,
+        'openstack_release': openstack_release,
+        'openstack_tag': openstack_tag,
+        'kolla_ansible_version': identity['kolla_ansible_version'],
+        'kolla_ansible_git_sha': identity['kolla_ansible_git_sha'],
+        'deployer_tag': identity['tag'],
+        'kolla_action': kolla_action,
+        'timestamp': now.strftime('%Y-%m-%dT%H:%M:%SZ'),
+    }
