+class TestVersions(unittest.TestCase):
+
+    def test_order(self):
+        ordered = ['22.1.0.dev266', '22.1.0.dev300', '22.1.0', '22.1.1',
+                   '23.0.0.dev1']
+        for i, older in enumerate(ordered):
+            self.assertEqual(0, dc.compare_versions(older, older))
+            for newer in ordered[i + 1:]:
+                with self.subTest(older=older, newer=newer):
+                    self.assertEqual(-1, dc.compare_versions(older, newer))
+                    self.assertEqual(1, dc.compare_versions(newer, older))
+
+    def test_unknown(self):
+        self.assertIsNone(dc.compare_versions('unknown', '22.1.0'))
+        self.assertIsNone(dc.compare_versions('22.1.0', None))
+
