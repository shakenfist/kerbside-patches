diff --git a/ansible/deployer-checks.yml b/ansible/deployer-checks.yml
new file mode 100644
index 000000000..14d63876e
--- /dev/null
+++ b/ansible/deployer-checks.yml
@@ -0,0 +1,84 @@
+---
+# NOTE: A containerised deployer records what it was built from in
+# kolla_deployer_info_path. When that file exists, this play refuses to run
+# a deployer against a configuration naming images it was not built with,
+# against a target last changed by a newer deployer, or as an upgrade which
+# is not supported. Without it, as in a virtualenv, the play does nothing.
+# kolla-ansible --override-deployer-checks turns each refusal into a warning.
+#
+# Every playbook imports this first, apart from destroy.yml, which must work
+# whatever the versions so that a mistake can always be cleaned up. Importers
+# set kolla_deployer_checks_hosts to the hosts they act on, and those which
+# act only on the deploy host set kolla_deployer_checks_records to false.
+#
+# The configuration check uses only a lookup and controller-side actions, so
+# it reads the deployer's own files wherever localhost's connection goes.
+# Refusals are fatal to the whole run rather than to one host. Unreachable
+# hosts are left to the gather facts play, as before.
+- name: Check the deployer against the configuration and the deployment
+  hosts: "{{ kolla_deployer_checks_hosts | default('all') }}"
+  gather_facts: false
+  tasks:
+    - name: Check the deployer
+      when: kolla_deployer_info | length > 0
+      block:
+        - name: Check the deployer against the configuration
+          vars:
+            kolla_deployer_config_check_result: >-
+              {{ kolla_deployer_info |
+                 kolla_deployer_config_check(openstack_release, openstack_tag,
+                                             kolla_override_deployer_checks | bool) }}
+          block:
+            - name: Warn about the deployer and the configuration  # noqa: run-once[task]
+              ansible.builtin.debug:
+                msg: "{{ kolla_deployer_config_check_result.warnings }}"
+              run_once: true
+              when: kolla_deployer_config_check_result.warnings | length > 0
+
+            - name: Refuse a configuration this deployer was not built for  # noqa: run-once[task]
+              ansible.builtin.fail:
+                msg: "{{ kolla_deployer_config_check_result.errors | join(' ') }}"
+              run_once: true
+              any_errors_fatal: true
+              when: kolla_deployer_config_check_result.errors | length > 0
+
+        - name: Check the deployer against the deployment
+          when: kolla_deployer_checks_records | default(true) | bool
+          block:
+            - name: Check whether there is a deployment record
+              become: true
+              ansible.builtin.stat:
+                path: "{{ kolla_deployment_record_path }}"
+                get_checksum: false
+              ignore_unreachable: true
+              register: kolla_deployment_record_stat
+
+            - name: Read the deployment record
+              become: true
+              ansible.builtin.slurp:
+                src: "{{ kolla_deployment_record_path }}"
+              register: kolla_deployment_record_file
+              when:
+                - kolla_deployment_record_stat.stat is defined
+                - kolla_deployment_record_stat.stat.exists
+
+            - name: Compare the deployer with the deployment record
+              vars:
+                kolla_deployer_record_check_result: >-
+                  {{ (kolla_deployment_record_file.content | b64decode
+                      if kolla_deployment_record_file.content is defined else none) |
+                     kolla_deployer_record_check(kolla_deployer_info, kolla_action | default(''),
+                                                 inventory_hostname, kolla_deployment_record_path,
+                                                 kolla_override_deployer_checks | bool) }}
+              block:
+                - name: Warn about the deployer and the deployment record
+                  ansible.builtin.debug:
+                    msg: "{{ kolla_deployer_record_check_result.warnings }}"
+                  when: kolla_deployer_record_check_result.warnings | length > 0
+
+                - name: Refuse a deployment this deployer must not change
+                  ansible.builtin.fail:
+                    msg: "{{ kolla_deployer_record_check_result.errors | join(' ') }}"
+                  any_errors_fatal: true
+                  when: kolla_deployer_record_check_result.errors | length > 0
+  tags: always
