+class TestRecordCheck(unittest.TestCase):
+
+    ALL_ACTIONS = (
+        'bootstrap-servers', 'pull', 'precheck', 'gather-facts', 'upgrade',
+        'deploy', 'deploy-containers', 'reconfigure', 'stop', 'check',
+        'config', 'config_validate', 'prune-images', 'nova-libvirt-cleanup',
+        'migrate-container-engine', 'backup', 'rabbitmq-reset-state',
+        'deploy-servers', '')
+    REFUSED_BEFORE_UPGRADE = tuple(
+        a for a in ALL_ACTIONS
+        if a not in ('bootstrap-servers', 'pull', 'precheck', 'gather-facts',
+                     'upgrade'))
+
+    def _check(self, record_text, deployer=None, action='deploy',
+               override=False):
+        return dc.deployer_record_check(
+            record_text, deployer or _deployer(), action, HOST, PATH,
+            override=override)
+
+    def assertClean(self, result):
+        self.assertEqual({'errors': [], 'warnings': []}, result)
+
+    def assertRefused(self, result, *fragments):
+        self.assertEqual(1, len(result['errors']), result)
+        self.assertEqual([], result['warnings'])
+        message = result['errors'][0]
+        self.assertTrue(message.endswith(HINT), message)
+        for fragment in fragments:
+            self.assertIn(fragment, message)
+
+    def test_no_record(self):
+        for action in self.ALL_ACTIONS:
+            with self.subTest(action=action):
+                self.assertClean(self._check(None, action=action))
+
+    def test_same_release_same_version(self):
+        for action in self.ALL_ACTIONS:
+            with self.subTest(action=action):
+                self.assertClean(self._check(_record(), action=action))
+
+    def test_same_release_newer_deployer_version(self):
+        self.assertClean(self._check(_record(version='23.0.0.dev10')))
+
+    def test_same_release_older_deployer_version(self):
+        for action in self.ALL_ACTIONS:
+            with self.subTest(action=action):
+                result = self._check(_record(version='23.0.1'),
+                                     action=action)
+                self.assertRefused(
+                    result,
+                    "controller0's deployment record %s says it was last "
+                    "changed by Kolla Ansible 23.0.1 for release 2026.1 "
+                    "(commit %s, action deploy, 2026-10-11T01:02:03Z)."
+                    % (PATH, 'b' * 40),
+                    'This deployer is Kolla Ansible 23.0.0 for release '
+                    '2026.1 (commit %s, tag 2026.1-debian-trixie).'
+                    % ('a' * 40),
+                    'Kolla Ansible 23.0.0 is older than 23.0.1. Use a '
+                    'deployer at Kolla Ansible 23.0.1 or later.')
+
+    def test_dev_versions(self):
+        deployer = _deployer(release='master', version='22.1.0.dev266')
+        self.assertClean(self._check(
+            _record(release='master', version='22.1.0.dev100'), deployer))
+        self.assertRefused(
+            self._check(_record(release='master', version='22.1.0.dev300'),
+                        deployer),
+            'Kolla Ansible 22.1.0.dev266 is older than 22.1.0.dev300.')
+
+    def test_unknown_versions(self):
+        result = self._check(_record(version='unknown'))
+        self.assertEqual([], result['errors'])
+        self.assertEqual(1, len(result['warnings']))
+        self.assertIn('Kolla Ansible versions 23.0.0 and unknown cannot be '
+                      'compared, so only the releases were checked.',
+                      result['warnings'][0])
+
+    def test_older_release(self):
+        for action in self.ALL_ACTIONS:
+            with self.subTest(action=action):
+                self.assertRefused(
+                    self._check(_record(release='2026.2', version='23.1.0'),
+                                action=action),
+                    'Release 2026.1 is older than 2026.2, and an older '
+                    'deployer cannot manage a newer deployment. Use a '
+                    'deployer for 2026.2 or later.')
+
+    def test_older_release_newer_version(self):
+        # The release decides, whatever the versions say.
+        self.assertRefused(
+            self._check(_record(release='2026.2', version='1.0.0')),
+            'Release 2026.1 is older than 2026.2')
+
+    def test_master_record_stable_deployer(self):
+        self.assertRefused(
+            self._check(_record(release='master', version='22.1.0.dev1')),
+            'Release 2026.1 is older than master')
+
+    def test_newer_release_before_upgrade(self):
+        record = _record(release='2025.2', version='22.0.0')
+        for action in ('bootstrap-servers', 'pull', 'precheck',
+                       'gather-facts'):
+            with self.subTest(action=action):
+                self.assertClean(self._check(record, action=action))
+
+    def test_newer_release_refused_until_upgraded(self):
+        record = _record(release='2025.2', version='22.0.0')
+        for action in self.REFUSED_BEFORE_UPGRADE:
+            with self.subTest(action=action):
+                self.assertRefused(
+                    self._check(record, action=action),
+                    'Release 2026.1 is newer than 2025.2, so %s cannot run '
+                    'until the deployment is upgraded. Before an upgrade '
+                    'only bootstrap-servers, pull, prechecks, gather-facts '
+                    'and upgrade may run. Run kolla-ansible upgrade first.'
+                    % (action or 'this action'))
+
+    def test_upgrade_paths(self):
+        supported = [('2025.1', '2025.2'), ('2025.2', '2026.1'),
+                     ('2025.1', '2026.1'), ('2026.1', '2026.2')]
+        for old, new in supported:
+            with self.subTest(old=old, new=new):
+                self.assertClean(self._check(
+                    _record(release=old, version='1.0.0'),
+                    _deployer(release=new, tag=new), action='upgrade'))
+
+    def test_unsupported_upgrade_paths(self):
+        unsupported = [('2025.2', '2026.2', '2026.1'),
+                       ('2025.1', '2026.2', '2025.2, 2026.1'),
+                       ('2024.1', '2026.1', '2024.2, 2025.1'),
+                       ('2024.2', '2025.2', '2025.1')]
+        for old, new, targets in unsupported:
+            with self.subTest(old=old, new=new):
+                self.assertRefused(
+                    self._check(_record(release=old, version='1.0.0'),
+                                _deployer(release=new, tag=new),
+                                action='upgrade'),
+                    'Upgrading from %s to %s is not a supported upgrade '
+                    'path. From %s the supported upgrades are to %s or '
+                    'master. Upgrade through each release in turn.'
+                    % (old, new, old, targets))
+
+    def test_upgrade_to_master(self):
+        for old in ('2024.1', '2025.2', '2026.2'):
+            with self.subTest(old=old):
+                result = self._check(
+                    _record(release=old, version='1.0.0'),
+                    _deployer(release='master', version='23.0.0.dev1'),
+                    action='upgrade')
+                self.assertEqual([], result['errors'])
+                self.assertEqual(1, len(result['warnings']))
+                self.assertIn(
+                    'Upgrading from %s to master: whether this is a '
+                    'supported upgrade cannot be known from the deployer. '
+                    'Check the release notes before continuing.' % old,
+                    result['warnings'][0])
+
+    def test_upgrade_same_release(self):
+        # An upgrade within a release is checked as any other action.
+        self.assertClean(self._check(_record(), action='upgrade'))
+        self.assertRefused(
+            self._check(_record(version='23.0.1'), action='upgrade'),
+            'Kolla Ansible 23.0.0 is older than 23.0.1')
+
+    def test_override(self):
+        cases = [
+            (_record(version='23.0.1'), 'deploy'),
+            (_record(release='2026.2'), 'deploy'),
+            (_record(release='2025.2'), 'reconfigure'),
+            (_record(release='2024.2'), 'upgrade'),
+            ('not json', 'deploy'),
+        ]
+        for record, action in cases:
+            with self.subTest(record=record, action=action):
+                refused = self._check(record, action=action)
+                result = self._check(record, action=action, override=True)
+                self.assertEqual([], result['errors'])
+                self.assertEqual(
+                    ['Overriding this refusal because '
+                     '--override-deployer-checks was given: ' +
+                     refused['errors'][0]],
+                    result['warnings'])
+
+    def test_deploy_host_actions(self):
+        for action in ('certificates', 'octavia-certificates',
+                       'post-deploy'):
+            with self.subTest(action=action):
+                self.assertClean(self._check(
+                    _record(release='2026.2'), action=action))
+                self.assertClean(self._check('not json', action=action))
+
+    def test_malformed_record(self):
+        cases = [
+            ('not json', 'Expecting value'),
+            ('[]', 'the record is not a JSON object'),
+            ('{}', 'the record has no openstack_release or '
+                   'kolla_ansible_version'),
+            (json.dumps({'openstack_release': '2026.1'}),
+             'the record has no kolla_ansible_version'),
+        ]
+        for text, reason in cases:
+            with self.subTest(text=text):
+                self.assertRefused(
+                    self._check(text),
+                    "controller0's deployment record %s could not be read: "
+                    % PATH, reason, 'Correct or remove it.')
+
+    def test_unparsable_release(self):
+        self.assertRefused(
+            self._check(_record(release='zed')),
+            'Release zed cannot be compared: releases must be master, '
+            'YYYY.1 or YYYY.2.')
+        self.assertRefused(
+            self._check(_record(), _deployer(release='custom')),
+            'Release custom cannot be compared')
+
+    def test_deployer_without_release(self):
+        info = _deployer()
+        del info['openstack_release']
+        result = self._check(_record(release='2026.2'), info)
+        self.assertEqual([], result['errors'])
+        self.assertEqual(
+            ["This deployer's deployer.json does not record its release, so "
+             "it was not checked against controller0's deployment record."],
+            result['warnings'])
+
+    def test_minimal_record(self):
+        record = json.dumps({'openstack_release': '2026.1',
+                             'kolla_ansible_version': '23.0.1'})
+        self.assertRefused(
+            self._check(record),
+            'by Kolla Ansible 23.0.1 for release 2026.1 (commit unknown, '
+            'action unknown, unknown).')
+
+
+class TestDeploymentRecord(unittest.TestCase):
+
+    @mock.patch.object(dc, 'datetime')
+    def test_record(self, mock_datetime):
+        mock_datetime.timezone = datetime.timezone
+        mock_datetime.datetime.now.return_value = datetime.datetime(
+            2026, 10, 11, 1, 2, 3, tzinfo=datetime.timezone.utc)
+        self.assertEqual(
+            {'format_version': 1,
+             'openstack_release': '2026.1',
+             'openstack_tag': '2026.1-debian-trixie',
+             'kolla_ansible_version': '23.0.0',
+             'kolla_ansible_git_sha': 'a' * 40,
+             'deployer_tag': '2026.1-debian-trixie',
+             'kolla_action': 'deploy',
+             'timestamp': '2026-10-11T01:02:03Z'},
+            dc.deployment_record(_deployer(), '2026.1',
+                                 '2026.1-debian-trixie', 'deploy'))
+        mock_datetime.datetime.now.assert_called_once_with(
+            datetime.timezone.utc)
+
+    @mock.patch.object(dc.metadata, 'distribution')
+    @mock.patch.object(dc.metadata, 'version')
+    def test_record_from_virtualenv(self, mock_version, mock_distribution):
+        mock_version.return_value = '22.1.0.dev266'
+        mock_distribution.return_value.read_text.return_value = (
+            '{"git_version": "6f2df72"}')
+        record = dc.deployment_record({}, 'master', 'master-debian-trixie',
+                                      'upgrade')
+        self.assertEqual('22.1.0.dev266', record['kolla_ansible_version'])
+        self.assertEqual('6f2df72', record['kolla_ansible_git_sha'])
+        self.assertIsNone(record['deployer_tag'])
+        self.assertEqual('master-debian-trixie', record['openstack_tag'])
+        self.assertEqual('upgrade', record['kolla_action'])
+
+    def test_record_round_trip(self):
+        # A record written by one deployer passes the check by the same one.
+        record = dc.deployment_record(_deployer(), '2026.1',
+                                      '2026.1-debian-trixie', 'deploy')
+        self.assertEqual(
+            {'errors': [], 'warnings': []},
+            dc.deployer_record_check(json.dumps(record), _deployer(),
+                                     'reconfigure', HOST, PATH))
diff --git a/releasenotes/notes/deployer-checks-5c3bf4aaabef98ac.yaml b/releasenotes/notes/deployer-checks-5c3bf4aaabef98ac.yaml
