diff --git a/ansible/roles/neutron/templates/ml2_conf.ini.j2 b/ansible/roles/neutron/templates/ml2_conf.ini.j2
index 7a4e72bdb..fa20bb543 100644
--- a/ansible/roles/neutron/templates/ml2_conf.ini.j2
+++ b/ansible/roles/neutron/templates/ml2_conf.ini.j2
@@ -30,6 +30,19 @@ flat_networks = {{ neutron_physical_networks }}
 [ml2_type_vxlan]
 vni_ranges = 1:1000
 
+{% if neutron_plugin_agent == 'openvswitch' %}
+[OVS_DRIVER]
+# ML2/OVS advertises ovs_create_tap in vif_details for every kernel
+# datapath port, without checking whether hybrid plugging is in use.
+# We deploy the OVS hybrid iptables firewall driver, so Neutron hands
+# Nova a VIFBridge that still carries create_tap, and os-vif refuses it
+# ("create_tap is only supported for VIFOpenVSwitch, got VIFBridge").
+# Every instance build then fails. Opt out until the upstream ordering
+# is fixed; this flag is deprecated-for-removal from birth and only
+# exists for this transition.
+ovs_create_tap = False
+{% endif %}
+
 {% if neutron_plugin_agent == 'ovn' %}
 [ml2_type_geneve]
 vni_ranges = 1001:2000
