diff --git a/tests/templates/inventory.j2 b/tests/templates/inventory.j2
index 3474a158f..2fb556ed4 100644
--- a/tests/templates/inventory.j2
+++ b/tests/templates/inventory.j2
@@ -5,8 +5,15 @@
 # to conserve the resources. Hence, we set Masakari groups to use both
 # primary and secondary while the parent group (control) uses only primary.
 
+# NOTE(mikal): the kerbside scenario narrows control for a different reason.
+# vdiproxy covers every host, so a control group of every host would put every
+# kerbside_proxy host in tls-backend too, and the multinode job would never
+# exercise a SPICE proxy running where control does not. With control at the
+# primary only, the secondary is a vdiproxy host outside tls-backend, which is
+# the shape an operator gets from giving the proxy dedicated hosts.
+
 [control]
-{% if scenario in ['masakari', 'multi-compute-ironic'] %}
+{% if scenario in ['kerbside', 'masakari', 'multi-compute-ironic'] %}
 {%     for host in hostvars if host in ['primary'] %}
 {{ host }} ansible_host={{ hostvars[host]['ansible_host'] }}
 {%     endfor %}
