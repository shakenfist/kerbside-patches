--- a/ansible/roles/barbican/templates/barbican.conf.j2
+++ b/ansible/roles/barbican/templates/barbican.conf.j2
@@ -1,5 +1,6 @@
 [DEFAULT]
 debug = {{ barbican_logging_debug }}
+use_json = {{ openstack_logging_json }}
