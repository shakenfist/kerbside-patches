diff --git a/ansible/roles/certificates/tasks/generate-kerbside.yml b/ansible/roles/certificates/tasks/generate-kerbside.yml
index dafd60540..839d51ab3 100644
--- a/ansible/roles/certificates/tasks/generate-kerbside.yml
+++ b/ansible/roles/certificates/tasks/generate-kerbside.yml
@@ -51,6 +51,16 @@
     mode: "0660"
     state: file
 
+# We maintain a separate copy of the CA certificate used for
+# kerbside because it is copied into the .vv files which
+# kerbside_api serves to users. This makes it easier to use
+# a different CA for kerbside proxies if desired.
+- name: Copy kerbside CA to kerbside-ca.pem
+  copy:
+    src: "{{ root_dir }}/root.crt"
+    dest: "{{ kolla_certificates_dir }}/kerbside-ca.pem"
+    mode: "0660"
+
 - name: Copy kerbside cert to kerbside-cert.pem
   copy:
     src: "{{ backend_dir }}/kerbside.crt"
diff --git a/ansible/roles/kerbside/tasks/copy-certs.yml b/ansible/roles/kerbside/tasks/copy-certs.yml
index 6b731cde8..cf3ce8ca3 100644
--- a/ansible/roles/kerbside/tasks/copy-certs.yml
+++ b/ansible/roles/kerbside/tasks/copy-certs.yml
@@ -3,4 +3,21 @@
   import_role:
     role: service-cert-copy
   vars:
-    project_services: "{{ kerbside_services }}"
\ No newline at end of file
+    project_services: "{{ kerbside_services }}"
+
+- name: "Copy CA certificate"
+  vars:
+    certs:
+      - "{{ kolla_certificates_dir }}/{{ inventory_hostname }}/{{ project_name }}-ca.pem"
+      - "{{ kolla_certificates_dir }}/{{ inventory_hostname }}-ca.pem"
+      - "{{ kolla_certificates_dir }}/{{ project_name }}-ca.pem"
+      - "{{ kolla_certificates_dir }}/ca-certificates/root.crt"
+    kerbside_ca_cert: "{{ lookup('first_found', certs) }}"
+  copy:
+    src: "{{ kerbside_ca_cert }}"
+    dest: "{{ node_config_directory }}/{{ project_name }}-ca.pem"
+    mode: "0644"
+  become: true
+  when: >
+    (inventory_hostname is in groups["kerbside-api"] or
+     inventory_hostname is in groups["kerbside-proxy"])
