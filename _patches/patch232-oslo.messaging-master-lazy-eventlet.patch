--- a/oslo_messaging/_utils.py
+++ b/oslo_messaging/_utils.py
@@ -14,19 +14,28 @@
 
 import logging
 import queue
+import sys
 import threading
 
-from oslo_utils import eventletutils
-from oslo_utils import importutils
-
 LOG = logging.getLogger(__name__)
 
-eventlet = importutils.try_import('eventlet')
-if eventlet and eventletutils.is_monkey_patched("thread"):
+
+def _get_patcher():
+    # Nothing can be monkey patched unless eventlet has already been
+    # imported, so look for it rather than importing it.
+    return sys.modules.get('eventlet.patcher')
+
+
+def _thread_is_monkey_patched():
+    patcher = _get_patcher()
+    return patcher is not None and patcher.is_monkey_patched('thread')
+
+
+if _thread_is_monkey_patched():
     # Here we initialize module with the native python threading module
     # if it was already monkey patched by eventlet/greenlet.
-    stdlib_threading = eventlet.patcher.original('threading')
-    stdlib_queue = eventlet.patcher.original('queue')
+    stdlib_threading = _get_patcher().original('threading')
+    stdlib_queue = _get_patcher().original('queue')
 else:
     # Manage the case where we run this driver in a non patched environment
     # and where user even so configure the driver to run heartbeat through
@@ -85,7 +94,7 @@ class DummyLock:
 
 
 def get_executor_with_context():
-    if eventletutils.is_monkey_patched('thread'):
+    if _thread_is_monkey_patched():
         LOG.debug("Threading is patched, using an eventlet executor")
         return 'eventlet'
     LOG.debug("Using a threading executor")
