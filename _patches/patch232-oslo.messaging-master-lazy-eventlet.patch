+
+# These run in a fresh interpreter, because what matters is the state of
+# sys.modules when oslo_messaging._utils is first imported. The module is
+# loaded by path so that the oslo_messaging package, and the libraries it
+# imports, are not loaded first.
+_RECORD_EVENTLET = textwrap.dedent("""
+    import sys
+
+    class Recorder:
+        def find_spec(self, name, path=None, target=None):
+            if name.split('.')[0] == 'eventlet':
+                print('import attempted:', name)
+            return None
+
+    sys.meta_path.insert(0, Recorder())
+""")
+
+_PATCH_EVENTLET = textwrap.dedent("""
+    import eventlet
+    eventlet.monkey_patch()
+""")
+
+_IMPORT_EVENTLET = 'import eventlet\n'
+
+_LOAD_UTILS = textwrap.dedent("""
+    import importlib.util
+    import queue
+    import sys
+    import threading
+
+    spec = importlib.util.spec_from_file_location(
+        'utils_under_test', sys.argv[1])
+    utils = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(utils)
+""")
+
+
+def _eventlet_installed():
+    try:
+        return importlib.util.find_spec('eventlet') is not None
+    except ImportError:
+        return False
+
+
+class EventletImportTestCase(test_utils.BaseTestCase):
+    def _run(self, *scripts):
+        out = subprocess.run(
+            [
+                sys.executable,
+                '-I',
+                '-c',
+                ''.join(scripts),
+                os.path.abspath(utils.__file__),
+            ],
+            capture_output=True,
+            text=True,
+        )
+        self.assertEqual(0, out.returncode, out.stderr)
+        return out.stdout.strip()
+
+    def test_eventlet_not_imported(self):
+        out = self._run(
+            _RECORD_EVENTLET,
+            _LOAD_UTILS,
+            textwrap.dedent("""
+            assert utils.stdlib_threading is threading
+            assert utils.stdlib_queue is queue
+            print(utils.get_executor_with_context())
+        """),
+        )
+        self.assertEqual('threading', out)
+
+    def test_eventlet_imported_but_not_patched(self):
+        if not _eventlet_installed():
+            self.skipTest('eventlet is not installed')
+        out = self._run(
+            _IMPORT_EVENTLET,
+            _LOAD_UTILS,
+            textwrap.dedent("""
+            assert utils.stdlib_threading is threading
+            assert utils.stdlib_queue is queue
+            print(utils.get_executor_with_context())
+        """),
+        )
+        self.assertEqual('threading', out)
+
+    def test_eventlet_patched_first(self):
+        # This is the order in which the services which use eventlet do
+        # things: patch, and then import oslo.messaging.
+        if not _eventlet_installed():
+            self.skipTest('eventlet is not installed')
+        out = self._run(
+            _PATCH_EVENTLET,
+            _LOAD_UTILS,
+            textwrap.dedent("""
+            original = eventlet.patcher.original
+            assert utils.stdlib_threading is original('threading')
+            assert utils.stdlib_queue is original('queue')
+            assert utils.stdlib_threading is not threading
+            assert utils.stdlib_queue is not queue
+            print(utils.get_executor_with_context())
+        """),
+        )
+        self.assertEqual('eventlet', out)
