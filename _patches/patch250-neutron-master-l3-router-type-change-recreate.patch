commit 6408ec7b474cd1dcf2cc081043c450632e10b27a
Author: Michael Still <mikal@stillhq.com>
Date:   Wed Oct 28 16:56:42 2026 +1100

    l3: Re-create a router whose type changed instead of swapping it
    
    The fix for bug 1892846 (489e0ead72) swapped a router whose type
    changed for an object that was never initialized, and left the old
    router's keepalived, radvd and state change processes running. An IPv6
    router then failed in enable_radvd and ran on without radvd.
    
    Delete the stale router and add it again, as the DVR HA branch below
    already does, so the new object is initialized before it is processed.
    
    Assisted-By: Claude Opus 5.5 (high effort)
    Change-Id: I1ef3962f0e95d446f422d8a967666ea0e87239be
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/neutron/agent/l3/agent.py b/neutron/agent/l3/agent.py
index 020acd22d2..b8041c7af2 100644
--- a/neutron/agent/l3/agent.py
+++ b/neutron/agent/l3/agent.py
@@ -653,8 +653,12 @@ class L3NATAgent(ha.AgentMixin,
                          'old_dvr': ri.router.get('distributed'),
                          'new_ha': router.get('ha'),
                          'new_dvr': router.get('distributed')})
-            ri = self._create_router(router['id'], router)
-            self.router_info[router['id']] = ri
+            # The cached router is of the wrong class. Delete it, which
+            # also stops its processes, and add the router again so that
+            # the new object is initialized before it is processed.
+            if self._safe_router_removed(router['id']):
+                self._process_added_router(router)
+            return
 
         is_dvr_snat_agent = (self.conf.agent_mode ==
                              lib_const.L3_AGENT_MODE_DVR_SNAT)
