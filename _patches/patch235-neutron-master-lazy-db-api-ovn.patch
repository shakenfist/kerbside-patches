+class TestOvnContextDecorator(base.BaseTestCase):
+
+    @staticmethod
+    @utils.ovn_context()
+    def _method(value, txn=None, idl=None):
+        return value, txn
+
+    def test_transaction_passed(self):
+        txn = mock.Mock()
+        self.assertEqual(('a', txn), self._method('a', txn))
+        self.assertEqual(('a', txn), self._method('a', txn=txn))
+
+    def test_no_transaction_or_idl(self):
+        self.assertRaises(RuntimeError, self._method, 'a')
+
+
+class TestIsPortExternal(base.BaseTestCase):
+
+    def _binding(self, vnic_type, profile):
+        return {'status': n_const.ACTIVE, 'host': 'host1',
+                'vnic_type': vnic_type, 'profile': profile}
+
+    def test_dict(self):
+        port = {portbindings.VNIC_TYPE: portbindings.VNIC_DIRECT}
+        self.assertTrue(utils.is_port_external(port))
+
+    def test_db_port(self):
+        port = mock.Mock(spec=models_v2.Port)
+        port.port_bindings = [self._binding(portbindings.VNIC_DIRECT, '{}')]
+        self.assertTrue(utils.is_port_external(port))
+
+    def test_db_port_switchdev(self):
+        port = mock.Mock(spec=models_v2.Port)
+        # The DB model keeps the profile as JSON.
+        port.port_bindings = [self._binding(
+            portbindings.VNIC_DIRECT,
+            '{"capabilities": ["%s"]}' % constants.PORT_CAP_SWITCHDEV)]
+        self.assertFalse(utils.is_port_external(port))
+
+    def test_ovo_port(self):
+        port = mock.Mock(spec=ports_obj.Port)
+        port.bindings = [self._binding(portbindings.VNIC_DIRECT, {})]
+        self.assertTrue(utils.is_port_external(port))
+
+
+class ServerOnlyImportsTestCase(base.BaseTestCase):
+    # The OVN agent imports this module, and the OVN mechanism driver's
+    # ovsdb_monitor for its IDL classes.
+    MODULES = ('neutron.agent.ovn.agent.ovn_neutron_agent',
+               'neutron.agent.ovn.extensions.metadata',
+               'neutron.agent.ovn.ovn_neutron_agent')
+
+    def test_ovn_agent_does_not_import_server_only_modules(self):
+        result = tools.check_imports(self.MODULES, tools.SERVER_ONLY_MODULES)
+        self.assertEqual([], result['holders'])
+
+    def test_ovn_agent_does_not_load_server_only_modules(self):
+        result = tools.check_imports(self.MODULES, tools.SERVER_ONLY_MODULES)
+        if result['preloaded']:
+            self.skipTest('neutron_lib loads %s itself' %
+                          ', '.join(result['preloaded']))
+        self.assertEqual([], result['loaded'])
+
+
