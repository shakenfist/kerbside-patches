--- a/ansible/module_utils/kolla_docker_worker.py
+++ b/ansible/module_utils/kolla_docker_worker.py
@@ -68,13 +68,43 @@ class DockerWorker(ContainerWorker):
                 msg='Permission denied for file at "{}"'.format(path)
             )
 
+    def parse_image(self):
+        """Return the image's repository, and its tag or digest.
+
+        The generic parse_image splits at the last colon, which falls
+        inside the digest of a reference like repository@sha256:<hex>.
+        The Docker API takes a digest wherever it takes a tag, so such a
+        reference is split at the "@" instead. A tag given alongside the
+        digest is dropped, because Docker ignores it.
+        """
+        full_image = self.params.get('image')
+        if '@' not in full_image:
+            return super().parse_image()
+
+        repository, digest = full_image.split('@', 1)
+        name, _, tag = repository.rpartition(':')
+        if name and '/' not in tag:
+            repository = name
+        return repository, digest
+
+    def image_reference(self):
+        """Return the image as Docker lists it, by tag or by digest."""
+        separator = '@' if '@' in self.params.get('image') else ':'
+        return separator.join(self.parse_image())
+
     def check_image(self):
-        find_image = ':'.join(self.parse_image())
+        # NOTE: An image pulled by digest need not have a tag, so a digest
+        # reference is found among the image's digests rather than its tags.
+        find_image = self.image_reference()
+        if '@' in find_image:
+            field = 'RepoDigests'
+        else:
+            field = 'RepoTags'
         for image in self.dc.images():
-            repo_tags = image.get('RepoTags')
-            if not repo_tags:
+            image_names = image.get(field)
+            if not image_names:
                 continue
-            for image_name in repo_tags:
+            for image_name in image_names:
                 if image_name == find_image:
                     return image
         return dict()
