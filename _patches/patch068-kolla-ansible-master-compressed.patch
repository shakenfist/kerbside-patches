diff --git a/ansible/roles/kerbside/defaults/main.yml b/ansible/roles/kerbside/defaults/main.yml
new file mode 100644
index 0000000..9dd5452
--- /dev/null
+++ b/ansible/roles/kerbside/defaults/main.yml
@@ -0,0 +1,94 @@
+---
+kerbside_services:
+  kerbside_proxy:
+    container_name: "kerbside_proxy"
+    group: "kerbside-proxy"
+    image: "{{ kerbside_image_full }}"
+    enabled: "{{ enable_kerbside }}"
+    volumes: "{{ kerbside_default_volumes + kerbside_extra_volumes }}"
+    dimensions: "{{ kerbside_dimensions }}"
+    healthcheck: "{{ kerbside_healthcheck }}"
+    haproxy:
+      kerbside_api:
+        enabled: true
+        mode: "http"
+        external: false
+        port: "{{ kerbside_port }}"
+        listen_port: "{{ kerbside_port }}"
+        backend_http_extra:
+          - "option httpchk"
+        tls_backend: true
+      kerbside_api_external:
+        enabled: true
+        mode: "http"
+        external: true
+        external_fqdn: "{{ kolla_external_fqdn }}"
+        port: "{{ kerbside_port }}"
+        listen_port: "{{ kerbside_port }}"
+        backend_http_extra:
+          - "option httpchk"
+        tls_backend: true
+
+####################
+# Kerbside
+####################
+kerbside_image: "{{ docker_registry ~ '/' if docker_registry else '' }}{{ docker_namespace }}/kerbside"
+kerbside_tag: "{{ openstack_tag }}"
+kerbside_image_full: "{{ kerbside_image }}:{{ kerbside_tag }}"
+kerbside_dimensions: "{{ default_container_dimensions }}"
+kerbside_enable_healthchecks: "{{ enable_container_healthchecks }}"
+kerbside_healthcheck_interval: "{{ default_container_healthcheck_interval }}"
+kerbside_healthcheck_retries: "{{ default_container_healthcheck_retries }}"
+kerbside_healthcheck_start_period: "{{ default_container_healthcheck_start_period }}"
+kerbside_healthcheck_test: ["CMD-SHELL", "healthcheck_listen gunicorn {{ kerbside_port }}"]
+kerbside_healthcheck_timeout: "{{ default_container_healthcheck_timeout }}"
+kerbside_healthcheck:
+  interval: "{{ kerbside_healthcheck_interval }}"
+  retries: "{{ kerbside_healthcheck_retries }}"
+  start_period: "{{ kerbside_healthcheck_start_period }}"
+  test: "{% if kerbside_enable_healthchecks | bool %}{{ kerbside_healthcheck_test }}{% else %}NONE{% endif %}"
+  timeout: "{{ kerbside_healthcheck_timeout }}"
+kerbside_extra_volumes: "{{ default_extra_volumes }}"
+kerbside_default_volumes:
+  - "{{ node_config_directory }}/kerbside_proxy/:{{ container_config_directory }}/:ro"
+  - "/etc/localtime:/etc/localtime:ro"
+  - "{{ '/etc/timezone:/etc/timezone:ro' if ansible_facts.os_family == 'Debian' else '' }}"
+  - "kolla_logs:/var/log/kolla/"
+  - "{{ kolla_dev_repos_directory ~ '/kerbside:/dev-mode/kerbside' if kerbside_dev_mode | bool else '' }}"
+kerbside_json_logging: "no"
+
+####################
+# Kerbside Database
+####################
+kerbside_database_name: "kerbside"
+kerbside_database_user: "{% if use_preconfigured_databases | bool and use_common_mariadb_user | bool %}{{ database_user }}{% else %}kerbside{% endif %}"
+kerbside_database_address: "{{ database_address | put_address_in_context('url') }}:{{ database_port }}"
+
+####################
+# Database sharding
+####################
+kerbside_database_shard_root_user: "{% if enable_proxysql | bool %}root_shard_{{ kerbside_database_shard_id }}{% else %}{{ database_user }}{% endif %}"
+kerbside_database_shard_id: "{{ mariadb_default_database_shard_id | int }}"
+kerbside_database_shard:
+  users:
+    - user: "{{ kerbside_database_user }}"
+      password: "{{ kerbside_database_password }}"
+      shard_id: "{{ kerbside_database_shard_id }}"
+  rules:
+    - schema: "{{ kerbside_database_name }}"
+      shard_id: "{{ kerbside_database_shard_id }}"
+    - user: "{{ kerbside_database_user }}"
+      shard_id: "{{ kerbside_database_shard_id }}"
+
+####################
+# Kolla
+####################
+kerbside_git_repository: "{{ kolla_dev_repos_git }}/{{ project_name }}"
+kerbside_dev_repos_pull: "{{ kolla_dev_repos_pull }}"
+kerbside_dev_mode: "{{ kolla_dev_mode }}"
+kerbside_source_version: "{{ kolla_source_version }}"
+
+###################
+# Copy certificates
+###################
+kerbside_copy_certs: "{{ 'yes' | bool }}"
diff --git a/ansible/roles/kerbside/handlers/main.yml b/ansible/roles/kerbside/handlers/main.yml
new file mode 100644
index 0000000..a2d5d67
--- /dev/null
+++ b/ansible/roles/kerbside/handlers/main.yml
@@ -0,0 +1,18 @@
+---
+- name: Restart kerbside_proxy container
+  vars:
+    service_name: "kerbside_proxy"
+    service: "{{ kerbside_services[service_name] }}"
+  become: true
+  kolla_container:
+    action: "recreate_or_restart_container"
+    common_options: "{{ docker_common_options }}"
+    name: "{{ service.container_name }}"
+    image: "{{ service.image }}"
+    privileged: "{{ service.privileged | default(False) }}"
+    volumes: "{{ service.volumes | reject('equalto', '') | list }}"
+    dimensions: "{{ service.dimensions }}"
+    healthcheck: "{{ service.healthcheck | default(omit) }}"
+  when:
+    - kolla_action != "config"
+    - kolla_action != "upgrade" or not kerbside_safety_upgrade | bool
diff --git a/ansible/roles/kerbside/tasks/bootstrap.yml b/ansible/roles/kerbside/tasks/bootstrap.yml
new file mode 100644
index 0000000..e952e48
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/bootstrap.yml
@@ -0,0 +1,54 @@
+---
+- name: Creating Kerbside databases
+  become: true
+  kolla_toolbox:
+    container_engine: "{{ kolla_container_engine }}"
+    module_name: mysql_db
+    module_args:
+      login_host: "{{ database_address }}"
+      login_port: "{{ database_port }}"
+      login_user: "{{ kerbside_database_shard_root_user }}"
+      login_password: "{{ database_password }}"
+      name: "{{ kerbside_database_name }}"
+  run_once: True
+  delegate_to: "{{ groups['kerbside-proxy'][0] }}"
+  when:
+    - not use_preconfigured_databases | bool
+
+- name: Creating Kerbside databases user and setting permissions
+  become: true
+  kolla_toolbox:
+    container_engine: "{{ kolla_container_engine }}"
+    module_name: mysql_user
+    module_args:
+      login_host: "{{ database_address }}"
+      login_port: "{{ database_port }}"
+      login_user: "{{ kerbside_database_shard_root_user }}"
+      login_password: "{{ database_password }}"
+      name: "{{ kerbside_database_user }}"
+      password: "{{ kerbside_database_password }}"
+      host: "%"
+      priv: "{{ kerbside_database_name }}.*:ALL"
+      append_privs: "yes"
+  run_once: True
+  delegate_to: "{{ groups['kerbside-proxy'][0] }}"
+  when:
+    - not use_preconfigured_databases | bool
+
+- name: Create kerbside administrative access group
+  become: true
+  kolla_toolbox:
+    container_engine: "{{ kolla_container_engine }}"
+    module_name: "openstack.cloud.identity_group"
+    module_args:
+      state: present
+      name: kerbside
+      description: "Kerbside administrative access group"
+      auth: "{{ openstack_auth }}"
+      endpoint_type: "{{ openstack_interface }}"
+  run_once: True
+  when:
+    - enable_kerbside | bool
+
+- import_tasks: config.yml
+- import_tasks: bootstrap_service.yml
\ No newline at end of file
diff --git a/ansible/roles/kerbside/tasks/bootstrap_service.yml b/ansible/roles/kerbside/tasks/bootstrap_service.yml
new file mode 100644
index 0000000..f06bb7b
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/bootstrap_service.yml
@@ -0,0 +1,20 @@
+---
+- name: Running Kerbside bootstrap container
+  vars:
+    kerbside_proxy: "{{ kerbside_services['kerbside_proxy'] }}"
+  become: true
+  kolla_container:
+    action: "start_container"
+    common_options: "{{ docker_common_options }}"
+    detach: False
+    environment:
+      KOLLA_BOOTSTRAP:
+      KOLLA_CONFIG_STRATEGY: "{{ config_strategy }}"
+    image: "{{ kerbside_proxy.image }}"
+    labels:
+      BOOTSTRAP:
+    name: "bootstrap_kerbside"
+    restart_policy: oneshot
+    volumes: "{{ kerbside_proxy.volumes | reject('equalto', '') | list }}"
+  run_once: True
+  delegate_to: "{{ groups['kerbside-proxy'][0] }}"
