+class TestWSGIImportWithoutEventlet(testtools.TestCase):
+    """Tests that the module does not need eventlet until Server is used."""
+
+    def test_import_without_eventlet(self):
+        # Run in a fresh interpreter in which eventlet and greenlet cannot
+        # be imported: the test process has already imported both.
+        code = (
+            "import sys\n"
+            "sys.modules['eventlet'] = None\n"
+            "sys.modules['greenlet'] = None\n"
+            "from oslo_config import cfg\n"
+            "from oslo_service import backend\n"
+            "from oslo_service.backend import exceptions\n"
+            "backend.init_backend(backend.BackendType.THREADING)\n"
+            "from oslo_service import wsgi\n"
+            "conf = cfg.ConfigOpts()\n"
+            "wsgi.register_opts(conf)\n"
+            "try:\n"
+            "    wsgi.Server(conf, 'test', None)\n"
+            "except exceptions.UnsupportedBackendError:\n"
+            "    print('ok')\n"
+        )
+        out = subprocess.check_output([sys.executable, "-c", code], text=True)
+        self.assertEqual('ok', out.strip())
