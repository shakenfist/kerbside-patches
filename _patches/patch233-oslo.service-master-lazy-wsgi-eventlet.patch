diff --git a/releasenotes/notes/wsgi-lazy-eventlet-e0ea4204870377c0.yaml b/releasenotes/notes/wsgi-lazy-eventlet-e0ea4204870377c0.yaml
new file mode 100644
index 0000000..d677ca3
--- /dev/null
+++ b/releasenotes/notes/wsgi-lazy-eventlet-e0ea4204870377c0.yaml
@@ -0,0 +1,7 @@
+---
+upgrade:
+  - |
+    The ``protocol`` argument of ``oslo_service.wsgi.Server`` now defaults to
+    ``None``, which selects ``eventlet.wsgi.HttpProtocol`` when the server is
+    created, so that importing ``oslo_service.wsgi`` no longer imports
+    eventlet. Passing a protocol class works as before.
