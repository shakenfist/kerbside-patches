commit 60711990955e2c42db192e955e59073d546d51f7
Author: Michael Still <mikal@stillhq.com>
Date:   Tue Nov 24 19:12:08 2026 +1100

    Import eventlet only for the WSGI server
    
    Only the deprecated Server uses eventlet and greenlet, yet neutron
    imports oslo_service.wsgi everywhere for Loader, Request and
    register_opts. Import them in Server's methods; protocol now defaults
    to None, which still means eventlet.wsgi.HttpProtocol.
    
    The saving also needs eventlet gone from futurist, oslo.utils'
    eventletutils, oslo.messaging's _utils and oslo.privsep (1011795). With
    all of them, neutron's L3 and metadata agents drop eventlet, from 117MB
    to 106MB and 103MB anonymous; its servers keep it through python-ovs.
    
    Prompt: Mikal asked for the rest of the eventlet import chain to be
    fixed, so that neutron's threaded agents stop loading eventlet; this is
    the oslo.service part of it.
    
    Assisted-By: Claude Opus 5.5 (high effort)
    
    Change-Id: Id8f23667d2b188af9a51de07ca48eaa5409f0f6f
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/oslo_service/tests/test_wsgi.py b/oslo_service/tests/test_wsgi.py
index d72681e..a5f0e07 100644
--- a/oslo_service/tests/test_wsgi.py
+++ b/oslo_service/tests/test_wsgi.py
@@ -272,6 +272,35 @@ class TestWSGIServer(WsgiTestCase):
             )
             server.stop()
 
+    def test_default_protocol(self):
+        # mocking eventlet spawn method to check the protocol it is given.
+        with mock.patch.object(eventlet, 'spawn') as mock_spawn:
+            server = wsgi.Server(
+                self.conf, "test_app", None, host="127.0.0.1", port=0
+            )
+            server.start()
+            _, kwargs = mock_spawn.call_args
+            self.assertIs(eventlet.wsgi.HttpProtocol, kwargs['protocol'])
+            server.stop()
+
+    def test_custom_protocol(self):
+        class TestProtocol(eventlet.wsgi.HttpProtocol):
+            pass
+
+        with mock.patch.object(eventlet, 'spawn') as mock_spawn:
+            server = wsgi.Server(
+                self.conf,
+                "test_app",
+                None,
+                host="127.0.0.1",
+                port=0,
+                protocol=TestProtocol,
+            )
+            server.start()
+            _, kwargs = mock_spawn.call_args
+            self.assertIs(TestProtocol, kwargs['protocol'])
+            server.stop()
+
     def test_wsgi_keep_alive(self):
         self.config(wsgi_keep_alive=False)
 
