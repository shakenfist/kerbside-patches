diff --git a/ansible/roles/kerbside/templates/kerbside-wsgi.conf.j2 b/ansible/roles/kerbside/templates/kerbside-wsgi.conf.j2
new file mode 100644
index 0000000..d63e2f2
--- /dev/null
+++ b/ansible/roles/kerbside/templates/kerbside-wsgi.conf.j2
@@ -0,0 +1,37 @@
+{% if kerbside_enable_tls_backend | bool %}
+{% if kolla_base_distro in ['centos', 'rocky']  %}
+LoadModule ssl_module /usr/lib64/httpd/modules/mod_ssl.so
+{% else %}
+LoadModule ssl_module /usr/lib/apache2/modules/mod_ssl.so
+{% endif %}
+{% endif %}
+Listen {{ api_interface_address | put_address_in_context('url') }}:{{ kerbside_api_listen_port }}
+
+ServerSignature Off
+ServerTokens Prod
+TraceEnable off
+TimeOut {{ kolla_httpd_timeout }}
+KeepAliveTimeout {{ kolla_httpd_keep_alive }}
+
+{% if kerbside_logging_debug | bool %}
+LogLevel info
+{% endif %}
+
+<VirtualHost *:{{ kerbside_api_listen_port }}>
+    WSGIDaemonProcess kerbside-api processes={{ kerbside_api_workers }} threads=1 user=kerbside group=kerbside display-name=kerbside-api
+    WSGIProcessGroup kerbside-api
+    WSGIScriptAlias / /var/www/cgi-bin/kerbside/kerbside-wsgi
+    WSGIApplicationGroup %{GLOBAL}
+    WSGIPassAuthorization On
+    <IfVersion >= 2.4>
+      ErrorLogFormat "%{cu}t %M"
+    </IfVersion>
+    ErrorLog /var/log/kolla/kerbside/kerbside-api-error.log
+    LogFormat "%{X-Forwarded-For}i %l %u %t \"%r\" %>s %b %D \"%{Referer}i\" \"%{User-Agent}i\"" logformat
+    CustomLog /var/log/kolla/kerbside/kerbside-api-access.log logformat
+{% if kerbside_enable_tls_backend | bool %}
+    SSLEngine On
+    SSLCertificateFile /etc/kerbside/certs/kerbside-cert.pem
+    SSLCertificateKeyFile /etc/kerbside/certs/kerbside-key.pem
+{% endif %}
+</VirtualHost>
diff --git a/ansible/roles/kerbside/templates/kerbside_api.json.j2 b/ansible/roles/kerbside/templates/kerbside_api.json.j2
new file mode 100644
index 0000000..df1e077
--- /dev/null
+++ b/ansible/roles/kerbside/templates/kerbside_api.json.j2
@@ -0,0 +1,54 @@
+{
+    "command": "uwsgi /etc/kerbside/kerbside-uwsgi.ini",
+    "config_files": [
+        {
+            "source": "{{ container_config_directory }}/kerbside_config",
+            "dest": "/etc/kerbside/kerbside_config",
+            "owner": "kerbside",
+            "perm": "0600"
+        },
+        {
+            "source": "{{ container_config_directory }}/sources.yaml",
+            "dest": "/etc/kerbside/sources.yaml",
+            "owner": "kerbside",
+            "perm": "0600"
+        }{% if kerbside_wsgi_provider == "apache"%},
+        {
+            "source": "{{ container_config_directory }}/kerbside-wsgi.conf",
+            "dest": "/etc/kerbside/kerbside-wsgi.conf",
+            "owner": "root",
+            "perm": "0600"
+        }{% endif %}{% if kerbside_wsgi_provider == "uwsgi"%},
+        {
+            "source": "{{ container_config_directory }}/kerbside-uwsgi.ini",
+            "dest": "/etc/kerbside/kerbside-uwsgi.ini",
+            "owner": "root",
+            "perm": "0600"
+        }{% endif %},
+        {
+            "source": "{{ container_config_directory }}/kerbside-cert.pem",
+            "dest": "/etc/pki/kerbside/servercert.pem",
+            "owner": "kerbside",
+            "perm": "0600"
+        },
+        {
+            "source": "{{ container_config_directory }}/kerbside-key.pem",
+            "dest": "/etc/pki/kerbside/serverkey.pem",
+            "owner": "kerbside",
+            "perm": "0600"
+        }{% if kerbside_copy_certs | bool %},
+        {
+            "source": "{{ container_config_directory }}/ca-certificates",
+            "dest": "/var/lib/kolla/share/ca-certificates",
+            "owner": "root",
+            "perm": "0600"
+        }{% endif %}
+    ],
+    "permissions": [
+        {
+            "path": "/var/log/kolla/kerbside",
+            "owner": "kerbside:kerbside",
+            "recurse": true
+        }
+    ]
+}
