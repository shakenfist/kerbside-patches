diff --git a/ansible/roles/fluentd/templates/conf/filter/00-record_transformer.conf.j2 b/ansible/roles/fluentd/templates/conf/filter/00-record_transformer.conf.j2
index 508f7df..e0fb46c 100644
--- a/ansible/roles/fluentd/templates/conf/filter/00-record_transformer.conf.j2
+++ b/ansible/roles/fluentd/templates/conf/filter/00-record_transformer.conf.j2
@@ -7,6 +7,31 @@
     </record>
 </filter>
 
+{% if openstack_logging_json | bool %}
+# oslo.log's JSON formatter names its fields differently to the text format
+# that the parser in conf/input/00-global.conf.j2 reads, so rename them and
+# lift the request context out to where the text format put it. Everything
+# else oslo.log emits -- asctime, levelno, pathname, funcname, lineno,
+# thread_name and the rest -- is left in place, since keeping it is the
+# point of logging JSON. The context is safe to keep whole: oslo.context
+# redacts auth_token before the formatter ever sees it.
+<filter *.var.log.kolla.*.*.log>
+    @type record_transformer
+    enable_ruby true
+    <record>
+        Payload ${record["message"]}
+        log_level ${record["levelname"]}
+        python_module ${record["name"]}
+        Pid ${record["process"]}
+        global_request_id ${record.dig("context", "global_request_id")}
+        request_id ${record.dig("context", "request_id")}
+        user_id ${record.dig("context", "user")}
+        tenant_id ${record.dig("context", "project_id")}
+    </record>
+    remove_keys message,msg,args,levelname,name,process
+</filter>
+{% endif %}
+
 <filter infra.*>
     @type record_transformer
     <record>
diff --git a/ansible/roles/fluentd/templates/conf/input/00-global.conf.j2 b/ansible/roles/fluentd/templates/conf/input/00-global.conf.j2
index e94f83b..05ef4f6 100644
--- a/ansible/roles/fluentd/templates/conf/input/00-global.conf.j2
+++ b/ansible/roles/fluentd/templates/conf/input/00-global.conf.j2
@@ -15,12 +15,19 @@
   ignore_repeated_permission_error true
   enable_watch_timer {{ fluentd_enable_watch_timer }}
   <parse>
+{%     if openstack_logging_json | bool %}
+    @type json
+    time_key created
+    time_type float
+    keep_time_key true
+{%     else %}
     @type multiline
     format_firstline /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}.\d{3} \d+ \S+ \S+ \[.*\]/
     format1 /^(?<Timestamp>\S+ \S+) (?<Pid>\d+) (?<log_level>\S+) (?<python_module>\S+) ((?:\[)(?:None|req-)(?<global_request_id>\S+)? (?:None|req-)(?<request_id>\S+) (?<user_id>\S+) (?<tenant_id>\S+) (?<domain_id>\S+) (?<system_scope>\S+) (?<user_domain>\S+) (?<project_domain>\S+)(?:\]))?(?<Payload>.*)?$/
     time_key Timestamp
     keep_time_key true
     time_format %F %T.%L
+{%     endif %}
   </parse>
 </source>
 {% endif %}
