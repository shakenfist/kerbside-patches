commit 7bd91437e9540c9f0ea14f50fbc8c3654b746fb4
Author: Michael Still <mikal@stillhq.com>
Date:   Wed Oct 28 08:53:50 2026 +1100

    dhcp: Keep every segment's subnets on the cached network
    
    Since 06bc855dcf (2024) call_driver has set network.subnets to each
    segment's subnets in turn on the caller's network, often the cached
    one, and never restored them, so it kept only the last segment's.
    
    Each segment's driver call now gets a shallow copy holding only its
    subnets. The copy shares the ports list, which DeviceManager.setup
    extends and the next segment's stale device cleanup reads.
    
    Assisted-By: Claude Opus 5.5 (high effort)
    Change-Id: I7b71a6f39860be53b4e3068b938b3f8e666f1b1d
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/neutron/agent/dhcp/agent.py b/neutron/agent/dhcp/agent.py
index bfc97a09d9..365bc51fe2 100644
--- a/neutron/agent/dhcp/agent.py
+++ b/neutron/agent/dhcp/agent.py
@@ -15,6 +15,7 @@
 
 import collections
 from concurrent import futures
+import copy
 import functools
 import os
 import signal
@@ -267,9 +268,17 @@ class DhcpAgent(manager.Manager):
         if sid_subnets:
             ret = []
             for seg_id, subnets in sid_subnets.items():
-                network.subnets = subnets
+                # Give the driver a copy holding only this segment's
+                # subnets, so the caller's (often cached) network keeps
+                # them all. The ports list stays shared: DeviceManager.setup
+                # adds each segment's DHCP port to it, and the next
+                # segment's stale device cleanup must see that port (bug
+                # #2051729).
+                net_seg = copy.copy(network)
+                net_seg.subnets = subnets
+                net_seg.ports = network.ports
                 ret.append(self._call_driver(
-                    action, network, segment=sid_segment.get(seg_id),
+                    action, net_seg, segment=sid_segment.get(seg_id),
                     **action_kwargs))
             return all(ret)
         # In case subnets are not attached to segments. default behavior.
