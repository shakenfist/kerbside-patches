             segments=[seg1, seg0])
+        return network, (seg0, seg1), (sub0, sub1)
+
+    def test_call_driver_enable_with_segments(self):
+        network, (seg0, seg1), (sub0, sub1) = (
+            self._make_two_segment_network())
 
         agent = dhcp_agent.DhcpAgent(cfg.CONF)
         agent.init_host()
         with mock.patch.object(agent,
                                '_call_driver') as _call_driver:
             self.assertTrue(agent.call_driver('enable', network))
-            # The public function call_driver() is calling the private
-            # _call_driver().
-            _call_driver.assert_has_calls([
-                mock.call("enable", network, segment=seg0),
-                mock.call("enable", network, segment=seg1)])
+
+        # The public function call_driver() is calling the private
+        # _call_driver() once per segment, each time with a network that
+        # holds only that segment's subnets.
+        self.assertEqual(2, _call_driver.call_count)
+        calls = [(c.args[0], c.args[1], c.kwargs['segment'])
+                 for c in _call_driver.call_args_list]
+        for (action, net_seg, segment), seg, sub in zip(
+                calls, (seg0, seg1), (sub0, sub1)):
+            self.assertEqual('enable', action)
+            self.assertIs(seg, segment)
+            self.assertEqual([sub], net_seg.subnets)
+            self.assertEqual(network.id, net_seg.id)
+            self.assertEqual(network.namespace, net_seg.namespace)
+        # The caller's network, often the cached one, keeps every subnet.
+        self.assertEqual([sub0, sub1], network.subnets)
+
+    def test_call_driver_with_segments_shares_ports(self):
+        network, _, _ = self._make_two_segment_network()
+        seen_ports = []
+
+        def fake_call_driver(action, net_seg, segment=None):
+            # Each segment's driver call sees the DHCP ports added by the
+            # segments before it (bug #2051729).
+            seen_ports.append([p.id for p in net_seg.ports])
+            net_seg.ports.append(
+                dhcp.DictModel(id=f'dhcp-{segment.id}'))
+            return True
+
+        agent = dhcp_agent.DhcpAgent(cfg.CONF)
+        agent.init_host()
+        with mock.patch.object(agent, '_call_driver',
+                               side_effect=fake_call_driver):
+            self.assertTrue(agent.call_driver('enable', network))
+
+        self.assertEqual([[], ['dhcp-seg0']], seen_ports)
+        self.assertEqual(['dhcp-seg0', 'dhcp-seg1'],
+                         [p.id for p in network.ports])
 
     def test_call_driver_no_network(self):
         network = None
