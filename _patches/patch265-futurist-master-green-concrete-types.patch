+# The accessors below import eventlet when they are first called rather than
+# when this module is imported, so a process which never uses a green
+# executor does not pay for it, and functools.cache means each one imports
+# once. They are functions rather than module attributes because this module
+# is internal, so nothing outside futurist depends on the attributes, and a
+# module-level __getattr__ serving them would type as Any and hide every
+# attribute of this module from the type checker -- including a misspelled
+# one. Returning the eventlet types instead lets callers keep their types.
+#
+# eventlet ships no type information, so each accessor is where its Any
+# stops: the ignore is on the return, and the declared type is what callers
+# see. That is the point of the exercise -- without it the Any reaches the
+# callers, which is why they had to annotate their own attributes as Any.
+@functools.cache
+def get_pool_class() -> type[greenpool.GreenPool]:
+    """eventlet's green pool class."""
+    _require_eventlet('a green executor')
+    from eventlet import greenpool
+
+    return greenpool.GreenPool  # type: ignore[no-any-return]
+
+
+@functools.cache
+def get_queue_class() -> type[greenqueue.Queue[_utils.WorkItem]]:
+    """eventlet's green queue class, as we use it: a queue of work items."""
+    _require_eventlet('a green executor')
+    from eventlet import queue
+
+    return queue.Queue  # type: ignore[no-any-return]
+
+
+@functools.cache
+def get_spawn() -> Callable[..., greenthread.GreenThread]:
+    """eventlet's greenthread spawn function."""
+    _require_eventlet('a green thread')
+    from eventlet import greenthread
+
+    return greenthread.spawn  # type: ignore[no-any-return]
+
+
+@functools.cache
+def _green_threading() -> ModuleType:
+    """eventlet's green threading module."""
+    _require_eventlet('green threading primitives')
+    from eventlet.green import threading as greenthreading
+
+    return greenthreading  # type: ignore[no-any-return]
 
 
