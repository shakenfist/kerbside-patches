+class ServerImportsTestCase(testtools.TestCase):
+    def test_application_does_not_import_saml2(self):
+        # pysaml2 is only needed to issue SAML assertions, so the server
+        # must not load it just by being imported.
+        script = (
+            'import sys\n'
+            'import keystone.server.flask.application\n'
+            'sys.exit(1 if "saml2" in sys.modules else 0)\n'
+        )
+        result = subprocess.run(
+            [sys.executable, '-c', script], capture_output=True, text=True
+        )
+        self.assertEqual(
+            0,
+            result.returncode,
+            'keystone.server.flask.application imported saml2: '
+            + result.stderr,
+        )
