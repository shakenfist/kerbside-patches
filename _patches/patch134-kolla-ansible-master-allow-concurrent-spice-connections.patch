commit df158e13a33fa59d39527b84a92f378629199fec
Author: Michael Still <mikal@stillhq.com>
Date:   Mon Jun 22 12:07:28 2026 +1000

    Allow concurrent sessions with SPICE.
    
    SPICE consoles as provided by Nova can now support more than one
    user being connected to the console at the same time. Subsequent
    users have slightly less functionality than the first user, but
    this can still be quite a useful piece of functionality.
    
    This patch enables that configuration option through the deployment
    by adding the new configuration option
    `nova_spice_allow_concurrent`.
    
    Change-Id: Id5fe10e650f52fe3a1970317924866b99ec9bcad
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/ansible/group_vars/all/nova.yml b/ansible/group_vars/all/nova.yml
index 9c98dc933..cc5ddc72c 100644
--- a/ansible/group_vars/all/nova.yml
+++ b/ansible/group_vars/all/nova.yml
@@ -74,4 +74,5 @@ nova_spice_jpeg_compression: "auto"
 nova_spice_zlib_compression: "auto"
 nova_spice_playback_compression: true
 nova_spice_streaming_mode: "filter"
+nova_spice_allow_concurrent: true
 nova_spice_require_secure: false
