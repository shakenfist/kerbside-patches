diff --git a/docker/kerbside/kerbside-base/Dockerfile.j2 b/docker/kerbside/kerbside-base/Dockerfile.j2
new file mode 100644
index 000000000..6ede9496c
--- /dev/null
+++ b/docker/kerbside/kerbside-base/Dockerfile.j2
@@ -0,0 +1,51 @@
+FROM {{ namespace }}/{{ image_prefix }}openstack-base:{{ tag }}
+{% block labels %}
+LABEL maintainer="{{ maintainer }}" name="{{ image_name }}" build-date="{{ build_date }}"
+{% endblock %}
+
+{% block kerbside_header %}{% endblock %}
+
+{% import "macros.j2" as macros with context %}
+{{ macros.configure_user(name='kerbside', groups='kerbside') }}
+
+{{ macros.configure_user(name='kerbside', groups='kerbside') }}
+
+{% if base_package_type == 'rpm' %}
+    {% set kerbside_packages = [
+        'mariadb-devel',
+        'pkgconfig'
+    ] %}
+{% elif base_package_type == 'deb' %}
+    {% set kerbside_packages = [
+        'libmariadb-dev-compat',
+        'pkg-config'
+    ] %}
+{% endif %}
+{{ macros.install_packages(kerbside_packages | customizable("packages")) }}
+
+# We currently carry a customized version of openstacksdk until our changes are
+# merged upstream. This is handled as a plugin for now. This is also how you
+# would add support to kerbside for other clouds like Shaken Fist or oVirt.
+ADD plugins-archive /
+
+{% set kerbside_pip_packages = [
+    '/kerbside'
+] %}
+
+{% set kerbside_plugins_pip_packages = [
+    '/plugins/*'
+] %}
+
+# Note that we disable upper-constraints for kerbside, because it comes from an
+# alternate universe which requires more modern dependencies that you get with
+# 2025.1. This should change as OpenStack releases newer versions.
+ADD kerbside-base-archive /kerbside-source
+RUN ln -s kerbside-source/* kerbside \
+    && if [ "$(ls /plugins)" ]; then \
+           {{ macros.install_pip(kerbside_plugins_pip_packages) }}; \
+       fi \
+    && {{ macros.install_pip(kerbside_pip_packages | customizable("pip_packages"), false) }} \
+    && rm -f /etc/machine-id
+
+{% block kerbside_footer %}{% endblock %}
+{% block footer %}{% endblock %}
