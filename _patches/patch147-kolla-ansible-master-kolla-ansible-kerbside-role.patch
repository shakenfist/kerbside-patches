diff --git a/ansible/roles/certificates/tasks/generate-kerbside.yml b/ansible/roles/certificates/tasks/generate-kerbside.yml
new file mode 100644
index 000000000..f33ce37c9
--- /dev/null
+++ b/ansible/roles/certificates/tasks/generate-kerbside.yml
@@ -0,0 +1,65 @@
+---
+- name: Ensuring private backend directory exist
+  ansible.builtin.file:
+    path: "{{ certificates_backend_dir }}"
+    state: "directory"
+    mode: "0770"
+
+- name: Creating kerbside Server Certificate key
+  community.crypto.openssl_privatekey:
+    path: "{{ certificates_backend_dir }}/kerbside.key"
+    mode: "0660"
+    size: 2048
+    type: RSA
+
+# SPICE clients may reach the kerbside proxies via either VIP, so the
+# certificate must be valid for both the internal and external names.
+- name: Creating kerbside Server Certificate signing request
+  vars:
+    _san:
+      - "{{ ('DNS:' ~ kolla_internal_fqdn) if kolla_internal_fqdn != kolla_internal_vip_address }}"
+      - "{{ ('DNS:' ~ kolla_external_fqdn) if kolla_external_fqdn != kolla_external_vip_address }}"
+      - "IP:{{ kolla_internal_vip_address }}"
+      - "IP:{{ kolla_external_vip_address }}"
+  community.crypto.openssl_csr:
+    path: "{{ certificates_backend_dir }}/kerbside.csr"
+    country_name: "US"
+    digest: "sha256"
+    locality_name: "RTP"
+    organizational_unit_name: "kolla"
+    privatekey_path: "{{ certificates_backend_dir }}/kerbside.key"
+    state_or_province_name: "NC"
+    subject_alt_name: "{{ _san | select() | unique }}"
+
+- name: Creating kerbside Server Certificate from CSR
+  community.crypto.x509_certificate:
+    path: "{{ certificates_backend_dir }}/kerbside.crt"
+    csr_path: "{{ certificates_backend_dir }}/kerbside.csr"
+    ownca_digest: "sha256"
+    ownca_not_after: "+500d"
+    ownca_path: "{{ certificates_root_dir }}/root.crt"
+    ownca_privatekey_path: "{{ certificates_root_dir }}/root.key"
+    privatekey_path: "{{ certificates_backend_dir }}/kerbside.key"
+    provider: ownca
+
+# We maintain a separate copy of the CA certificate used for
+# kerbside because it is copied into the .vv files which
+# kerbside_api serves to users. This makes it easier to use
+# a different CA for kerbside proxies if desired.
+- name: Copy kerbside CA to kerbside-ca.pem
+  ansible.builtin.copy:
+    src: "{{ certificates_root_dir }}/root.crt"
+    dest: "{{ kolla_certificates_dir }}/kerbside-ca.pem"
+    mode: "0660"
+
+- name: Copy kerbside cert to kerbside-cert.pem
+  ansible.builtin.copy:
+    src: "{{ certificates_backend_dir }}/kerbside.crt"
+    dest: "{{ kolla_certificates_dir }}/kerbside-cert.pem"
+    mode: "0660"
+
+- name: Copy kerbside key to kerbside-key.pem
+  ansible.builtin.copy:
+    src: "{{ certificates_backend_dir }}/kerbside.key"
+    dest: "{{ kolla_certificates_dir }}/kerbside-key.pem"
+    mode: "0660"
