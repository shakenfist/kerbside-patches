diff --git a/ansible/roles/kerbside/tasks/precheck.yml b/ansible/roles/kerbside/tasks/precheck.yml
new file mode 100644
index 000000000..fed9715e7
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/precheck.yml
@@ -0,0 +1,88 @@
+---
+- name: Run service precheck
+  ansible.builtin.import_role:
+    name: service-precheck
+  vars:
+    service_precheck_services: "{{ kerbside_services }}"
+    service_name: "{{ project_name }}"
+
+- name: Ensure Nova is configured for spice-direct consoles
+  ansible.builtin.fail:
+    msg: >-
+      Kerbside proxies Nova spice-direct consoles, which requires
+      enable_nova to be true and nova_console to be "spice".
+  when:
+    - enable_kerbside | bool
+    - not enable_nova | bool or nova_console != 'spice'
+
+- name: Get API container facts
+  become: true
+  kolla_container_facts:
+    action: get_containers
+    container_engine: "{{ kolla_container_engine }}"
+    name:
+      - kerbside_api
+  check_mode: false
+  register: api_container_facts
+
+- name: Checking free port for Kerbside API
+  vars:
+    service: "{{ kerbside_services['kerbside_api'] }}"
+  ansible.builtin.wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_api_listen_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - api_container_facts.containers['kerbside_api'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Get proxy container facts
+  become: true
+  kolla_container_facts:
+    action: get_containers
+    container_engine: "{{ kolla_container_engine }}"
+    name:
+      - kerbside_proxy
+  check_mode: false
+  register: proxy_container_facts
+
+- name: Checking free port for Kerbside Proxy Prometheus
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  ansible.builtin.wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_prometheus_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - proxy_container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside proxy insecure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  ansible.builtin.wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_insecure_listen_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - proxy_container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside proxy secure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  ansible.builtin.wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_secure_listen_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - proxy_container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
