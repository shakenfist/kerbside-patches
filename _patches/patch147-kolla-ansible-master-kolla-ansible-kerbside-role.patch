diff --git a/ansible/roles/kerbside/tasks/upgrade.yml b/ansible/roles/kerbside/tasks/upgrade.yml
new file mode 100644
index 000000000..868d7c918
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/upgrade.yml
@@ -0,0 +1,32 @@
+---
+# Create new set of configs on nodes
+- name: Configure kerbside
+  ansible.builtin.import_tasks: config.yml
+
+# NOTE(mikal): Kerbside does not support its processes running against
+# differing database schema versions, so the whole fleet must be stopped
+# before the bootstrap container migrates the schema below. This means an
+# upgrade always interrupts in-flight consoles, and that staged upgrades
+# via kolla_serial are not supported for Kerbside.
+- name: Stopping kerbside services
+  become: true
+  kolla_container:
+    action: "stop_container"
+    common_options: "{{ docker_common_options }}"
+    name: "{{ item.value.container_name }}"
+  with_dict: >-
+    {{ kerbside_services | select_services_enabled_and_mapped_to_host }}
+
+- name: Check kerbside containers
+  ansible.builtin.import_tasks: check-containers.yml
+
+- name: Bootstrap kerbside service for upgrade
+  ansible.builtin.import_tasks: bootstrap_service.yml
+
+# NOTE(mikal): the handlers flushed here are what start the services again,
+# on the new container images and against the migrated schema. Note that the
+# containers must be stopped before check-containers.yml runs above, because
+# the stopped state is itself what makes it notify those handlers. Stopping
+# them afterwards instead would leave them down when nothing else differs.
+- name: Flush handlers
+  ansible.builtin.meta: flush_handlers
