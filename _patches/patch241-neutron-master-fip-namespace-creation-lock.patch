 import copy
+import threading
 from unittest import mock
 
 from neutron_lib.api.definitions import portbindings
@@ -1029,3 +1030,50 @@ class TestDvrRouterOperations(base.BaseTestCase):
             with open(ri._ha_state_path) as f:
                 state = f.readline()
                 self.assertEqual("backup", state)
+
+    def test_get_fip_ns_concurrent_callers_share_one_namespace(self):
+        # Pool workers processing different routers call get_fip_ns for
+        # the same external network at once during a fullsync. Try to hold
+        # both callers inside the FipNamespace constructor together: if
+        # get_fip_ns did not serialise get, construct and store, each
+        # caller would build and return its own FipNamespace.
+        agent = l3_agent.L3NATAgent(HOSTNAME, self.conf)
+        agent.init_host()
+        ext_net_id = _uuid()
+        entered = []
+        entered_lock = threading.Lock()
+        both_inside = threading.Event()
+
+        def blocking_init(fip_ns, *args, **kwargs):
+            with entered_lock:
+                entered.append(fip_ns)
+                if len(entered) == 2:
+                    both_inside.set()
+            # get_fip_ns serialises construction, so the second caller
+            # cannot get here while the first waits and the wait times
+            # out. Without the lock both callers arrive well within it.
+            both_inside.wait(timeout=0.5)
+            fip_ns.destroyed = False
+
+        results = [None, None]
+        errors = []
+
+        def call_get_fip_ns(index):
+            try:
+                results[index] = agent.get_fip_ns(ext_net_id)
+            except Exception as e:
+                errors.append(e)
+
+        with mock.patch.object(dvr_fip_ns.FipNamespace, '__init__',
+                               new=blocking_init):
+            threads = [threading.Thread(target=call_get_fip_ns, args=(i,))
+                       for i in range(2)]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join(timeout=10)
+            self.assertFalse(any(t.is_alive() for t in threads))
+
+        self.assertEqual([], errors)
+        self.assertIsNotNone(results[0])
+        self.assertIs(results[0], results[1])
