commit 3446d084097953bc8cf8367cbe00fb581f4d8b7f
Author: Michael Still <mikal@stillhq.com>
Date:   Thu Oct 29 07:33:31 2026 +1100

    loopingcall: Allow a restart once wait() returns
    
    With the threading backend, wait() wakes when the loop signals done,
    but the loop's thread is only released later by its done callback, so
    a start() straight after wait() could raise RuntimeError. A loop that
    has signalled done now counts as finished, and a late done callback
    leaves a newer thread alone.
    
    The eventlet backend was not affected: its link callbacks run before
    any waiter is scheduled.
    
    Assisted-By: Claude Opus 5.5 (medium effort)
    Change-Id: I748102bbeab585f8ceb0eb3729451753866b486b
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/oslo_service/backend/_common/loopingcall.py b/oslo_service/backend/_common/loopingcall.py
index affc6d7..89aa659 100644
--- a/oslo_service/backend/_common/loopingcall.py
+++ b/oslo_service/backend/_common/loopingcall.py
@@ -144,9 +144,21 @@ class LoopingCallBase(metaclass=abc.ABCMeta):
     def _spawn_loop(self, loop_func):
         """Spawn the loop function in the appropriate backend."""
 
-    def _on_done(self, *args, **kwargs):
+    def _on_done(self, thread, *args, **kwargs):
         """Callback when the loop is done."""
-        self._thread = None
+        # A restart may already have replaced the thread this callback is
+        # for, so only clear our own.
+        if self._thread is thread:
+            self._thread = None
+
+    def _is_looping(self):
+        """Whether a started loop is still running.
+
+        A loop that has signalled done counts as finished even before its
+        thread's done callback runs, because that signal wakes wait() first
+        and a caller may restart the loop as soon as wait() returns.
+        """
+        return self._thread is not None and not self.done.ready()
 
     def _start(self, idle_for, initial_delay=None, stop_on_exception=True):
         """Start the looping.
@@ -162,7 +174,7 @@ class LoopingCallBase(metaclass=abc.ABCMeta):
             occurs.
         :returns: Done event instance
         """
-        if self._thread is not None:
+        if self._is_looping():
             raise RuntimeError(self._RUN_ONLY_ONE_MESSAGE)
 
         self.done = self._create_done_event()
@@ -364,7 +376,7 @@ class BackOffLoopingCallBase(LoopingCallBase):
         jitter=0.75,
         min_interval=0.001,
     ):
-        if self._thread is not None:
+        if self._is_looping():
             raise RuntimeError(self._RUN_ONLY_ONE_MESSAGE)
 
         # Reset any prior state.
