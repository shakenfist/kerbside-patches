+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+from unittest import mock
+from unittest import TestCase
+
+from oslo_service.backend._common import loopingcall as common_loopingcall
+from oslo_service.backend._threading import loopingcall
+
+
+class LoopingCallRestartTestCase(TestCase):
+    """Restarting a looping call once wait() has returned (threading)."""
+
+    def _stop_and_wait(self, loop):
+        loop.stop()
+        loop.wait()
+
+    def _start_held(self, loop, **kwargs):
+        # Hold back the thread's done callback, as if the thread that ran
+        # the loop had not yet been scheduled after signalling done.
+        with mock.patch.object(loop, '_on_done'):
+            loop.start(**kwargs)
+
+    def test_fixed_interval_restart_before_done_callback(self):
+        loop = loopingcall.FixedIntervalLoopingCall(f=mock.Mock())
+        self.addCleanup(self._stop_and_wait, loop)
+        self._start_held(loop, interval=60, initial_delay=60)
+        self._stop_and_wait(loop)
+
+        loop.start(interval=60, initial_delay=60)
+
+    def test_backoff_restart_before_done_callback(self):
+        loop = loopingcall.BackOffLoopingCall(f=mock.Mock())
+        self.addCleanup(self._stop_and_wait, loop)
+        self._start_held(loop, initial_delay=60)
+        self._stop_and_wait(loop)
+
+        loop.start(initial_delay=60)
+
+    def test_start_while_running_raises(self):
+        loop = loopingcall.FixedIntervalLoopingCall(f=mock.Mock())
+        self.addCleanup(self._stop_and_wait, loop)
+        loop.start(interval=60, initial_delay=60)
+
+        self.assertRaises(RuntimeError, loop.start,
+                          interval=60, initial_delay=60)
+
+    def test_late_done_callback_keeps_new_thread(self):
+        loop = loopingcall.FixedIntervalLoopingCall(f=mock.Mock())
+        self.addCleanup(self._stop_and_wait, loop)
+        self._start_held(loop, interval=60, initial_delay=60)
+        old_thread = loop._thread
+        self._stop_and_wait(loop)
+        loop.start(interval=60, initial_delay=60)
+        new_thread = loop._thread
+
+        # The first loop's done callback finally runs.
+        common_loopingcall.LoopingCallBase._on_done(loop, old_thread)
+
+        self.assertIs(new_thread, loop._thread)
+        self.assertRaises(RuntimeError, loop.start,
+                          interval=60, initial_delay=60)
