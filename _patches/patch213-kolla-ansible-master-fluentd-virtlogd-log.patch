commit c41bd83004dd48a667bb971379ae6bdc22b3ad33
Author: Michael Still <mikal@stillhq.com>
Date:   Thu Oct 15 08:51:38 2026 +1100

    fluentd: Collect the nova_libvirt virtlogd log
    
    nova_libvirt now writes virtlogd's log to
    /var/log/kolla/libvirt/virtlogd.log, but the libvirt tail source only
    follows libvirtd.log, so check-logs.sh reports the file as missing.
    Add it to the source; both files use libvirt's log format.
    
    Prompt: diagnose why Zuul failed every kolla-ansible deploy job on kolla
    change 1010516.
    
    Related-Bug: #2155214
    Change-Id: Idd0a221f53ea3cffc7c198e9f429c5f70b9b3b07
    Signed-off-by: Michael Still <mikal@stillhq.com>
    Assisted-By: Claude Opus 5.5 (1M context, low effort) <noreply@anthropic.com>

diff --git a/ansible/roles/fluentd/templates/conf/input/05-libvirt.conf.j2 b/ansible/roles/fluentd/templates/conf/input/05-libvirt.conf.j2
index 4765c9608..1b173db74 100644
--- a/ansible/roles/fluentd/templates/conf/input/05-libvirt.conf.j2
+++ b/ansible/roles/fluentd/templates/conf/input/05-libvirt.conf.j2
@@ -1,6 +1,6 @@
 <source>
   @type tail
-  path /var/log/kolla/libvirt/libvirtd.log
+  path /var/log/kolla/libvirt/libvirtd.log,/var/log/kolla/libvirt/virtlogd.log
   pos_file /var/run/fluentd/libvirt.pos
   tag infra.libvirt
   enable_watch_timer {{ fluentd_enable_watch_timer }}
diff --git a/releasenotes/notes/fluentd-virtlogd-log-7c2e9d41a5b3f806.yaml b/releasenotes/notes/fluentd-virtlogd-log-7c2e9d41a5b3f806.yaml
