+++ b/ansible/roles/nova-cell/templates/nova-libvirt.json.j2
@@ -116,6 +116,11 @@
             "path": "/var/log/kolla/libvirt/libvirtd.log",
             "owner": "root:kolla",
             "perm": "0664"
+        },
+        {
+            "path": "/var/log/kolla/libvirt/virtlogd.log",
+            "owner": "root:kolla",
+            "perm": "0664"
         }
     ],
     "permissions": [
