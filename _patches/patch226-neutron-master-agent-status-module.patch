+import datetime
+import subprocess
+import sys
+
+from oslo_config import cfg
+from oslo_utils import timeutils
+
+from neutron.agent.common import utils as agent_utils
+from neutron.common import agent_status
+from neutron.tests import base
+
+
+class IsAgentDownTestCase(base.BaseTestCase):
+
+    def setUp(self):
+        super().setUp()
+        cfg.CONF.set_override('agent_down_time', 30)
+
+    def test_recent_heartbeat(self):
+        heartbeat = timeutils.utcnow() - datetime.timedelta(seconds=10)
+        self.assertFalse(agent_status.is_agent_down(heartbeat))
+
+    def test_old_heartbeat(self):
+        heartbeat = timeutils.utcnow() - datetime.timedelta(seconds=60)
+        self.assertTrue(agent_status.is_agent_down(heartbeat))
+
+    def test_agent_utils_alias(self):
+        self.assertIs(agent_status.is_agent_down, agent_utils.is_agent_down)
+
+
+class AgentStatusImportsTestCase(base.BaseTestCase):
+
+    def test_agent_model_does_not_import_agent_side_modules(self):
+        # Run in a fresh interpreter: the test process has already imported
+        # the agent utilities. The agent model only needs is_agent_down.
+        code = ('import sys\n'
+                'import neutron.db.models.agent\n'
+                'print(",".join(m for m in sys.modules\n'
+                '               if m.split(".")[0] == "pyroute2" or\n'
+                '               m == "neutron.privileged" or\n'
+                '               m.startswith("neutron.privileged.")))\n')
+        out = subprocess.check_output(  # noqa: S603
+            [sys.executable, '-c', code], text=True)
+        self.assertEqual('', out.strip())
