+"""Agent liveness, kept free of the agent-side utilities.
+
+The server uses this to judge an agent's heartbeat. It must not import
+neutron.agent.common.utils, which loads pyroute2 and neutron.privileged.
+"""
+
+from oslo_config import cfg
+from oslo_utils import timeutils
+
+from neutron.conf.agent.database import agents_db
+
+
+agents_db.register_db_agents_opts()
+
+
+def is_agent_down(heart_beat_time):
+    return timeutils.is_older_than(heart_beat_time,
+                                   cfg.CONF.agent_down_time)
