diff --git a/ansible/roles/mariadb/templates/galera.cnf.j2 b/ansible/roles/mariadb/templates/galera.cnf.j2
index eede80450..f4dd01966 100644
--- a/ansible/roles/mariadb/templates/galera.cnf.j2
+++ b/ansible/roles/mariadb/templates/galera.cnf.j2
@@ -26,6 +26,9 @@ innodb_autoinc_lock_mode=2
 collation-server = utf8_general_ci
 init-connect='SET NAMES utf8'
 character-set-server = utf8
+{# Pin the pre-11.5 mapping (MDEV-25829) so that tables declaring only a #}
+{# CHARACTER SET keep matching tables that declare neither. #}
+character-set-collations = ''
 
 datadir=/var/lib/mysql/
 
diff --git a/releasenotes/notes/mariadb-character-set-collations-aebe0ca616957d2a.yaml b/releasenotes/notes/mariadb-character-set-collations-aebe0ca616957d2a.yaml
new file mode 100644
index 000000000..f79a27539
--- /dev/null
+++ b/releasenotes/notes/mariadb-character-set-collations-aebe0ca616957d2a.yaml
@@ -0,0 +1,13 @@
+---
+fixes:
+  - |
+    MariaDB is now configured with ``character-set-collations = ''``, which
+    restores the mapping from character set to default collation that MariaDB
+    used before 11.5. MDEV-25829 changed that mapping, so a table created with
+    a bare ``CHARACTER SET utf8mb3`` gained ``utf8mb3_uca1400_ai_ci`` while a
+    table that declared no character set still inherited the database default
+    of ``utf8mb3_general_ci``. OpenStack migrations are not consistent about
+    which of the two forms they use, so on MariaDB 11.5 and later a project
+    could end up with tables in both collations and a later migration joining
+    them would fail with ``Illegal mix of collations``. Existing tables are
+    unchanged; this only affects tables created from now on.
