commit 7eaa03f851df2cb5383328dfe9b0a47a0d53cf53
Author: Michael Still <mikal@stillhq.com>
Date:   Wed Oct 28 15:08:00 2026 +1100

    dhcp: Do not cache a network whose dnsmasq failed to start
    
    DhcpLocalProcess.enable logged a dnsmasq start timeout and returned
    None, and _call_driver reported success anyway, so the agent cached the
    network and marked its ports DHCP-ready. enable now returns False, and
    _call_driver returns that and schedules a resync for the network.
    
    DhcpBase.restart dropped enable's result, so a failed restart after a
    subnet change went the same way. restart now returns that result, and
    refresh_dhcp_helper stops before marking the ports ready.
    
    Assisted-By: Claude Opus 5.5 (high effort)
    Change-Id: I8ef0d5cfcddf3b352eda3688dee14595648ae643
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/neutron/agent/dhcp/agent.py b/neutron/agent/dhcp/agent.py
index f9305cb5f4..0c607eb3aa 100644
--- a/neutron/agent/dhcp/agent.py
+++ b/neutron/agent/dhcp/agent.py
@@ -300,6 +300,12 @@ class DhcpAgent(manager.Manager):
             rv = getattr(driver, action)(**action_kwargs)
             if action == 'get_metadata_bind_interface':
                 return rv
+            if action in ('enable', 'restart') and rv is False:
+                # The driver could not start the DHCP service; retry the
+                # network on the next resync rather than treating it as up.
+                self.schedule_resync(
+                    f'Unable to {action} dhcp for {network.id}', network.id)
+                return False
             return True
         except exceptions.Conflict:
             # No need to resync here, the agent will receive the event related
@@ -553,6 +559,9 @@ class DhcpAgent(manager.Manager):
             self.cache.put(network)
         elif self.call_driver('restart', network):
             self.cache.put(network)
+        else:
+            # The DHCP service did not restart, so its ports are not ready.
+            return
         # mark all ports as active in case the sync included
         # new ports that we hadn't seen yet.
         self.dhcp_ready_ports |= {p.id for p in network.ports}
