diff --git a/releasenotes/notes/dhcp-failed-start-not-cached-eb993c54633f23fc.yaml b/releasenotes/notes/dhcp-failed-start-not-cached-eb993c54633f23fc.yaml
new file mode 100644
index 0000000000..47afc55506
--- /dev/null
+++ b/releasenotes/notes/dhcp-failed-start-not-cached-eb993c54633f23fc.yaml
@@ -0,0 +1,6 @@
+---
+fixes:
+  - |
+    The DHCP agent no longer caches a network whose dnsmasq process failed
+    to start, nor reports that network's ports as DHCP-ready. It now
+    schedules a resync for the network so that the start is retried.
