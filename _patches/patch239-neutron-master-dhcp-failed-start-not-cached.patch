+def _was_configured(future):
+    """Whether a safe_configure_dhcp_for_network call succeeded.
+
+    ThreadPoolExecutorWithBlock.submit returns None when the agent is
+    stopping, and a future that was cancelled, has not finished or raised
+    has no result to read. In all of those cases the network's DHCP
+    service is not known to be running.
+    """
+    if not future or future.cancelled() or not future.done():
+        return False
+    return future.exception() is None and bool(future.result())
+
