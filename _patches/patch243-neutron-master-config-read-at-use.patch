+class TestQuotaExtensionDriverCheck(base.BaseTestCase):
+    """The quota extensions read "quota_driver" when asked, not at import."""
+
+    def _set_quota_driver(self, quota_driver):
+        cfg.CONF.set_override('quota_driver', quota_driver, group='QUOTAS')
+        self.addCleanup(cfg.CONF.clear_override, 'quota_driver',
+                        group='QUOTAS')
+
+    def test_description_with_db_driver(self):
+        for quota_driver in qconf.QUOTA_DB_DRIVERS:
+            self._set_quota_driver(quota_driver)
+            self.assertEqual(
+                'Expose functions for quotas management per project',
+                quotasv2.Quotasv2.get_description())
+
+    def test_description_without_db_driver(self):
+        self._set_quota_driver(qconf.QUOTA_DB_DRIVER_NULL)
+        self.assertEqual('Expose functions for quotas management',
+                         quotasv2.Quotasv2.get_description())
+
+    def test_detail_supported_check(self):
+        check = extensions.EXTENSION_SUPPORTED_CHECK_MAP[
+            quotasv2_detail.ALIAS]
+        self._set_quota_driver(qconf.QUOTA_DB_DRIVER_NULL)
+        self.assertFalse(check())
+        for quota_driver in qconf.QUOTA_DB_DRIVERS:
+            self._set_quota_driver(quota_driver)
+            self.assertTrue(check())
