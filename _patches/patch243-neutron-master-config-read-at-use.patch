+import logging
+from unittest import mock
+
+import fixtures
+from neutron_lib.db import api as db_api
+from oslo_config import cfg
+from sqlalchemy import orm
+
+from neutron.db import db_base_plugin_v2
+from neutron.tests import base
+
+
+class DoOrmExecuteTestCase(base.BaseTestCase):
+    """The ORM listener warns only outside a transaction."""
+
+    def setUp(self):
+        super().setUp()
+        self.log = self.useFixture(fixtures.FakeLogger(
+            name=db_base_plugin_v2.__name__, level=logging.WARNING))
+        self.orm_execute_state = mock.Mock()
+        self.orm_execute_state.session.in_transaction.return_value = False
+
+    def test_warns_without_transaction(self):
+        db_base_plugin_v2.NeutronDbPluginV2.do_orm_execute(
+            self.orm_execute_state)
+        self.assertIn('SQL execution without transaction in progress',
+                      self.log.output)
+
+    def test_silent_in_transaction(self):
+        self.orm_execute_state.session.in_transaction.return_value = True
+        db_base_plugin_v2.NeutronDbPluginV2.do_orm_execute(
+            self.orm_execute_state)
+        self.assertEqual('', self.log.output)
+
+
+class DoOrmExecuteRegistrationTestCase(base.BaseTestCase):
+    """The ORM listener is registered when a plugin is built, if debugging."""
+
+    def setUp(self):
+        super().setUp()
+        # This plugin registers listeners for the nova notifier too; they
+        # are not what is under test here.
+        for option in ('notify_nova_on_port_status_changes',
+                       'notify_nova_on_port_data_changes'):
+            cfg.CONF.set_override(option, False)
+            self.addCleanup(cfg.CONF.clear_override, option)
+        self.expected_call = mock.call(
+            orm.Session, 'do_orm_execute',
+            db_base_plugin_v2.NeutronDbPluginV2.do_orm_execute)
+
+    def _orm_listens(self):
+        """Build a core plugin, returning its "do_orm_execute" listens."""
+        with mock.patch.object(db_api, 'sqla_listen') as sqla_listen:
+            db_base_plugin_v2.NeutronDbPluginV2()
+        return [call for call in sqla_listen.call_args_list
+                if call == self.expected_call]
+
+    def _set_debug(self, value):
+        cfg.CONF.set_override('debug', value)
+        self.addCleanup(cfg.CONF.clear_override, 'debug')
+
+    def test_registered_once_in_debug_mode(self):
+        self._set_debug(True)
+        self.assertEqual([self.expected_call], self._orm_listens())
+
+    def test_not_registered_without_debug_mode(self):
+        self._set_debug(False)
+        self.assertEqual([], self._orm_listens())
+
+    def test_not_registered_without_the_option(self):
+        real_getattr = cfg.ConfigOpts.__getattr__
+
+        def _getattr(conf, name):
+            if name == 'debug':
+                raise cfg.NoSuchOptError('debug')
+            return real_getattr(conf, name)
+
+        with mock.patch.object(cfg.ConfigOpts, '__getattr__', _getattr):
+            self.assertEqual([], self._orm_listens())
