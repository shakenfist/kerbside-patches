+class DoOrmExecuteTestCase(test_base.BaseTestCase):
+
+    def setUp(self):
+        super().setUp()
+        self.log = self.useFixture(fixtures.FakeLogger(
+            name=base.__name__, level=logging.WARNING))
+        self.orm_execute_state = mock.Mock()
+        self.orm_execute_state.session.in_transaction.return_value = False
+
+    def _set_debug(self, value):
+        cfg.CONF.set_override('debug', value)
+        self.addCleanup(cfg.CONF.clear_override, 'debug')
+
+    def test_warns_without_transaction_in_debug_mode(self):
+        self._set_debug(True)
+        base.do_orm_execute(self.orm_execute_state)
+        self.assertIn('SQL execution without transaction in progress',
+                      self.log.output)
+
+    def test_silent_without_debug_mode(self):
+        self._set_debug(False)
+        base.do_orm_execute(self.orm_execute_state)
+        self.assertEqual('', self.log.output)
+        self.orm_execute_state.session.in_transaction.assert_not_called()
+
+    def test_silent_in_transaction(self):
+        self._set_debug(True)
+        self.orm_execute_state.session.in_transaction.return_value = True
+        base.do_orm_execute(self.orm_execute_state)
+        self.assertEqual('', self.log.output)
+
+
