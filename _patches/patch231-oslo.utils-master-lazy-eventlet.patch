+class LazyEventletTest(test_base.BaseTestCase):
+    def _run(self, code):
+        # Run in a fresh interpreter: the test process has already imported
+        # eventlet.
+        cmd = [sys.executable, '-W', 'ignore', '-c', textwrap.dedent(code)]
+        proc = subprocess.run(cmd, capture_output=True, text=True)
+        self.assertEqual(0, proc.returncode, proc.stderr)
+        return proc.stdout.splitlines()
+
+    def test_import_does_not_load_eventlet(self):
+        out = self._run(
+            """
+            import sys
+
+            from oslo_utils import eventletutils
+
+            print('eventlet' in sys.modules)
+            print(eventletutils.EVENTLET_AVAILABLE)
+            """
+        )
+        self.assertEqual(['False', 'True'], out)
+
+    def test_not_patched_before_eventlet_is_imported(self):
+        out = self._run(
+            """
+            import sys
+            import threading
+            import warnings
+
+            from oslo_utils import eventletutils
+
+            print(eventletutils.is_monkey_patched('thread'))
+            print(
+                eventletutils.fetch_current_thread_functor()
+                is threading.current_thread
+            )
+            print(type(eventletutils.Event()) is threading.Event)
+            with warnings.catch_warnings(record=True) as capture:
+                warnings.simplefilter('always')
+                eventletutils.warn_eventlet_not_patched()
+            print(len(capture))
+            print('eventlet' in sys.modules)
+            """
+        )
+        self.assertEqual(['False', 'True', 'True', '0', 'False'], out)
+
+    def test_patched_after_import(self):
+        out = self._run(
+            """
+            import warnings
+
+            from oslo_utils import eventletutils
+
+            import eventlet
+            eventlet.monkey_patch()
+
+            print(eventletutils.is_monkey_patched('thread'))
+            print(
+                eventletutils.fetch_current_thread_functor()
+                is eventlet.getcurrent
+            )
+            event = eventletutils.Event()
+            print(type(event).__name__)
+            waiter = eventlet.spawn(event.wait, 1)
+            eventlet.sleep(0)
+            event.set()
+            print(waiter.wait(), event.wait(0))
+            event.clear()
+            print(event.wait(0.01))
+            with warnings.catch_warnings(record=True) as capture:
+                warnings.simplefilter('always')
+                eventletutils.warn_eventlet_not_patched(
+                    ['os', 'select', 'socket', 'thread', 'time']
+                )
+            print(len(capture))
+            print(eventletutils._eventlet is eventlet)
+            print(eventletutils._patcher is eventlet.patcher)
+            """
+        )
+        self.assertEqual(
+            [
+                'True',
+                'True',
+                'EventletEvent',
+                'True True',
+                'False',
+                '0',
+                'True',
+                'True',
+            ],
+            out,
+        )
+
+    def test_partly_patched_after_import(self):
