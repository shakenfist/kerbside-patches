     if not EVENTLET_AVAILABLE:
         return threading.current_thread  # type: ignore
     else:
-        green_threaded = _patcher.is_monkey_patched('thread')
+        patcher = _get_patcher()
+        green_threaded = patcher is not None and patcher.is_monkey_patched(
+            'thread'
+        )
         if green_threaded:
-            return _eventlet.getcurrent  # type: ignore
+            return _get('_eventlet').getcurrent  # type: ignore
         else:
