-_eventlet = importutils.try_import('eventlet')
-_patcher = importutils.try_import('eventlet.patcher')
+# eventlet and eventlet.patcher, or None if eventlet is not installed. They
+# are not bound here, so that importing this module does not import eventlet;
+# __getattr__ imports them the first time they are needed.
+_eventlet: ModuleType | None
+_patcher: ModuleType | None
+
+
+def __getattr__(name: str) -> Any:
+    if name == '_eventlet':
+        module = importutils.try_import('eventlet')
+    elif name == '_patcher':
+        module = importutils.try_import('eventlet.patcher')
+    else:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    globals()[name] = module
+    return module
+
+
+def _get(name: str) -> Any:
+    # Use the value already bound, which may be one a test has replaced.
+    try:
+        return globals()[name]
+    except KeyError:
+        return __getattr__(name)
+
+
+def _get_patcher() -> Any:
+    # Nothing can be monkey patched until eventlet has been imported, so do
+    # not import it just to ask.
+    if '_patcher' not in globals() and 'eventlet' not in sys.modules:
+        return None
+    return _get('_patcher')
+
 
 # Attribute that can be used by others to see if eventlet is even currently
 # useable (can be used in unittests to skip test cases or test classes that
 # require eventlet to work).
-EVENTLET_AVAILABLE = all((_eventlet, _patcher))
+try:
+    EVENTLET_AVAILABLE = importlib.util.find_spec('eventlet') is not None
+except (ImportError, ValueError):
+    # An import hook may refuse eventlet, as nova's does when it runs with
+    # native threads.
+    EVENTLET_AVAILABLE = False
 
 # Taken from eventlet.py (v0.16.1) patcher code (it's not a accessible set
