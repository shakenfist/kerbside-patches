diff --git a/doc/source/user/operating-kolla.rst b/doc/source/user/operating-kolla.rst
index 8e2a13bd1..6a7e49c6e 100644
--- a/doc/source/user/operating-kolla.rst
+++ b/doc/source/user/operating-kolla.rst
@@ -231,6 +231,58 @@ record but does not check it.
 ``--override-deployer-checks`` turns each refusal into a warning, for example
 after an upgrade done by hand outside these rules.
 
+Build manifests
+~~~~~~~~~~~~~~~
+
+A deployer image may carry a build manifest at
+``/etc/kolla-ansible/manifest.json`` (``kolla_image_manifest_path``), naming
+the digest of every image built with it:
+
+.. code-block:: json
+
+   {
+       "format_version": 1,
+       "tag": "master-debian-trixie",
+       "images": {
+           "nova-api": "sha256:...",
+           "nova-compute": "sha256:..."
+       }
+   }
+
+Each key is an image's repository within ``docker_namespace``: the name
+kolla-build gives the image, with any ``docker_image_name_prefix``. So the key
+for ``quay.io/openstack.kolla/nova-api`` is ``nova-api``. Because the key does
+not include the registry, a manifest still applies when the images are
+mirrored unchanged to another registry and ``docker_registry`` names that.
+
+Every ``<service>_image_full`` variable resolves through the
+``kolla_image_full`` lookup plugin. It gives ``<image>@<digest>`` when the
+manifest names the image and the service's tag is the manifest's ``tag``, and
+``<image>:<tag>`` otherwise. So a service whose ``<service>_tag`` is
+overridden, an image outside ``docker_registry`` and ``docker_namespace``, and
+an image the manifest does not name are pulled by tag, as before. Pulling by
+digest means a deployment runs exactly the images its deployer was built with,
+even if the tag has been pushed again since, and a node added later gets the
+same images as the rest.
+
+The deployer checks above also check the manifest:
+
+* a deployer image without one warns once, and every image is pulled by tag;
+* a manifest built with a tag other than the deployer's is refused, unless
+  ``--override-deployer-checks`` is given; and
+* a manifest which cannot be read, or whose ``format_version`` this Kolla
+  Ansible does not understand, is refused, and ``--override-deployer-checks``
+  does not change that. Set ``kolla_image_manifest_path`` to a path which does
+  not exist to pull every image by tag instead.
+
+Switching between images given by tag and by digest changes every container's
+image reference, so every container is recreated once, including MariaDB and
+RabbitMQ. Do it during an upgrade.
+
+With Docker's classic image store, ``prune-images`` removes images pulled
+only by digest that no container uses, so run ``pull`` after pruning, not
+before.
+
 
 CLI Command Completion
 ~~~~~~~~~~~~~~~~~~~~~~
diff --git a/kolla_ansible/image_manifest.py b/kolla_ansible/image_manifest.py
new file mode 100644
index 000000000..bb2d124d9
--- /dev/null
+++ b/kolla_ansible/image_manifest.py
@@ -0,0 +1,184 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Resolve service images through a build manifest.
+
+A Kolla Ansible deployer image may carry a build manifest, a JSON document
+naming the digest of every image built alongside it:
+
+    {"format_version": 1,
+     "tag": "<the tag the images were pushed with>",
+     "images": {"<repository>": "sha256:<hex>", ...}}
+
+Each key is an image's repository within the namespace: the name kolla-build
+gives the image, plus any image name prefix. For an image
+<docker_registry>/<docker_namespace>/<docker_image_name_prefix>nova-api that
+is <docker_image_name_prefix>nova-api.
+
+image_full() returns <image>@<digest> when the manifest names the image and
+the image's tag is the manifest's tag, and <image>:<tag> otherwise. An image
+outside docker_registry and docker_namespace, or with a tag other than the
+build's, is used as written. Without a manifest every image is pulled by tag.
+
+A manifest which cannot be read, or whose format this Kolla Ansible does not
+understand, is an error rather than a reason to pull by tag, because pulling
+by tag is what the manifest exists to prevent.
+"""
+
+import json
+import os
+import re
+import stat
+
+from kolla_ansible import deployer_checks
+
+FORMAT_VERSION = 1
+
+_DIGEST_RE = re.compile(r'^sha256:[0-9a-f]{64}$')
+
+# Parsed manifests by path, each with the (mtime, size, inode) it was read
+# at. Group and role variables are templated on every use, so the manifest
+# is read once per process and only stat()ed after that.
+_CACHE = {}
+
+
+class ManifestError(ValueError):
+    """A build manifest which cannot be used."""
+
+
+def _stat_key(path):
+    """Return the cache key for a regular file at path, or None."""
+    try:
+        st = os.stat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
+    if not stat.S_ISREG(st.st_mode):
+        return None
+    return (st.st_mtime_ns, st.st_size, st.st_ino)
+
+
+def validate_manifest(manifest, path):
+    """Raise ManifestError unless manifest is a usable build manifest."""
+    if not isinstance(manifest, dict):
+        raise ManifestError('The build manifest %s is not a JSON object.'
+                            % path)
+    version = manifest.get('format_version')
+    if isinstance(version, bool) or not isinstance(version, int):
+        raise ManifestError('The build manifest %s has no integer '
+                            'format_version.' % path)
+    if version != FORMAT_VERSION:
+        raise ManifestError(
+            'The build manifest %s has format_version %d, but this Kolla '
+            'Ansible understands only format_version %d.'
+            % (path, version, FORMAT_VERSION))
+    tag = manifest.get('tag')
+    if not isinstance(tag, str) or not tag:
+        raise ManifestError('The build manifest %s does not record its tag.'
+                            % path)
+    images = manifest.get('images')
+    if not isinstance(images, dict):
+        raise ManifestError('The build manifest %s has no images object.'
+                            % path)
+    for name, digest in images.items():
+        if not isinstance(digest, str) or not _DIGEST_RE.match(digest):
+            raise ManifestError(
+                'The build manifest %s gives image %s the digest %r, which is '
+                'not of the form sha256:<64 hex digits>.'
+                % (path, name, digest))
+
+
+def load_manifest(path):
+    """Return the build manifest at path, or None if there is none.
+
+    A path which is not a regular file counts as no manifest. Raises
+    ManifestError if the file cannot be read or parsed, or is not a usable
+    manifest.
+    """
+    if not path:
+        return None
+    key = _stat_key(path)
+    if key is None:
+        _CACHE.pop(path, None)
+        return None
+    cached = _CACHE.get(path)
+    if cached and cached[0] == key:
+        return cached[1]
+    try:
+        with open(path) as f:
+            manifest = json.load(f)
+    except (OSError, ValueError) as e:
+        raise ManifestError('The build manifest %s cannot be read: %s'
+                            % (path, e))
+    validate_manifest(manifest, path)
+    _CACHE[path] = (key, manifest)
+    return manifest
+
+
+def image_base(docker_registry, docker_namespace):
+    """Return the prefix the manifest's repository names are relative to."""
+    registry = '%s/' % docker_registry if docker_registry else ''
+    return '%s%s/' % (registry, docker_namespace)
+
+
+def image_full(image, tag, base, manifest_path):
+    """Return the reference to pull image at tag by.
+
+    base is image_base() of the configuration, or None if it is unknown, in
+    which case the image is pulled by tag.
+    """
+    tag = str(tag)
+    by_tag = '%s:%s' % (image, tag)
+    if base is None or not image.startswith(base):
+        return by_tag
+    manifest = load_manifest(manifest_path)
+    if manifest is None or tag != manifest['tag']:
+        return by_tag
+    digest = manifest['images'].get(image[len(base):])
+    if not digest:
+        return by_tag
+    return '%s@%s' % (image, digest)
+
+
+def manifest_check(deployer_info, manifest_path, override=False):
+    """Check a deployer image's build manifest.
+
+    Returns a dict of the refusals ('errors') and 'warnings'. With override,
+    a manifest built with another tag is a warning instead, but a manifest
+    which cannot be used is always refused.
+    """
+    errors = []
+    warnings = []
+    try:
+        manifest = load_manifest(manifest_path)
+    except ManifestError as e:
+        return {'errors': [
+            '%s Rebuild the deployer image, or set kolla_image_manifest_path '
+            'to a path which does not exist to pull every image by tag.'
+            % e], 'warnings': []}
+
+    if manifest is None:
+        warnings.append(
+            'This deployer image has no build manifest at %s, so images will '
+            'be pulled by tag rather than by digest, and a tag which has '
+            'moved since this deployer was built will not be noticed.'
+            % manifest_path)
+        return {'errors': errors, 'warnings': warnings}
+
+    tag = deployer_checks.deployer_identity(deployer_info)['tag']
+    if tag and tag != manifest['tag']:
+        errors.append(
+            'This deployer was built with tag %s, but its build manifest %s '
+            'lists the images built with tag %s, so no image would be pulled '
+            'by digest. Use a deployer whose manifest matches its tag. %s'
+            % (tag, manifest_path, manifest['tag'],
+               deployer_checks.OVERRIDE_HINT))
+    return deployer_checks._result(errors, warnings, override)
