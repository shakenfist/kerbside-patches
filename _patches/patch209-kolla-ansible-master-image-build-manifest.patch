diff --git a/ansible/lookup_plugins/kolla_image_full.py b/ansible/lookup_plugins/kolla_image_full.py
new file mode 100644
index 000000000..e079e3ced
--- /dev/null
+++ b/ansible/lookup_plugins/kolla_image_full.py
@@ -0,0 +1,58 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+from ansible.errors import AnsibleError
+from ansible.plugins.lookup import LookupBase
+
+from kolla_ansible import image_manifest
+
+DOCUMENTATION = """
+name: kolla_image_full
+short_description: The reference to pull a Kolla image by
+description:
+  - Returns <image>@<digest> when the build manifest at
+    kolla_image_manifest_path names the image and the tag is the manifest's
+    tag, and <image>:<tag> otherwise.
+  - Reads docker_registry, docker_namespace and kolla_image_manifest_path
+    from the play's variables. If any is undefined, returns <image>:<tag>.
+  - Fails if the manifest exists but cannot be used.
+options:
+  _terms:
+    description: The image, without a tag, and its tag.
+    required: true
+"""
+
+EXAMPLES = """
+nova_api_image_full: "{{ lookup('kolla_image_full', nova_api_image,
+                                 nova_api_tag) }}"
+"""
+
+
+class LookupModule(LookupBase):
+
+    def run(self, terms, variables=None, **kwargs):
+        if len(terms) != 2:
+            raise AnsibleError('kolla_image_full takes an image and a tag, '
+                               'not %r' % (terms,))
+        image, tag = terms
+        variables = variables or {}
+        names = ('docker_registry', 'docker_namespace',
+                 'kolla_image_manifest_path')
+        if not all(name in variables for name in names):
+            return ['%s:%s' % (image, tag)]
+        registry, namespace, path = (
+            self._templar.template(variables[name]) for name in names)
+        base = image_manifest.image_base(registry, namespace)
+        try:
+            return [image_manifest.image_full(image, tag, base, path)]
+        except image_manifest.ManifestError as e:
+            raise AnsibleError(str(e))
