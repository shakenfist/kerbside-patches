+
+HINT = 'Pass --override-deployer-checks to override this check.'
+TAG = 'master-debian-trixie'
+NOVA_API = 'sha256:' + 'a' * 64
+PFX_NOVA_API = 'sha256:' + 'b' * 64
+BASE = 'quay.io/openstack.kolla/'
+
+
+class ManifestTestCase(unittest.TestCase):
+
+    def setUp(self):
+        super().setUp()
+        self.tmpdir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmpdir)
+        self.addCleanup(im._CACHE.clear)
+        self.path = os.path.join(self.tmpdir, 'manifest.json')
+        self.missing = os.path.join(self.tmpdir, 'missing', 'manifest.json')
+
+    def write(self, manifest=None, text=None, **kwargs):
+        if manifest is None:
+            manifest = {
+                'format_version': 1,
+                'tag': TAG,
+                'images': {'nova-api': NOVA_API,
+                           'pfx-nova-api': PFX_NOVA_API},
+            }
+        manifest.update(kwargs)
+        with open(self.path, 'w') as f:
+            f.write(text if text is not None else json.dumps(manifest))
+        # Make sure the rewrite is seen even within mtime's granularity.
+        st = os.stat(self.path)
+        os.utime(self.path, ns=(st.st_atime_ns, st.st_mtime_ns + 1000))
+
+
+class TestImageFull(ManifestTestCase):
+
+    def test_digest(self):
+        self.write()
+        self.assertEqual(
+            BASE + 'nova-api@' + NOVA_API,
+            im.image_full(BASE + 'nova-api', TAG, BASE, self.path))
+
+    def test_no_manifest(self):
+        self.assertEqual(
+            BASE + 'nova-api:' + TAG,
+            im.image_full(BASE + 'nova-api', TAG, BASE, self.missing))
+        self.assertEqual(
+            BASE + 'nova-api:' + TAG,
+            im.image_full(BASE + 'nova-api', TAG, BASE, None))
+
+    def test_directory_is_no_manifest(self):
+        self.assertEqual(
+            BASE + 'nova-api:' + TAG,
+            im.image_full(BASE + 'nova-api', TAG, BASE, self.tmpdir))
+
+    def test_other_tag(self):
+        self.write()
+        self.assertEqual(
+            BASE + 'nova-api:mine',
+            im.image_full(BASE + 'nova-api', 'mine', BASE, self.path))
+
+    def test_tag_not_a_string(self):
+        self.write(tag='2026.1')
+        self.assertEqual(
+            BASE + 'nova-api@' + NOVA_API,
+            im.image_full(BASE + 'nova-api', 2026.1, BASE, self.path))
+
+    def test_image_not_in_manifest(self):
+        self.write()
+        self.assertEqual(
+            BASE + 'rabbitmq-4-1:' + TAG,
+            im.image_full(BASE + 'rabbitmq-4-1', TAG, BASE, self.path))
+
+    def test_image_elsewhere(self):
+        self.write()
+        self.assertEqual(
+            'registry.example/mine/nova-api:' + TAG,
+            im.image_full('registry.example/mine/nova-api', TAG, BASE,
+                          self.path))
+
+    def test_unknown_base(self):
+        self.write()
+        self.assertEqual(
+            BASE + 'nova-api:' + TAG,
+            im.image_full(BASE + 'nova-api', TAG, None, self.path))
+
+    def test_image_name_prefix(self):
+        # The key is the repository within the namespace, prefix included.
+        self.write()
+        self.assertEqual(
+            BASE + 'pfx-nova-api@' + PFX_NOVA_API,
+            im.image_full(BASE + 'pfx-nova-api', TAG, BASE, self.path))
+
+    def test_image_base(self):
+        self.assertEqual(BASE, im.image_base('quay.io', 'openstack.kolla'))
+        self.assertEqual('kolla/', im.image_base('', 'kolla'))
+        self.assertEqual('kolla/', im.image_base(None, 'kolla'))
+
+
+class TestLoadManifest(ManifestTestCase):
+
+    def assertRefused(self, message):
+        with self.assertRaises(im.ManifestError) as cm:
+            im.load_manifest(self.path)
+        self.assertIn(message, str(cm.exception))
+        self.assertIn(self.path, str(cm.exception))
+
+    def test_not_json(self):
+        self.write(text='{not json')
+        self.assertRefused('cannot be read')
+
+    def test_not_an_object(self):
+        self.write(text='[]')
+        self.assertRefused('is not a JSON object')
+
+    def test_no_format_version(self):
+        self.write(text=json.dumps({'tag': TAG, 'images': {}}))
+        self.assertRefused('no integer format_version')
+
+    def test_format_version_not_integer(self):
+        self.write(format_version='1')
+        self.assertRefused('no integer format_version')
+        self.write(format_version=True)
+        self.assertRefused('no integer format_version')
+
+    def test_newer_format_version(self):
+        self.write(format_version=2)
+        self.assertRefused('has format_version 2, but this Kolla Ansible '
+                           'understands only format_version 1')
+
+    def test_no_tag(self):
+        self.write(tag='')
+        self.assertRefused('does not record its tag')
+
+    def test_no_images(self):
+        self.write(images=[])
+        self.assertRefused('has no images object')
+
+    def test_bad_digest(self):
+        self.write(images={'nova-api': 'sha256:abc'})
+        self.assertRefused('gives image nova-api the digest')
+
+    def test_extra_keys_ignored(self):
+        self.write(built_by='ci')
+        self.assertEqual(TAG, im.load_manifest(self.path)['tag'])
+
+    def test_cache(self):
+        self.write()
+        with mock.patch('builtins.open', wraps=open) as m_open:
+            im.load_manifest(self.path)
+            im.load_manifest(self.path)
+            self.assertEqual(1, m_open.call_count)
+            self.write(tag='other')
+            self.assertEqual('other', im.load_manifest(self.path)['tag'])
+            self.assertEqual(3, m_open.call_count)
+
+    def test_removed_manifest_is_forgotten(self):
+        self.write()
+        im.load_manifest(self.path)
+        os.unlink(self.path)
+        self.assertIsNone(im.load_manifest(self.path))
+        self.assertNotIn(self.path, im._CACHE)
+
+
+class TestManifestCheck(ManifestTestCase):
+
+    def test_missing(self):
+        result = im.manifest_check({'tag': TAG}, self.missing)
+        self.assertEqual([], result['errors'])
+        self.assertEqual(
+            ['This deployer image has no build manifest at %s, so images '
+             'will be pulled by tag rather than by digest, and a tag which '
+             'has moved since this deployer was built will not be noticed.'
+             % self.missing], result['warnings'])
+
+    def test_matching(self):
+        self.write()
+        self.assertEqual({'errors': [], 'warnings': []},
+                         im.manifest_check({'tag': TAG}, self.path))
+
+    def test_deployer_without_tag(self):
+        self.write()
+        self.assertEqual({'errors': [], 'warnings': []},
+                         im.manifest_check({}, self.path))
+
+    def test_other_tag(self):
+        self.write(tag='other')
+        result = im.manifest_check({'tag': TAG}, self.path)
+        self.assertEqual(
+            ['This deployer was built with tag %s, but its build manifest %s '
+             'lists the images built with tag other, so no image would be '
+             'pulled by digest. Use a deployer whose manifest matches its '
+             'tag. %s' % (TAG, self.path, HINT)], result['errors'])
+
+    def test_other_tag_override(self):
+        self.write(tag='other')
+        result = im.manifest_check({'tag': TAG}, self.path, True)
+        self.assertEqual([], result['errors'])
+        self.assertEqual(1, len(result['warnings']))
+        self.assertTrue(result['warnings'][0].startswith(
+            'Overriding this refusal because --override-deployer-checks was '
+            'given: This deployer was built with tag'))
+
+    def test_malformed_not_overridable(self):
+        self.write(format_version=2)
+        for override in (False, True):
+            result = im.manifest_check({'tag': TAG}, self.path, override)
+            self.assertEqual([], result['warnings'])
+            self.assertEqual(1, len(result['errors']))
+            self.assertIn('format_version 2', result['errors'][0])
+            self.assertIn('set kolla_image_manifest_path to a path which '
+                          'does not exist', result['errors'][0])
+
+
+class TestLookup(ManifestTestCase):
+
+    def run_lookup(self, terms, **variables):
+        templar = Templar(loader=DataLoader(), variables=variables)
+        lookup = kolla_image_full.LookupModule(templar=templar)
+        return lookup.run(terms, variables=variables)
+
+    def config(self, **kwargs):
+        variables = {
+            'docker_registry': 'quay.io',
+            'docker_namespace': 'openstack.kolla',
+            # Variables from the inventory and group_vars are templates.
+            'kolla_image_manifest_path': trust_as_template(
+                '{{ manifest_dir }}/manifest.json'),
+            'manifest_dir': self.tmpdir,
+        }
+        variables.update(kwargs)
+        return variables
+
+    def test_digest(self):
+        self.write()
+        self.assertEqual(
+            [BASE + 'nova-api@' + NOVA_API],
+            self.run_lookup([BASE + 'nova-api', TAG], **self.config()))
+
+    def test_prefix(self):
+        self.write()
+        self.assertEqual(
+            [BASE + 'pfx-nova-api@' + PFX_NOVA_API],
+            self.run_lookup([BASE + 'pfx-nova-api', TAG], **self.config()))
+
+    def test_no_registry(self):
+        self.write()
+        self.assertEqual(
+            ['openstack.kolla/nova-api@' + NOVA_API],
+            self.run_lookup(['openstack.kolla/nova-api', TAG],
+                            **self.config(docker_registry='')))
+
+    def test_undefined_variables(self):
+        self.write()
+        for name in ('docker_registry', 'docker_namespace',
+                     'kolla_image_manifest_path'):
+            variables = self.config()
+            del variables[name]
+            self.assertEqual(
+                [BASE + 'nova-api:' + TAG],
+                self.run_lookup([BASE + 'nova-api', TAG], **variables))
+
+    def test_no_manifest(self):
+        self.assertEqual(
+            [BASE + 'nova-api:' + TAG],
+            self.run_lookup([BASE + 'nova-api', TAG], **self.config()))
+
+    def test_malformed(self):
+        self.write(text='{')
+        self.assertRaises(AnsibleError, self.run_lookup,
+                          [BASE + 'nova-api', TAG], **self.config())
+
+    def test_wrong_arguments(self):
+        self.assertRaises(AnsibleError, self.run_lookup,
+                          [BASE + 'nova-api'], **self.config())
