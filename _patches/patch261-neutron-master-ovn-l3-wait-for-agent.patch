         router = self._create_router('router1', gw_info=gw_info)
         return router
 
+    def _add_fake_chassis_and_wait(self, host, **kwargs):
+        """Add a fake chassis and wait until its agent can be looked up."""
+        ch_event = ovn_test_utils.WaitForChassisCreate(host)
+        self.sb_api.idl.notify_handler.watch_event(ch_event)
+        chassis = self.add_fake_chassis(host, **kwargs)
+        ch_event.wait()
+        # The agent cache is filled from the Chassis_Private row, which is
+        # written after the Chassis row, so the agent can still be missing.
+        n_utils.wait_until_true(
+            lambda: self._is_agent_cached(chassis), timeout=10)
+        return chassis
+
+    @staticmethod
+    def _is_agent_cached(agent_id):
+        try:
+            neutron_agent.AgentCache().get(agent_id)
+        except KeyError:
+            return False
+        return True
+
