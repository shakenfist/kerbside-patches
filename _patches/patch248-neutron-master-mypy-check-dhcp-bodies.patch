commit bae3c5ae224e8b2f27086fdf28b79803e09e34fd
Author: Michael Still <mikal@stillhq.com>
Date:   Wed Oct 28 15:28:39 2026 +1100

    mypy: Check the DHCP agent and driver function bodies
    
    Check the bodies of unannotated functions in the dnsmasq driver module
    too, and take the DHCP agent off the list of modules that skip them.
    
    The errors this finds are narrowing rather than bugs: an Optional regex
    match, a dict.get of a key that is always present, an untyped attribute
    initialiser, a super().__getattr__ no superclass has, and a get_ports
    signature that differs by design.
    
    Assisted-By: Claude Sonnet 5.5 (medium effort)
    Change-Id: I4e2ba47294713cbd3889155213597d5baf42bfbe
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/neutron/agent/dhcp/agent.py b/neutron/agent/dhcp/agent.py
index 2f8c863b99..4c8f708395 100644
--- a/neutron/agent/dhcp/agent.py
+++ b/neutron/agent/dhcp/agent.py
@@ -970,7 +970,8 @@ class DhcpPluginApi(base_agent_rpc.BasePluginApi):
         if port:
             return dhcp.DictModel(port)
 
-    def get_ports(self, port_filters):
+    # The DHCP plugin API binds its own context, so the signature differs.
+    def get_ports(self, port_filters):  # type: ignore[override]
         ports = super().get_ports(self.context, port_filters)
         if ports:
             return [dhcp.DictModel(port) for port in ports]
@@ -1154,7 +1155,7 @@ class DhcpAgentWithStateReport(DhcpAgent):
 
     def _report_state(self):
         try:
-            configurations = self.agent_state.get('configurations')
+            configurations = self.agent_state['configurations']
             configurations.update(self.cache.get_state())
             configurations['pending_updates'] = self._queue.qsize
             ctx = context.get_admin_context_without_session()
