diff --git a/etc/kolla/globals.yml b/etc/kolla/globals.yml
index 3785398b3..eed690815 100644
--- a/etc/kolla/globals.yml
+++ b/etc/kolla/globals.yml
@@ -209,6 +209,15 @@ workaround_ansible_issue_8743: true
 #default_container_healthcheck_timeout: 30
 #default_container_healthcheck_retries: 3
 #default_container_healthcheck_start_period: 5
+# Individual services accept per-service overrides of the options above,
+# named <service>_healthcheck_<option>. nova_scheduler is the one most
+# often worth raising: its healthcheck asserts an established AMQP
+# connection, but a deploy or reconfigure stops the scheduler's workers
+# and they take around 160 seconds to come back. The default 30 second
+# interval with 3 retries only tolerates 90 seconds of that, so the
+# container is reported unhealthy for the rest of the restart. 8 retries
+# covers the whole window.
+#nova_scheduler_healthcheck_retries: 8
 
 ##################
 # Firewall options
diff --git a/releasenotes/notes/nova-scheduler-healthcheck-retries-12e681b16f6322aa.yaml b/releasenotes/notes/nova-scheduler-healthcheck-retries-12e681b16f6322aa.yaml
new file mode 100644
index 000000000..51cf8ecb7
--- /dev/null
+++ b/releasenotes/notes/nova-scheduler-healthcheck-retries-12e681b16f6322aa.yaml
@@ -0,0 +1,13 @@
+---
+other:
+  - |
+    The ``nova_scheduler`` container healthcheck asserts an established AMQP
+    connection, but a deploy or a reconfigure stops the scheduler's workers
+    and they take around 160 seconds to come back. The default 30 second
+    interval with 3 retries only covers 90 seconds of that, so the container
+    can report as unhealthy for the rest of the restart even though the
+    scheduler is fine. Deployments that hit this can raise
+    ``nova_scheduler_healthcheck_retries``, which is now documented in the
+    sample ``globals.yml``; 8 retries covers the whole window. Kolla CI now
+    sets it. `LP#2162860
+    <https://bugs.launchpad.net/kolla/+bug/2162860>`__
diff --git a/tests/templates/globals-default.j2 b/tests/templates/globals-default.j2
index fb2b715bb..32cb2af98 100644
--- a/tests/templates/globals-default.j2
+++ b/tests/templates/globals-default.j2
@@ -51,6 +51,14 @@ mariadb_monitor_ping_interval: "60000"
 mariadb_monitor_ping_max_failures: "10"
 mariadb_monitor_ping_timeout: "10000"
 
+# Nova scheduler - widen the healthcheck past the worker restart gap.
+# The healthcheck asserts an established AMQP connection, but a deploy or
+# a reconfigure stops the scheduler's workers and they take around 160
+# seconds to come back. The default 30 second interval with 3 retries
+# only covers 90 seconds of that, so check-failure.sh catches the
+# container mid-restart and fails the job.
+nova_scheduler_healthcheck_retries: 8
+
 nova_compute_virt_type: "{{ virt_type }}"
 
 neutron_agents_wrappers: "yes"
