+    def _run_fresh(self, code):
+        out = subprocess.check_output(
+            [sys.executable, '-c', textwrap.dedent(code)], text=True)
+        return out.strip()
+
+    def test_import_does_not_load_alembic(self):
+        """Importing deploy must not load alembic.
+
+        The migration module is only needed when sync_on_startup is set, so
+        update_database() imports it only then.
