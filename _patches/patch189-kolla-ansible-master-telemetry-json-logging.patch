    Convert the telemetry services to JSON logging.
    
    Ceilometer, Aodh, Gnocchi and CloudKitty now honour
    openstack_logging_json.
    
    Prompt: Michael asked for the bulk conversion to be broken into
    batches by project rather than landing as thirty separate commits.
    
    Assisted-By: Claude Opus 5 (1M context, high effort) <noreply@anthropic.com>
    Co-Authored-By: Claude Opus 5 (1M context, high effort) <noreply@anthropic.com>
    
    Signed-off-by: Michael Still <mikal@stillhq.com>

diff --git a/ansible/roles/aodh/templates/aodh.conf.j2 b/ansible/roles/aodh/templates/aodh.conf.j2
index c9c1803..62242a4 100644
--- a/ansible/roles/aodh/templates/aodh.conf.j2
+++ b/ansible/roles/aodh/templates/aodh.conf.j2
@@ -6,6 +6,7 @@ log_dir = /var/log/kolla/aodh
 log_file = aodh-api.log
 {% endif %}
 debug = {{ aodh_logging_debug }}
+use_json = {{ openstack_logging_json }}
 evaluation_interval = {{ aodh_evaluation_interval }}
