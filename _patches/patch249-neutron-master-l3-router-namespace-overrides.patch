         ip_lib.set_ip_nonlocal_bind_for_namespace(self.name, 1,
                                                   root_namespace=True)
 
diff --git a/neutron/agent/l3/dvr_snat_ns.py b/neutron/agent/l3/dvr_snat_ns.py
index c5b73c72c1..3bc8181de9 100644
--- a/neutron/agent/l3/dvr_snat_ns.py
+++ b/neutron/agent/l3/dvr_snat_ns.py
@@ -28,8 +28,8 @@ class SnatNamespace(namespaces.Namespace):
         super().__init__(
             name, agent_conf, driver, use_ipv6)
 
-    def create(self):
-        super().create()
+    def create(self, ipv6_forwarding=True):
+        super().create(ipv6_forwarding=ipv6_forwarding)
         # Set nonlocal_bind to 1 to allow setup applications in HA mode
         # for example ipsec from VPNaaS
         ip_lib.set_ip_nonlocal_bind_for_namespace(self.name, 1)
diff --git a/neutron/agent/l3/ha_router.py b/neutron/agent/l3/ha_router.py
index 7116788370..dee944db3e 100644
--- a/neutron/agent/l3/ha_router.py
+++ b/neutron/agent/l3/ha_router.py
@@ -66,8 +66,8 @@ class HaRouterNamespace(namespaces.RouterNamespace):
     which cause lost connectivity to Floating IPs.
     """
 
-    def create(self):
-        super().create(ipv6_forwarding=False)
+    def create(self, ipv6_forwarding=False):
+        super().create(ipv6_forwarding=ipv6_forwarding)
         # HA router namespaces should have ip_nonlocal_bind enabled
         ip_lib.set_ip_nonlocal_bind_for_namespace(self.name, 1)
         # Linux should not automatically assign link-local addr for HA routers
