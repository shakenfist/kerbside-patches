diff --git a/ansible/roles/nova-cell/tasks/precheck.yml b/ansible/roles/nova-cell/tasks/precheck.yml
index a509e790c..a08597284 100644
--- a/ansible/roles/nova-cell/tasks/precheck.yml
+++ b/ansible/roles/nova-cell/tasks/precheck.yml
@@ -132,3 +132,21 @@
     - container_facts.containers['nova_libvirt'] is defined
     - not nova_libvirt.enabled | bool
     - inventory_hostname in groups[nova_libvirt.group]
+
+- name: Checking certificate files exist for secure SPICE connections
+  vars:
+    nova_libvirt: "{{ nova_cell_services['nova-libvirt'] }}"
+  ansible.builtin.stat:
+    path: "{{ node_custom_config }}/nova-cell/{{ item }}"
+  delegate_to: localhost
+  run_once: true
+  register: result
+  failed_when: not result.stat.exists
+  when:
+    - container_facts.containers['nova_libvirt'] is defined
+    - inventory_hostname in groups[nova_libvirt.group]
+    - nova_spice_require_secure | bool
+  with_items:
+    - serverkey.pem
+    - servercert.pem
+    - cacert.pem
