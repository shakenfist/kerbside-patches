diff --git a/neutron/common/utils.py b/neutron/common/utils.py
index 28a840d3c5..849ba7b97e 100644
--- a/neutron/common/utils.py
+++ b/neutron/common/utils.py
@@ -960,16 +960,18 @@ def spawn_n(func, *args, **kwargs):
 
 
 def timecost(f):
-    call_id = uuidutils.generate_uuid()
-    message_base = ("Time-cost: call %(call_id)s function %(fname)s ") % {
-        "call_id": call_id, "fname": f.__name__}
-    end_message = message_base + "took %(seconds).3fs seconds to run"
-
-    @timeutils.time_it(LOG, message=end_message, min_duration=None)
+    @functools.wraps(f)
     def wrapper(*args, **kwargs):
+        # A new call id for every call, so that the start and end messages
+        # of overlapping calls to the same function can be paired.
+        call_id = uuidutils.generate_uuid()
+        message_base = ("Time-cost: call %(call_id)s function %(fname)s ") % {
+            "call_id": call_id, "fname": f.__name__}
+        end_message = message_base + "took %(seconds).3fs seconds to run"
+
         LOG.debug('%s start', message_base)
-        ret = f(*args, **kwargs)
-        return ret
+        timed = timeutils.time_it(LOG, message=end_message, min_duration=None)
+        return timed(f)(*args, **kwargs)
     return wrapper
 
 
diff --git a/neutron/tests/unit/common/test_utils.py b/neutron/tests/unit/common/test_utils.py
index 3083b24bfa..144fe3d6a1 100644
--- a/neutron/tests/unit/common/test_utils.py
+++ b/neutron/tests/unit/common/test_utils.py
@@ -907,3 +907,34 @@ class TestFindUniqueSequence(base.BaseTestCase):
         # One of the groups is empty - no solution possible
         result = utils.find_unique_sequence([['a'], [], ['c']])
         self.assertIsNone(result)
+
+
+class TestTimecost(base.BaseTestCase):
+    @staticmethod
+    def _call_id(message, args):
+        return re.match(r'Time-cost: call (\S+) ', message % args).group(1)
+
+    def test_call_id_per_call(self):
+        @utils.timecost
+        def decorated(value):
+            return value
+
+        with mock.patch.object(utils, 'LOG') as mock_log:
+            self.assertEqual(1, decorated(1))
+            self.assertEqual(2, decorated(2))
+
+        # LOG.debug(message, args) for the start of each call, and
+        # LOG.log(level, message, args) from time_it for the end.
+        start_ids = [self._call_id(*c.args)
+                     for c in mock_log.debug.call_args_list]
+        end_ids = [self._call_id(*c.args[1:])
+                   for c in mock_log.log.call_args_list]
+        self.assertEqual(2, len(set(start_ids)))
+        self.assertEqual(start_ids, end_ids)
+
+    def test_wraps(self):
+        @utils.timecost
+        def decorated():
+            pass
+
+        self.assertEqual('decorated', decorated.__name__)
