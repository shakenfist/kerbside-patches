+        # Write a new file beside the state file and rename it over the
+        # state file, so a failed write never leaves a truncated file. The
+        # new file gets the same umask-derived mode as open(path, 'w').
+        tmp_file = f'{self.state_file}.{uuidutils.generate_uuid()}.tmp'
+        try:
+            with open(tmp_file, 'x') as f:
