+import os
+import sys
+import threading
 from unittest import mock
 
 from neutron.agent.l3 import item_allocator as ia
@@ -139,3 +142,74 @@ class TestItemAllocator(base.BaseTestCase):
         self.assertIn(allocation, a.pool)
         self.assertEqual({}, a.allocations)
         write.assert_called_once_with([])
+
+    def test_concurrent_allocate_distinct_keys(self):
+        # Every DVR router on an agent shares the fip namespace's
+        # allocators, and pool workers process routers concurrently.
+        # Switch threads as often as possible to expose any interleaving.
+        self.addCleanup(sys.setswitchinterval, sys.getswitchinterval())
+        sys.setswitchinterval(1e-6)
+        state_file = self.get_temp_file_path('allocations')
+        test_pool = {TestObject(s) for s in range(32768, 33768)}
+        a = ia.ItemAllocator(state_file, TestObject, test_pool)
+        pool_size = len(a.pool)
+        num_threads = 64
+        start = threading.Barrier(num_threads, timeout=10)
+        results = {}
+        errors = []
+
+        def allocate(key):
+            try:
+                start.wait()
+                results[key] = a.allocate(key)
+            except Exception as e:
+                errors.append(e)
+
+        threads = [threading.Thread(target=allocate, args=('key%d' % i,))
+                   for i in range(num_threads)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join(timeout=10)
+        self.assertFalse(any(t.is_alive() for t in threads))
+
+        self.assertEqual([], errors)
+        self.assertEqual(num_threads, len(results))
+        self.assertEqual(num_threads,
+                         len({str(v) for v in results.values()}))
+        self.assertEqual(pool_size - num_threads, len(a.pool))
+        with open(state_file) as f:
+            content = f.read()
+        self.assertTrue(content.endswith('\n'))
+        expected = {k: str(v) for k, v in results.items()}
+        self.assertEqual(
+            expected,
+            dict(line.split(',') for line in content.splitlines()))
+
+    def test_write_failure_keeps_previous_state(self):
+        state_file = self.get_temp_file_path('allocations')
+        with open(state_file, 'w') as f:
+            f.write('deadbeef,33000\n')
+        test_pool = {TestObject(33000), TestObject(33001)}
+        a = ia.ItemAllocator(state_file, TestObject, test_pool)
+
+        with mock.patch.object(os, 'replace',
+                               side_effect=OSError('replace failed')):
+            self.assertRaises(OSError, a.allocate, 'abcdef12')
+
+        with open(state_file) as f:
+            self.assertEqual('deadbeef,33000\n', f.read())
+        self.assertEqual([os.path.basename(state_file)],
+                         os.listdir(os.path.dirname(state_file)))
+
+    def test_write_file_mode(self):
+        # The state file gets the mode a plain open(path, 'w') would give.
+        reference = self.get_temp_file_path('reference')
+        with open(reference, 'w'):
+            pass
+        state_file = self.get_temp_file_path('allocations')
+        test_pool = {TestObject(33000), TestObject(33001)}
+        a = ia.ItemAllocator(state_file, TestObject, test_pool)
+        a.allocate('deadbeef')
+        self.assertEqual(os.stat(reference).st_mode,
+                         os.stat(state_file).st_mode)
