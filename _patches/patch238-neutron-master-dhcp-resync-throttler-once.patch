+++ b/neutron/agent/dhcp/agent.py
@@ -127,6 +127,9 @@ class DhcpAgent(manager.Manager):
                 opt_name='resync_throttle',
                 opt_value=self.conf.resync_throttle)
         self._periodic_resync_event = threading.Event()
+        # Built once: the throttler keeps its last-call time in this closure.
+        self._throttled_resync_clear = utils.throttler(
+            self.conf.resync_throttle)(self._periodic_resync_event.clear)
         # create dhcp dir to store dhcp info
         dhcp_dir = os.path.dirname("/%s/dhcp/" % self.conf.state_path)
         fileutils.ensure_tree(dhcp_dir, mode=0o755)
@@ -438,12 +441,8 @@ class DhcpAgent(manager.Manager):
             # except if a timeout is given and the operation times out.
             if self._periodic_resync_event.wait(self.conf.resync_interval):
                 LOG.debug("Resync event has been scheduled")
-                clear_periodic_resync_event = self._periodic_resync_event.clear
-                # configure throttler for clear_periodic_resync_event to
-                # introduce delays between resync state events.
-                throttled_clear_periodic_resync_event = utils.throttler(
-                    self.conf.resync_throttle)(clear_periodic_resync_event)
-                throttled_clear_periodic_resync_event()
+                # Delay consecutive resync events by resync_throttle.
+                self._throttled_resync_clear()
 
             if self.needs_resync_reasons:
                 # be careful to avoid a race with additions to list
diff --git a/neutron/tests/unit/agent/dhcp/test_agent.py b/neutron/tests/unit/agent/dhcp/test_agent.py
index 69e7727dfa..b77799bcdd 100644
--- a/neutron/tests/unit/agent/dhcp/test_agent.py
+++ b/neutron/tests/unit/agent/dhcp/test_agent.py
@@ -893,6 +893,35 @@ class TestDhcpAgent(base.BaseTestCase):
             sync_state.assert_called_once_with(list(resync_reasons.keys()))
             self.assertEqual(0, len(dhcp.needs_resync_reasons))
 
+    def test_periodic_resync_helper_throttles_consecutive_events(self):
+        cfg.CONF.set_override('resync_interval', 30)
+        cfg.CONF.set_override('resync_throttle', 10)
+        dhcp = dhcp_agent.DhcpAgent(HOSTNAME)
+        dhcp.init_host()
+        dhcp.schedule_resync('reason1', 'a')
+        clock = [1000.0]
+        sync_calls = []
+
+        def _sync_state(networks=None):
+            sync_calls.append(networks)
+            if len(sync_calls) == 1:
+                # A second event arrives 3 seconds after the first.
+                clock[0] += 3
+                dhcp.schedule_resync('reason2', 'b')
+                return
+            raise RuntimeError()
+
+        with mock.patch.object(utils, 'time') as mock_time, \
+                mock.patch.object(dhcp, 'sync_state',
+                                  side_effect=_sync_state):
+            mock_time.time.side_effect = lambda: clock[0]
+            with testtools.ExpectedException(RuntimeError):
+                dhcp._periodic_resync_helper()
+            self.assertEqual(2, len(sync_calls))
+            # The first event is not delayed, the second waits for the
+            # remainder of the 10 second throttle.
+            mock_time.sleep.assert_called_once_with(7.0)
+
     def test_periodic_resync_helper_with_event(self):
         with mock.patch.object(dhcp_agent.LOG, 'debug') as log:
             dhcp = dhcp_agent.DhcpAgent(HOSTNAME)
