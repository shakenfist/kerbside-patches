diff --git a/ansible/roles/kerbside/tasks/bootstrap.yml b/ansible/roles/kerbside/tasks/bootstrap.yml
new file mode 100644
index 000000000..c2baf410c
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/bootstrap.yml
@@ -0,0 +1,56 @@
+---
+- name: Creating Kerbside databases
+  become: true
+  kolla_toolbox:
+    container_engine: "{{ kolla_container_engine }}"
+    module_name: mysql_db
+    module_args:
+      login_host: "{{ database_address }}"
+      login_port: "{{ database_port }}"
+      login_user: "{{ kerbside_database_shard_root_user }}"
+      login_password: "{{ database_password }}"
+      name: "{{ kerbside_database_name }}"
+  run_once: true
+  delegate_to: "{{ groups['kerbside-proxy'][0] }}"
+  when:
+    - not use_preconfigured_databases | bool
+
+- name: Creating Kerbside databases user and setting permissions
+  become: true
+  kolla_toolbox:
+    container_engine: "{{ kolla_container_engine }}"
+    module_name: mysql_user
+    module_args:
+      login_host: "{{ database_address }}"
+      login_port: "{{ database_port }}"
+      login_user: "{{ kerbside_database_shard_root_user }}"
+      login_password: "{{ database_password }}"
+      name: "{{ kerbside_database_user }}"
+      password: "{{ kerbside_database_password }}"
+      host: "%"
+      priv: "{{ kerbside_database_name }}.*:ALL"
+      append_privs: "yes"
+  run_once: true
+  delegate_to: "{{ groups['kerbside-proxy'][0] }}"
+  when:
+    - not use_preconfigured_databases | bool
+
+- name: Create kerbside administrative access group
+  become: true
+  kolla_toolbox:
+    container_engine: "{{ kolla_container_engine }}"
+    module_name: "openstack.cloud.identity_group"
+    module_args:
+      state: present
+      name: kerbside
+      description: "Kerbside administrative access group"
+      auth: "{{ openstack_auth }}"
+      endpoint_type: "{{ openstack_interface }}"
+  run_once: true
+  when:
+    - enable_kerbside | bool
+
+- name: Configure kerbside
+  import_tasks: config.yml
+- name: Bootstrap kerbside service
+  import_tasks: bootstrap_service.yml
