diff --git a/ansible/roles/kerbside/templates/kerbside-wsgi.conf.j2 b/ansible/roles/kerbside/templates/kerbside-wsgi.conf.j2
new file mode 100644
index 000000000..304ef982f
--- /dev/null
+++ b/ansible/roles/kerbside/templates/kerbside-wsgi.conf.j2
@@ -0,0 +1,37 @@
+{% if kerbside_enable_tls_backend | bool %}
+{%     if kolla_base_distro in ['centos', 'rocky']  %}
+LoadModule ssl_module /usr/lib64/httpd/modules/mod_ssl.so
+{%     else %}
+LoadModule ssl_module /usr/lib/apache2/modules/mod_ssl.so
+{%     endif %}
+{% endif %}
+Listen {{ api_interface_address | put_address_in_context('url') }}:{{ kerbside_api_listen_port }}
+
+ServerSignature Off
+ServerTokens Prod
+TraceEnable off
+TimeOut {{ kolla_httpd_timeout }}
+KeepAliveTimeout {{ kolla_httpd_keep_alive }}
+
+{% if kerbside_logging_debug | bool %}
+LogLevel info
+{% endif %}
+
+<VirtualHost *:{{ kerbside_api_listen_port }}>
+    WSGIDaemonProcess kerbside-api processes={{ kerbside_api_workers }} threads=1 user=kerbside group=kerbside display-name=kerbside-api
+    WSGIProcessGroup kerbside-api
+    WSGIScriptAlias / /var/www/cgi-bin/kerbside/kerbside-wsgi
+    WSGIApplicationGroup %{GLOBAL}
+    WSGIPassAuthorization On
+    <IfVersion >= 2.4>
+      ErrorLogFormat "%{cu}t %M"
+    </IfVersion>
+    ErrorLog /var/log/kolla/kerbside/kerbside-api-error.log
+    LogFormat "%{X-Forwarded-For}i %l %u %t \"%r\" %>s %b %D \"%{Referer}i\" \"%{User-Agent}i\"" logformat
+    CustomLog /var/log/kolla/kerbside/kerbside-api-access.log logformat
+{% if kerbside_enable_tls_backend | bool %}
+    SSLEngine On
+    SSLCertificateFile /etc/kerbside/certs/kerbside-cert.pem
+    SSLCertificateKeyFile /etc/kerbside/certs/kerbside-key.pem
+{% endif %}
+</VirtualHost>
diff --git a/ansible/roles/kerbside/templates/kerbside.ini.j2 b/ansible/roles/kerbside/templates/kerbside.ini.j2
new file mode 100644
index 000000000..aa88c2da5
--- /dev/null
+++ b/ansible/roles/kerbside/templates/kerbside.ini.j2
@@ -0,0 +1,34 @@
+[kerbside]
+log_output_path = /var/log/kolla/kerbside/{{ service_name }}.log
+{% if kerbside_json_logging | bool %}
+log_output_json = true
+{% endif %}
+
+public_fqdn = {{ keystone_external_fqdn | put_address_in_context('url') }}
+public_secure_port = {{ kerbside_vdi_secure_port }}
+public_insecure_port = {{ kerbside_vdi_insecure_port }}
+cacert_path = /etc/pki/kerbside/kerbside-ca.pem
+proxy_host_cert_path = /etc/pki/kerbside/kerbside-cert.pem
+proxy_host_cert_key_path = /etc/pki/kerbside/kerbside-key.pem
+proxy_host_subject = 
+sql_url = mysql+pymysql://{{ kerbside_database_user }}:{{ kerbside_database_password }}@{{ kerbside_database_address }}/{{ kerbside_database_name }}
+
+api_port = {{ kerbside_api_listen_port }}
+node_name = {{ inventory_hostname }}
+vdi_address = {{ api_interface_address }}
+vdi_secure_port = {{ kerbside_vdi_secure_listen_port }}
+vdi_insecure_port = {{ kerbside_vdi_insecure_listen_port }}
+sources_path = /etc/kerbside/sources.yaml
+
+auth_secret_seed = {{ kerbside_auth_secret_seed }}
+keystone_auth_url = {{ keystone_internal_url }}
+keystone_auth_verify = false
+keystone_service_auth_user = {{ keystone_admin_user }}
+keystone_service_auth_password = {{ keystone_admin_password }}
+keystone_service_auth_project = {{ keystone_admin_project }}
+keystone_service_auth_user_domain_id = {{ default_user_domain_id }}
+keystone_service_auth_project_domain_id = {{ default_project_domain_id }}
+keystone_access_group = kerbside
+
+# this is needed so that keystone can trust the internal certificate
+os_cacert = {{ openstack_cacert }}
