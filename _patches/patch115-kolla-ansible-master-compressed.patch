diff --git a/ansible/roles/kerbside/defaults/main.yml b/ansible/roles/kerbside/defaults/main.yml
new file mode 100644
index 000000000..5d32a74fa
--- /dev/null
+++ b/ansible/roles/kerbside/defaults/main.yml
@@ -0,0 +1,157 @@
+---
+kerbside_services:
+  kerbside_api:
+    container_name: "kerbside_api"
+    group: "kerbside-api"
+    image: "{{ kerbside_api_image_full }}"
+    enabled: "{{ enable_kerbside }}"
+    volumes: "{{ kerbside_api_volumes + kerbside_default_volumes + kerbside_extra_volumes }}"
+    dimensions: "{{ kerbside_dimensions }}"
+    healthcheck: "{{ kerbside_healthcheck_api }}"
+    wsgi: "kerbside.api:app"
+    haproxy:
+      kerbside_api:
+        enabled: "{{ enable_kerbside | bool }}"
+        mode: "http"
+        external: false
+        port: "{{ kerbside_api_port }}"
+        listen_port: "{{ kerbside_api_listen_port }}"
+        tls_backend: "{{ kerbside_enable_tls_backend }}"
+        backend_http_extra:
+          - "option httpchk GET /"
+      kerbside_api_external:
+        enabled: "{{ enable_kerbside | bool }}"
+        mode: "http"
+        external: true
+        external_fqdn: "{{ kolla_external_fqdn }}"
+        port: "{{ kerbside_api_public_port }}"
+        listen_port: "{{ kerbside_api_listen_port }}"
+        tls_backend: "{{ kerbside_enable_tls_backend }}"
+        backend_http_extra:
+          - "option httpchk GET /"
+  kerbside_proxy:
+    container_name: "kerbside_proxy"
+    group: "kerbside-proxy"
+    image: "{{ kerbside_proxy_image_full }}"
+    enabled: "{{ enable_kerbside }}"
+    volumes: "{{ kerbside_proxy_volumes + kerbside_default_volumes + kerbside_extra_volumes }}"
+    dimensions: "{{ kerbside_dimensions }}"
+    healthcheck: "{{ kerbside_healthcheck_proxy }}"
+    haproxy:
+      kerbside_proxy_insecure:
+        enabled: "{{ enable_kerbside | bool }}"
+        mode: "tcp"
+        external: false
+        port: "{{ kerbside_vdi_insecure_port }}"
+        listen_port: "{{ kerbside_vdi_insecure_listen_port }}"
+        tls_backend: false
+      kerbside_proxy_insecure_external:
+        enabled: "{{ enable_kerbside | bool }}"
+        mode: "tcp"
+        external: true
+        external_fqdn: "{{ kolla_external_fqdn }}"
+        port: "{{ kerbside_vdi_insecure_port }}"
+        listen_port: "{{ kerbside_vdi_insecure_listen_port }}"
+        tls_backend: false
+      kerbside_proxy_secure:
+        enabled: "{{ enable_kerbside | bool }}"
+        mode: "tcp"
+        external: false
+        port: "{{ kerbside_vdi_secure_port }}"
+        listen_port: "{{ kerbside_vdi_secure_listen_port }}"
+        tls_backend: false
+      kerbside_proxy_secure_external:
+        enabled: "{{ enable_kerbside | bool }}"
+        mode: "tcp"
+        external: true
+        external_fqdn: "{{ kolla_external_fqdn }}"
+        port: "{{ kerbside_vdi_secure_port }}"
+        listen_port: "{{ kerbside_vdi_secure_listen_port }}"
+        tls_backend: false
+
+
+####################
+# Docker
+####################
+
+kerbside_tag: "{{ openstack_tag }}"
+kerbside_base_image: "{{ docker_image_url }}kerbside-base"
+kerbside_base_image_full: "{{ kerbside_api_image }}:{{ kerbside_tag }}"
+kerbside_api_image: "{{ docker_image_url }}kerbside-api"
+kerbside_api_image_full: "{{ kerbside_api_image }}:{{ kerbside_tag }}"
+kerbside_proxy_image: "{{ docker_image_url }}kerbside-proxy"
+kerbside_proxy_image_full: "{{ kerbside_proxy_image }}:{{ kerbside_tag }}"
+kerbside_dimensions: "{{ default_container_dimensions }}"
+
+kerbside_enable_healthchecks: "{{ enable_container_healthchecks }}"
+kerbside_healthcheck_interval: "{{ default_container_healthcheck_interval }}"
+kerbside_healthcheck_retries: "{{ default_container_healthcheck_retries }}"
+kerbside_healthcheck_start_period: "{{ default_container_healthcheck_start_period }}"
+kerbside_healthcheck_timeout: "{{ default_container_healthcheck_timeout }}"
+
+kerbside_api_healthcheck_test: ["CMD-SHELL", "healthcheck_curl {{ 'https' if kerbside_enable_tls_backend | bool else 'http' }}://{{ api_interface_address | put_address_in_context('url') }}:{{ kerbside_api_listen_port }} "]
+kerbside_proxy_healthcheck_test: ["CMD-SHELL", "healthcheck_port kerbside {{ kerbside_vdi_secure_listen_port }}"]
+
+kerbside_healthcheck_api:
+  interval: "{{ kerbside_healthcheck_interval }}"
+  retries: "{{ kerbside_healthcheck_retries }}"
+  start_period: "{{ kerbside_healthcheck_start_period }}"
+  test: "{% if kerbside_enable_healthchecks | bool %}{{ kerbside_api_healthcheck_test }}{% else %}NONE{% endif %}"
+  timeout: "{{ kerbside_healthcheck_timeout }}"
+
+kerbside_healthcheck_proxy:
+  interval: "{{ kerbside_healthcheck_interval }}"
+  retries: "{{ kerbside_healthcheck_retries }}"
+  start_period: "{{ kerbside_healthcheck_start_period }}"
+  test: "{% if kerbside_enable_healthchecks | bool %}{{ kerbside_proxy_healthcheck_test }}{% else %}NONE{% endif %}"
+  timeout: "{{ kerbside_healthcheck_timeout }}"
+
+kerbside_extra_volumes: "{{ default_extra_volumes }}"
+kerbside_bootstrap_volumes:
+  - "{{ node_config_directory }}/kerbside_bootstrap/:{{ container_config_directory }}/:ro"
+kerbside_api_volumes:
+  - "{{ node_config_directory }}/kerbside_api/:{{ container_config_directory }}/:ro"
+kerbside_proxy_volumes:
+  - "{{ node_config_directory }}/kerbside_proxy/:{{ container_config_directory }}/:ro"
+kerbside_default_volumes:
+  - "/etc/localtime:/etc/localtime:ro"
+  - "{{ '/etc/timezone:/etc/timezone:ro' if ansible_facts.os_family == 'Debian' else '' }}"
+  - "kolla_logs:/var/log/kolla/"
+  - "{{ kolla_dev_repos_directory ~ '/kerbside:/dev-mode/kerbside' if kerbside_dev_mode | bool else '' }}"
+kerbside_json_logging: "no"
+
+####################
+# Kerbside Database
+####################
+kerbside_database_name: "kerbside"
+kerbside_database_user: "{% if use_preconfigured_databases | bool and use_common_mariadb_user | bool %}{{ database_user }}{% else %}kerbside{% endif %}"
+kerbside_database_address: "{{ database_address | put_address_in_context('url') }}:{{ database_port }}"
+
+####################
+# Database sharding
+####################
+kerbside_database_shard_root_user: "{% if enable_proxysql | bool %}root_shard_{{ kerbside_database_shard_id }}{% else %}{{ database_user }}{% endif %}"
+kerbside_database_shard_id: "{{ mariadb_default_database_shard_id | int }}"
+kerbside_database_shard:
+  users:
+    - user: "{{ kerbside_database_user }}"
+      password: "{{ kerbside_database_password }}"
+      shard_id: "{{ kerbside_database_shard_id }}"
+  rules:
+    - schema: "{{ kerbside_database_name }}"
+      shard_id: "{{ kerbside_database_shard_id }}"
+    - user: "{{ kerbside_database_user }}"
+      shard_id: "{{ kerbside_database_shard_id }}"
+
+####################
+# Kolla
+####################
+kerbside_git_repository: "{{ kolla_dev_repos_git }}/{{ project_name }}"
+kerbside_dev_repos_pull: "{{ kolla_dev_repos_pull }}"
+kerbside_dev_mode: "{{ kolla_dev_mode }}"
+kerbside_source_version: "{{ kolla_source_version }}"
+
+############
+# WSGI
+############
+kerbside_wsgi_provider: "uwsgi"
