diff --git a/ansible/roles/kerbside/tasks/config.yml b/ansible/roles/kerbside/tasks/config.yml
new file mode 100644
index 000000000..0b1931665
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/config.yml
@@ -0,0 +1,165 @@
+---
+- name: Ensuring config directories exist
+  become: true
+  file:
+    path: "{{ node_config_directory }}/{{ item.key }}"
+    state: "directory"
+    owner: "{{ config_owner_user }}"
+    group: "{{ config_owner_group }}"
+    mode: "0770"
+  with_dict: "{{ kerbside_services | select_services_enabled_and_mapped_to_host }}"
+
+- name: Ensure bootstrap config directory exists
+  become: true
+  file:
+    path: "{{ node_config_directory }}/kerbside_bootstrap"
+    state: "directory"
+    owner: "{{ config_owner_user }}"
+    group: "{{ config_owner_group }}"
+    mode: "0770"
+
+- name: Ensuring shared config directory exists
+  become: true
+  file:
+    path: "/etc/kolla/kerbside"
+    state: "directory"
+    owner: "{{ config_owner_user }}"
+    group: "{{ config_owner_group }}"
+    mode: "0770"
+
+- name: Store the SPICE TLS CA cert in a fact for use in the template
+  ansible.builtin.set_fact:
+    spice_cacert: "{{ lookup('ansible.builtin.file', node_custom_config + '/nova/nova-libvirt/cacert.pem') }}"
+  when:
+    - inventory_hostname in groups["kerbside-proxy"]
+    - kerbside_services["kerbside_proxy"].enabled | bool
+    - nova_spice_require_secure | bool
+
+- name: Copying over kerbside bootstrap configuration
+  vars:
+    service_name: "kerbside_bootstrap"
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside.ini.j2"
+    dest: "{{ node_config_directory }}/kerbside_bootstrap/kerbside.ini"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-api"]
+    - kerbside_services["kerbside_api"].enabled | bool
+
+- name: Copying over kerbside API configuration
+  vars:
+    service_name: "kerbside_api"
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside.ini.j2"
+    dest: "{{ node_config_directory }}/kerbside_api/kerbside.ini"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-api"]
+    - kerbside_services["kerbside_api"].enabled | bool
+  notify:
+    - "Restart kerbside_api container"
+
+- name: Copying over kerbside proxy configuration
+  vars:
+    service_name: "kerbside_proxy"
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside.ini.j2"
+    dest: "{{ node_config_directory }}/kerbside_proxy/kerbside.ini"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-proxy"]
+    - kerbside_services["kerbside_proxy"].enabled | bool
+  notify:
+    - "Restart kerbside_proxy container"
+
+- name: Copying over kerbside bootstrap alembic wrapper
+  vars:
+    service_name: "kerbside_bootstrap"
+  become: true
+  copy:
+    src: "{{ role_path }}/files/kerbside_alembic_wrapper"
+    dest: "{{ node_config_directory }}/kerbside_bootstrap/kerbside_alembic_wrapper"
+    mode: "0700"
+  when:
+    - inventory_hostname in groups["kerbside-api"]
+    - kerbside_services["kerbside_api"].enabled | bool
+
+- name: Copying over kerbside sources.yaml for API container
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside_sources.yaml.j2"
+    dest: "{{ node_config_directory }}/kerbside_api/sources.yaml"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-api"]
+    - kerbside_services["kerbside_api"].enabled | bool
+  notify:
+    - "Restart kerbside_api container"
+
+- name: Copying over kerbside sources.yaml for proxy container
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside_sources.yaml.j2"
+    dest: "{{ node_config_directory }}/kerbside_proxy/sources.yaml"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-proxy"]
+    - kerbside_services["kerbside_proxy"].enabled | bool
+  notify:
+    - "Restart kerbside_proxy container"
+
+- name: Copy certificates
+  include_tasks: copy-certs.yml
+
+- name: Copying over config.json files for bootstrap
+  become: true
+  template:
+    src: "kerbside_bootstrap.json.j2"
+    dest: "{{ node_config_directory }}/kerbside_bootstrap/config.json"
+    mode: "0660"
+
+- name: Copying over config.json files for services
+  become: true
+  template:
+    src: "{{ item.key }}.json.j2"
+    dest: "{{ node_config_directory }}/{{ item.key }}/config.json"
+    mode: "0660"
+  with_dict: "{{ kerbside_services | select_services_enabled_and_mapped_to_host }}"
+
+- name: Copying over kerbside-wsgi.conf
+  vars:
+    service: "{{ kerbside_services['kerbside_api'] }}"
+  become: true
+  template:
+    src: "{{ item }}"
+    dest: "{{ node_config_directory }}/kerbside/kerbside-wsgi.conf"
+    mode: "0660"
+  with_first_found:
+    - "{{ node_custom_config }}/kerbside/{{ inventory_hostname }}/kerbside-wsgi.conf"
+    - "{{ node_custom_config }}/kerbside/kerbside-wsgi.conf"
+    - "kerbside-wsgi.conf.j2"
+  when:
+    - service | service_enabled_and_mapped_to_host
+    - kerbside_wsgi_provider == "apache"
+
+- name: "Configure uWSGI for kerbside"
+  include_role:
+    name: service-uwsgi-config
+  vars:
+    project_services: "{{ kerbside_services }}"
+    service: "{{ kerbside_services['kerbside_api'] }}"
+    service_name: "kerbside-api"
+    service_uwsgi_config_file: "{{ node_config_directory }}/kerbside_api/kerbside-uwsgi.ini"
+    service_uwsgi_config_http_port: "{{ kerbside_api_listen_port }}"
+    service_uwsgi_config_log_file_chmod: "644"
+    service_uwsgi_config_module: "{{ service.wsgi }}"
+    service_uwsgi_config_tls_backend: "{{ kerbside_enable_tls_backend | bool }}"
+    service_uwsgi_config_tls_cert: "/etc/pki/kerbside/kerbside-cert.pem"
+    service_uwsgi_config_tls_key: "/etc/pki/kerbside/kerbside-key.pem"
+    service_uwsgi_config_uid: "kerbside"
+  when:
+    - service | service_enabled_and_mapped_to_host
+    - kerbside_wsgi_provider == "uwsgi"
diff --git a/ansible/roles/kerbside/tasks/copy-certs.yml b/ansible/roles/kerbside/tasks/copy-certs.yml
