new file mode 100644
index 000000000..dcae499e0
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/precheck.yml
@@ -0,0 +1,132 @@
+---
+- name: Run service precheck
+  import_role:
+    name: service-precheck
+  vars:
+    service_precheck_services: "{{ kerbside_services }}"
+    service_name: "{{ project_name }}"
+
+- name: Ensure there are hosts in the kerbside-api group
+  fail:
+    msg: There are no nodes in the kerbside-api group
+  when:
+    - enable_kerbside | bool
+    - groups['kerbside-api'] | length == 0
+
+- name: Ensure there are hosts in the kerbside-proxy group
+  fail:
+    msg: There are no nodes in the kerbside-proxy group
+  when:
+    - enable_kerbside | bool
+    - groups['kerbside-proxy'] | length == 0
+
+- name: Get API container facts
+  become: true
+  kolla_container_facts:
+    action: get_containers
+    container_engine: "{{ kolla_container_engine }}"
+    name:
+      - kerbside-api
+  check_mode: false
+  register: api_container_facts
+
+- name: Checking free port for Kerbside API
+  vars:
+    service: "{{ kerbside_services['kerbside_api'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - api_container_facts.containers['kerbside_api'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside API Prometheus
+  vars:
+    service: "{{ kerbside_services['kerbside_api'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_prometheus_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - api_container_facts.containers['kerbside_api'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside API insecure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_api'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_insecure_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - api_container_facts.containers['kerbside_api'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside API secure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_api'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_secure_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - api_container_facts.containers['kerbside_api'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Get proxy container facts
+  become: true
+  kolla_container_facts:
+    action: get_containers
+    container_engine: "{{ kolla_container_engine }}"
+    name:
+      - kerbside-proxy
+  check_mode: false
+  register: proxy_container_facts
+
+- name: Checking free port for Kerbside Proxy Prometheus
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_prometheus_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - proxy_container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside proxy insecure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_insecure_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - proxy_container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside proxy secure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_secure_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - proxy_container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
