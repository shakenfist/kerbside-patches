@@ -0,0 +1,42 @@
+---
+- job:
+    name: kolla-ansible-kerbside-base
+    parent: kolla-ansible-base
+    voting: false
+    timeout: 10800
+    files: !inherit
+      - ^ansible/group_vars/all/(kerbside|nova).yml
+      - ^ansible/roles/(kerbside|nova|nova-cell)/
+      - ^ansible/roles/certificates/tasks/generate-kerbside.yml
+      - ^ansible/roles/certificates/templates/openssl-kolla-kerbside.cnf.j2
+    vars:
+      scenario: kerbside
+      kolla_build_images: true
+      scenario_images_extra:
+        - ^kerbside
+        - ^nova-libvirt-spice
+
+- job:
+    name: kolla-ansible-debian-trixie-kerbside
+    parent: kolla-ansible-kerbside-base
+    nodeset: kolla-ansible-debian-trixie-16GB
+
+- job:
+    name: kolla-ansible-rocky-10-kerbside
+    parent: kolla-ansible-kerbside-base
+    nodeset: kolla-ansible-rocky-10-16GB
+
+- job:
+    name: kolla-ansible-ubuntu-noble-kerbside
+    parent: kolla-ansible-kerbside-base
+    nodeset: kolla-ansible-ubuntu-noble-16GB
+
+- project-template:
+    name: kolla-ansible-scenario-kerbside
+    description: |
+      Runs Kolla-Ansible Kerbside scenario jobs.
+    check:
+      jobs:
+        - kolla-ansible-debian-trixie-kerbside
+        - kolla-ansible-rocky-10-kerbside
+        - kolla-ansible-ubuntu-noble-kerbside
