--- a/kolla/docker/nova/nova-libvirt/kolla_nova_libvirt_start.sh
+++ b/kolla/docker/nova/nova-libvirt/kolla_nova_libvirt_start.sh
@@ -5,8 +5,11 @@ set -euo pipefail
 # nova instance console logs to rotate. Otherwise they will
 # consume unbounded amounts of disk.
 #
-# No exec here: libvirtd will be the "main" process.
-/usr/sbin/virtlogd &
+# virtlogd's pidfile and socket live in the host's /run. --daemon
+# returns only once virtlogd holds both, so a conflicting virtlogd on
+# the host stops the container here instead of being silently used.
+LIBVIRT_LOG_OUTPUTS="3:file:/var/log/kolla/libvirt/virtlogd.log" \
+    /usr/sbin/virtlogd --daemon
 
 # Now hand over PID 1's direct child role to libvirtd.
 exec /usr/sbin/libvirtd --listen
diff --git a/releasenotes/notes/nova-libvirt-virtlogd-fail-loudly-3e1f6c0a9b2d4e57.yaml b/releasenotes/notes/nova-libvirt-virtlogd-fail-loudly-3e1f6c0a9b2d4e57.yaml
new file mode 100644
index 000000000..d1b679889
--- /dev/null
+++ b/releasenotes/notes/nova-libvirt-virtlogd-fail-loudly-3e1f6c0a9b2d4e57.yaml
@@ -0,0 +1,11 @@
+---
+fixes:
+  - |
+    The ``nova_libvirt`` container now fails to start if its ``virtlogd``
+    sidecar cannot claim ``/run/virtlogd.pid`` and
+    ``/run/libvirt/virtlogd-sock``. Previously a ``virtlogd`` running on
+    the host, which cannot see the instance directories, would silently
+    take over and instance creation failed with ``Unable to open file:
+    /var/lib/nova/instances/<uuid>/console.log``. Stop and disable the
+    host's ``virtlogd.socket`` and ``virtlogd.service`` units if this
+    occurs.
