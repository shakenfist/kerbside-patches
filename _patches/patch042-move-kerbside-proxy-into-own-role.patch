diff --git a/ansible/roles/kerbside/tasks/config.yml b/ansible/roles/kerbside/tasks/config.yml
new file mode 100644
index 000000000..bc47f33b5
--- /dev/null
+++ b/ansible/roles/kerbside/tasks/config.yml
@@ -0,0 +1,61 @@
+---
+- name: Ensuring config directories exist
+  become: true
+  file:
+    path: "{{ node_config_directory }}/{{ item.key }}"
+    state: "directory"
+    owner: "{{ config_owner_user }}"
+    group: "{{ config_owner_group }}"
+    mode: "0770"
+  with_dict: "{{ kerbside_services | select_services_enabled_and_mapped_to_host }}"
+
+- name: Ensuring shared config directory exists
+  become: true
+  file:
+    path: "/etc/kolla/kerbside"
+    state: "directory"
+    owner: "{{ config_owner_user }}"
+    group: "{{ config_owner_group }}"
+    mode: "0770"
+
+- name: Store the SPICE TLS CA cert in a fact for use in the template
+  ansible.builtin.set_fact:
+    spice_cacert: "{{ lookup('ansible.builtin.file', node_custom_config + '/nova/nova-libvirt/cacert.pem') }}"
+  when:
+    - inventory_hostname in groups["kerbside-proxy"]
+    - kerbside_services["kerbside_proxy"].enabled | bool
+    - nova_spice_require_secure | bool
+
+- name: Copying over kerbside configuration
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside_config.j2"
+    dest: "{{ node_config_directory }}/kerbside_proxy/kerbside_config"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-proxy"]
+    - kerbside_services["kerbside_proxy"].enabled | bool
+  notify:
+    - "Restart kerbside_proxy container"
+
+- name: Copying over kerbside sources.yaml
+  become: true
+  template:
+    src: "{{ role_path }}/templates/kerbside_sources.yaml.j2"
+    dest: "{{ node_config_directory }}/kerbside_proxy/sources.yaml"
+    mode: "0660"
+  when:
+    - inventory_hostname in groups["kerbside-proxy"]
+    - kerbside_services["kerbside_proxy"].enabled | bool
+  notify:
+    - "Restart kerbside_proxy container"
+
+- include_tasks: copy-certs.yml
+
+- name: Copying over config.json files for services
+  become: true
+  template:
+    src: "{{ item.key }}.json.j2"
+    dest: "{{ node_config_directory }}/{{ item.key }}/config.json"
+    mode: "0660"
+  with_dict: "{{ kerbside_services | select_services_enabled_and_mapped_to_host }}"
