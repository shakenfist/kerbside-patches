@@ -0,0 +1,68 @@
+---
+- import_role:
+    name: service-precheck
+  vars:
+    service_precheck_services: "{{ kerbside_services }}"
+    service_name: "{{ project_name }}"
+
+- name: Get container facts
+  become: true
+  kolla_container_facts:
+    action: get_containers
+    container_engine: "{{ kolla_container_engine }}"
+    name:
+      - kerbside-proxy
+  check_mode: false
+  register: container_facts
+
+- name: Checking free port for Kerbside API
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside Prometheus
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_prometheus_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside insecure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_insecure_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
+
+- name: Checking free port for Kerbside secure SPICE port
+  vars:
+    service: "{{ kerbside_services['kerbside_proxy'] }}"
+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ kerbside_vdi_secure_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - container_facts.containers['kerbside_proxy'] is not defined
+    - service | service_enabled_and_mapped_to_host
