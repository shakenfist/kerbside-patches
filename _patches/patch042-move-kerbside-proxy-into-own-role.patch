@@ -0,0 +1,18 @@
+---
+- name: Running Kerbside bootstrap container
+  become: true
+  kolla_container:
+    action: "start_container"
+    common_options: "{{ docker_common_options }}"
+    detach: False
+    environment:
+      KOLLA_BOOTSTRAP:
+      KOLLA_CONFIG_STRATEGY: "{{ config_strategy }}"
+    image: "{{ kerbside_services['kerbside_proxy']['image'] }}"
+    labels:
+      BOOTSTRAP:
+    name: "bootstrap_kerbside"
+    restart_policy: oneshot
+    volumes: "{{ kerbside_services['kerbside_proxy']['volumes'] | reject('equalto', '') | list }}"
+  run_once: True
+  delegate_to: "{{ groups['kerbside-proxy'][0] }}"
