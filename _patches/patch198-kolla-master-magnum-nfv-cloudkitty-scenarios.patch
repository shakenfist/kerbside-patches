diff --git a/zuul.d/scenarios/cloudkitty.yaml b/zuul.d/scenarios/cloudkitty.yaml
new file mode 100644
index 000000000..628eaaeea
--- /dev/null
+++ b/zuul.d/scenarios/cloudkitty.yaml
@@ -0,0 +1,11 @@
+---
+- project-template:
+    name: kolla-scenario-cloudkitty
+    description: |
+      Runs Kolla-Ansible CloudKitty scenario jobs on particular Kolla changes.
+    check:
+      jobs:
+        - kolla-ansible-debian-trixie-cloudkitty: &files
+            files: ^kolla/docker/(base|cloudkitty|openstack-base)/
+        - kolla-ansible-rocky-10-cloudkitty: *files
+        - kolla-ansible-ubuntu-noble-cloudkitty: *files
