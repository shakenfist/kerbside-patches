+# An all-in-one inventory for running Kolla Ansible from a container on the
+# host it deploys to, such as the kolla-ansible deployer image. The container
+# needs the host's PID namespace and privileges to enter the host's
+# namespaces. community.docker.nsenter then runs each task on the host, so no
+# SSH is needed.
+#
+# The deploy host must not be named localhost. Kolla Ansible runs some tasks
+# with delegate_to: localhost and connection: local, using paths that exist
+# only in the container. A host named localhost here would replace Ansible's
+# implicit localhost, and its ansible_connection would send those tasks to the
+# host instead.
+#
+# The nsenter plugin assumes that remote_user is root, and it passes the
+# container's environment, including HOME, to commands on the host. A relative
+# remote_tmp such as the default ~/.ansible/tmp would therefore name a path in
+# the container's HOME, which the host may not have, so ansible_remote_tmp is
+# absolute. If more than one user deploys from this host, give each their own
+# directory.
+[all:vars]
+ansible_connection=community.docker.nsenter
+ansible_remote_tmp=/tmp/.ansible-kolla
+
