#!/bin/bash -e

. ./_build/common.sh

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}List compute services${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"
openstack compute service list --long

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Download test image and setup glance${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

if [ ! -e /srv/shakenfist/uefi-latency-guest.qcow2 ]; then
    echo
    echo "Downloading test image..."
    mkdir -p /srv/shakenfist
    wget -q https://images.shakenfist.com/testimages/uefi-latency-guest.qcow2 \
        -O /srv/shakenfist/uefi-latency-guest.qcow2
else
    echo
    echo "Image already present"
fi

if [ $(openstack image list | grep -c uefi-latency-guest || true) -lt 1 ]; then
    echo "Pushing test image to glance..."
    openstack image create --public --disk-format qcow2 \
        --container-format bare \
        --file /srv/shakenfist/uefi-latency-guest.qcow2 uefi-latency-guest
else
    echo "Image already in glance"
fi

echo
imageid=$(openstack image list -f json | \
    jq -e -r ".[] | select(.Name == \"uefi-latency-guest\") | .ID")
echo "... image id is ${imageid}"

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Setup image${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

openstack image set --property hw_video_ram=64 ${imageid}
openstack image set --property hw_firmware_type=uefi ${imageid}
openstack image set --property hw_sound_model=usb ${imageid}
openstack image set --property hw_usb_model=qemu-xhci ${imageid}

openstack image show ${imageid}

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Setup flavor${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

openstack flavor create vdi --ram 4096 --disk 200 --vcpus 4 \
    --property hw_video:ram_max_mb=64

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Start test instance${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

instancename="test-$$"
openstack server create --flavor vdi --image ${imageid} \
    --network public1 ${instancename}

start=$(date +"%s")
now=$(date +"%s")
while [ $(( ${now} - ${start} )) -lt 300 ]; do
    status=$(openstack server show ${instancename} -f json | \
             jq -e -r ".status")
    if [ ${status} == 'ACTIVE' ]; then
        break
    fi
    if [ ${status} == 'ERROR' ]; then
        echo "... instance is in error status"
        echo
        openstack server show ${instancename}
        exit 1
    fi
    echo "... instance status is ${status}"

    sleep 10
    now=$(date +"%s")
done

echo
echo "... instance status is ${status}"

if [ ${status} != 'ACTIVE' ]; then
    echo "... instance never became active"
    exit 1
fi

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Dump instance information${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

openstack server show ${instancename} -f json | jq . -e -r 2> /dev/null

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Determine location of the compute node${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

hypervisor=$(openstack server show ${instancename} -f json \
             | jq -e -r '."OS-EXT-SRV-ATTR:hypervisor_hostname"')
echo "Instance is on ${hypervisor}, we are "$(hostname)

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}List libvirt domains${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

/srv/shakenfist/actions/tools/run_remote ${hypervisor} sudo docker exec nova_libvirt virsh list

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Dump libvirt domain XML for instance${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"


/srv/shakenfist/actions/tools/run_remote ${hypervisor} sudo docker exec nova_libvirt virsh dumpxml 1

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Make assertions about the domain XML${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

/srv/shakenfist/actions/tools/run_remote ${hypervisor} sudo docker exec nova_libvirt virsh dumpxml 1 > /tmp/domain.xml
if [ $(grep -c "graphics type='spice'" /tmp/domain.xml || true) -lt 1 ]; then
    echo "...graphics type='spice' missing from domain XML"
    exit 1
fi
if [ $(grep -c "sound model" /tmp/domain.xml || true) -lt 1 ]; then
    echo "...sound model missing from domain XML"
    exit 1
fi
if [ $(grep -c "controller type='usb'" /tmp/domain.xml || true) -lt 1 ]; then
    echo "...controller type='usb' missing from domain XML"
    exit 1
fi

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Create console${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

consoleurl=$(openstack console url show ${instancename} \
    --spice-direct -f json | jq -e -r ".url")
consoletoken=$(echo ${consoleurl} | sed 's/.*token=//')

echo
echo "... console url is ${consoleurl}"
echo "... console token is ${consoletoken}"

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Dump an attempt to lookup the console with debug on${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

openstack --debug console connection show ${consoletoken}

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Lookup console connection details${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

connjson=$(openstack console connection show ${consoletoken} -f json)
connhost=$(echo ${connjson} | jq -e -r ".host")
connport=$(echo ${connjson} | jq -e -r ".port")

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Attempt a direct connection to the hypervisor${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

echo
echo "... connection is ${connhost}:${connport}, attempting..."
timeout 5 python3 ${topdir}/tools/spice-connect.py ${connhost} ${connport}

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Attempt to fetch a .vv file from Kerbside${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

curl --cacert /tmp/kolla-ca.pem --output /tmp/console.vv ${consoleurl}

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Dump .vv file${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

if [ ! -e /tmp/console.vv ]; then
    echo "Console file missing!"
    exit 1
fi

echo
cat /tmp/console.vv
echo

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Verify the .vv file contents are believable${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

if [ $(egrep -c "^type=spice" /tmp/console.vv || true) -lt 1 ]; then
    echo "Console file is not of type=spice!"
    exit 1
fi

if [ $(egrep -c "^host=" /tmp/console.vv || true) -lt 1 ]; then
    echo "Console file does not specify a host!"
    exit 1
fi

if [ $(egrep -c "^port=" /tmp/console.vv || true) -lt 1 ]; then
    echo "Console file does not specify a port!"
    exit 1
fi

if [ $(egrep -c "^password=" /tmp/console.vv || true) -lt 1 ]; then
    echo "Console file does not specify a password!"
    exit 1
fi

if [ $(egrep -c "^ca=" /tmp/console.vv || true) -lt 1 ]; then
    echo "Console file does not specify a CA certificate!"
    exit 1
fi

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Attempt a proxied connection to the hypervisor${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

# NOTE(mikal): this is really only checking the _proxy_ insecure port answers
# right now, because I need to add support to passwords to spice-connect.py
# before we can actually check the entire way through to the instance.
proxyconnhost=$(egrep "^host=" /tmp/console.vv | cut -f 2 -d "=")
proxyconnport=$(egrep "^port=" /tmp/console.vv | cut -f 2 -d "=")

echo
echo "... connection is ${proxyconnhost}:${proxyconnport}, attempting..."
timeout 5 python3 ${topdir}/tools/spice-connect.py ${proxyconnhost} ${proxyconnport}

trap - EXIT

echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}OpenStack console test complete.${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"
