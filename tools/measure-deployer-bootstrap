@cli.command()
@click.option('--since', default=None, help='Runs created at or after this date.')
@click.option('--until', default=None, help='Runs created before this date.')
@click.option('--run', 'runs', type=int, multiple=True, help='Only these run ids (instead of --since).')
@click.option('--attempt', type=int, default=None, help='Only this attempt of each run.')
@click.option('--logs-dir', type=click.Path(exists=True, file_okay=False), default=None,
              help='Read already downloaded job logs from here instead of GitHub. Needs no network.')
@click.option('--json', 'as_json', is_flag=True, help='Print JSON instead of a table.')
@click.pass_obj
def timings(obj, since, until, runs, attempt, logs_dir, as_json):
    """Compare each launcher entry's bootstrap with its venv control's."""
    collected = {}

    def add(pairs):
        for name, launcher_values, control_values in pairs:
            launcher, control = collected.setdefault(name, ([], []))
            launcher.append(launcher_values)
            control.append(control_values)

    if logs_dir:
        add(offline_pairs(read_logs_dir(logs_dir)))
    else:
        if not since and not runs:
            raise click.UsageError('give --since or --run')
        for run in list_runs(obj['repo'], obj['workflow'], parse_when(since or '2000-01-01'),
                             parse_when(until) if until else None, runs):
            seen = set()
            for number in list_attempts(run, attempt):
                listed = list_jobs(obj['repo'], run['id'], number)
                jobs = dict((job['name'], job) for job in listed)
                if not any(is_launcher(name) for name in jobs):
                    continue
                if not attempt_complete(listed):
                    note('run %s attempt %s: not completed, skipped' % (run['id'], number))
                    continue
                try:
                    logs = download_logs(obj['repo'], run['id'], number, obj['cache_dir'])
                except LogsExpired:
                    click.echo('run %s attempt %s: logs are unavailable' % (run['id'], number), err=True)
                    continue
                add(pair_timings(jobs, logs, seen))
    if not collected:
        raise ToolError('no launcher job with a control, both having run the %s step to success, was found'
                        % DEPLOY_STEP)
    if as_json:
        click.echo(json.dumps(dict((name, {'launcher': pairs[0], 'control': pairs[1]})
                                   for name, pairs in collected.items()), indent=2, sort_keys=True))
    else:
        click.echo(format_timings(collected))


@cli.command('galaxy-failures')
@click.option('--since', required=True, help='Runs created at or after this date.')
@click.option('--until', default=None, help='Runs created before this date.')
@click.option('--json', 'as_json', is_flag=True, help='Print JSON instead of text.')
@click.pass_obj
def galaxy_failures(obj, since, until, as_json):
    """Count venv jobs whose bootstrap failed to fetch Ansible collections."""
    examined = []
    not_reached = expired = 0
    oldest = None
    runs = list_runs(obj['repo'], obj['workflow'], parse_when(since), parse_when(until) if until else None)
    for run in runs:
        seen = set()
        for number in list_attempts(run):
            jobs = []
            for job in list_jobs(obj['repo'], run['id'], number):
                if step_named(job, DEPLOY_STEP) and not is_launcher(job['name']) and carried_key(job) not in seen:
                    seen.add(carried_key(job))
                    jobs.append(job)
            if not jobs:
                continue
            reached = [job for job in jobs if step_ran(job)]
            not_reached += len(jobs) - len(reached)
            if not reached:
                continue
            try:
                logs = download_logs(obj['repo'], run['id'], number, obj['cache_dir'])
            except LogsExpired:
                expired += len(reached)
                continue
            if oldest is None or run['created_at'] < oldest:
                oldest = run['created_at']
            for job in reached:
                view = LogView(job['name'], logs.get(job['name'], ''))
                if not view.reached:
                    continue
                found = view.galaxy()
                if not view.headers():
                    raise ToolError('%s (run %s attempt %s): ran the %s step, but its log has none of the expected '
                                    'bootstrap headers' % (job['name'], run['id'], number, DEPLOY_STEP))
                examined.append({'job': job['name'], 'run': run['id'], 'attempt': number,
                                 'branch': run.get('head_branch'), 'hard': found['hard'],
                                 'recovered': found['recovered']})
    hard = [item for item in examined if item['hard']]
    recovered = [item for item in examined if item['recovered'] and not item['hard']]
    summary = {'since': since, 'until': until, 'oldest_log_examined': oldest, 'venv_jobs_examined': len(examined),
               'not_reached': not_reached, 'logs_expired': expired, 'hard_failures': hard,
               'recovered_after_retries': recovered}
    if as_json:
        click.echo(json.dumps(summary, indent=2, sort_keys=True))
        return
    click.echo('Venv jobs whose bootstrap ran, in runs created since %s%s: %d' % (
        since, ' until ' + until if until else '', len(examined)))
    click.echo('Oldest run with a retained log: %s' % (oldest or 'none'))
    click.echo('Not counted: %d where the %s step never ran, %d whose logs are unavailable (expired, or the run '
               'is still going)' % (not_reached, DEPLOY_STEP, expired))
    click.echo('Galaxy failures that failed the job: %d' % len(hard))
    for item in hard:
        click.echo('  run %s attempt %s (%s) %s\n    %s'
                   % (item['run'], item['attempt'], item['branch'], item['job'], item['hard'][0]))
    click.echo('Jobs that hit a Galaxy failure and recovered by retrying: %d' % len(recovered))
    for item in recovered:
        click.echo('  run %s attempt %s (%s) %s\n    %s'
                   % (item['run'], item['attempt'], item['branch'], item['job'], item['recovered'][0]))


@cli.command()
@click.option('--since', required=True, help='Window start (runs created at or after).')
@click.option('--until', required=True, help='Window end.')
@click.option('--min-runs', type=int, default=5, show_default=True, help='Runs in which each entry passed.')
@click.option('--min-rebases', type=int, default=2, show_default=True,
              help='Daily-rebase runs among them.')
@click.pass_obj
def record(obj, since, until, min_runs, min_rebases):
    """Print whether the launcher entries have earned the right to vote.

    Every launcher job on any branch but deployer-phase-* in the window must
    pass, or fail for a reason that is not the launcher's: it failed in
    "Setup test environment", or its control failed the same step in the same
    attempt. A failure in any attempt of a run counts even if a rerun passed.
    A job carried over unchanged into a rerun is counted once. Each entry
    needs at least --min-runs runs in which it passed, at least --min-rebases
    of them daily rebases. Exits 1 when NOT MET.
    """
    runs = list_runs(obj['repo'], obj['workflow'], parse_when(since), parse_when(until))
    rows = collect_rows(obj['repo'], runs)
    click.echo('Window %s to %s: %d runs, %d launcher jobs (deployer-phase-* branches excluded)'
               % (since, until, len(runs), len(rows)))
    for row in sorted(rows, key=lambda r: (r['entry'], r['run'], r['attempt'])):
        click.echo('  %-9s run %s attempt %s %-28s %s\n            %s' % (
            row['verdict'], row['run'], row['attempt'], row['branch'], row['entry'], row['reason']))
    entries, met = evaluate_record(rows, min_runs, min_rebases)
    click.echo('')
    for entry in sorted(entries):
        counts = entries[entry]
        click.echo('%s\n  passing runs %d (need %d), of them daily rebases %d (need %d), failures %d' % (
            entry, counts['pass'], min_runs, counts['rebases'], min_rebases, counts['fail']))
    if not entries:
        click.echo('No launcher jobs in the window.')
    click.echo('MET' if met else 'NOT MET')
    sys.exit(0 if met else 1)


