#!/usr/bin/env python3
"""Measure bootstrap from "Build test clouds" CI job logs.

Phase 7 of docs/plans/containerised-deployer.md asks two questions of the
containerised deployer prototype entries: how long does bootstrap take with
and without run-time Ansible Galaxy fetches, and have the entries been
reliable enough to start voting. This tool answers both from the job logs
GitHub keeps, so the numbers quoted in the plan and upstream come with the
means of reproducing them.

Three subcommands:

    timings --since DATE     pairs each launcher entry with its venv control
                             in the same run and attempt, and prints median
                             and range of the "Deploy Kolla-Ansible" step, its
                             nine composite sub-steps and the sections of
                             tools/bootstrap-kolla-ansible, so that the time a
                             launcher saves in bootstrap can be followed to
                             where it is spent instead.
    galaxy-failures --since DATE
                             counts venv jobs whose bootstrap failed fetching
                             Ansible collections, and separately those that
                             hit a failure and recovered through
                             kolla-ansible's own retries.
    record --since D --until D
                             applies the rules for the launcher entries to
                             vote: prints every launcher job in the window
                             with a verdict, and MET or NOT MET.

Everything comes from the `gh` CLI. A log is `<ISO timestamp> <text>` per
line and may carry ANSI colour and a leading byte order mark. Section
headers are the coloured lines tools/bootstrap-kolla-ansible prints.
Sub-steps are the `##[start-action display=...]` and `##[end-action ...
duration_ms=...]` markers the runner writes around each step of the
deploy-kolla-ansible composite action.

DATE is YYYY-MM-DD or YYYY-MM-DDTHH:MMZ, in UTC.
"""

import datetime
import io
import json
import os
import re
import statistics
import subprocess
import sys
import time
import urllib.parse
import zipfile

import click

REPO = 'shakenfist/kerbside-patches'
WORKFLOW = 'functional-tests.yml'
DEPLOY_STEP = 'Deploy Kolla-Ansible'
SETUP_STEP = 'Setup test environment'
LAUNCHER_MARKER = ' with the containerised deployer'
PHASE_BRANCH_PREFIX = 'deployer-phase-'
REBASE_BRANCH_PREFIX = 'daily-rebase-'
DOWNLOAD_ATTEMPTS = 3

ANSI = re.compile(r'\x1b\[[0-9;]*m')
LINE = re.compile(r'^\ufeff?(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?Z ?(.*)$')
START_ACTION = re.compile(r'^##\[start-action display=(?P<display>[^;]*);id=(?P<id>[^\]]+)\]')
END_ACTION = re.compile(r'^##\[end-action id=(?P<id>[^;\]]+);(?P<rest>[^\]]*)\]')
DURATION = re.compile(r'duration_ms=(\d+)')
OUTCOME = re.compile(r'outcome=(\w+)')
DEPLOY_ACTION = re.compile(r'^##\[group\]Run shakenfist/actions/deploy-kolla-ansible')
UNPACKED = re.compile(r'^kolla-ansible: unpacked (\S+) with (docker|podman) into (\S+) in ([0-9.]+)s, '
                      r'(\d+ MiB|unknown size) \(du -sx\)$')
PULL_END = re.compile(r'^(Status: (Downloaded newer image|Image is up to date)|Writing manifest to image destination)')

# The nine sub-steps of the deploy-kolla-ansible composite action, by the
# display name the runner logs for them.
SUBSTEPS = [
    ('bootstrap', 'Bootstrap Kolla-Ansible'),
    ('prechecks', 'Run pre-checks'),
    ('pull', 'Pull images'),
    ('deploy', 'Deploy'),
    ('validate-config', 'Validate deployed config'),
    ('check', 'Check deployed services'),
    ('reconfigure', 'Reconfigure (idempotency check)'),
    ('install-clients', 'Install patched OpenStack clients'),
    ('post-install', 'Post install Kolla-Ansible setup'),
]
SUBSTEP_KEYS = dict((display, key) for key, display in SUBSTEPS)

# Sections of tools/bootstrap-kolla-ansible, each measured from its header to
# the next header. (key, which deployers print it, header pattern)
SECTIONS = [
    ('install-launcher', 'launcher', r'^Install the launcher into its own venv$'),
    ('install-engine', 'launcher', r'^Install a container engine if there is none$'),
    ('make-venv', 'venv', r'^Make venv$'),
    ('posix', 'venv', r'^Upgrade the POSIX ansible collection$'),
    ('install-patched', 'venv', r'^Install patched Kolla-Ansible$'),
    ('install-deps', 'venv', r'^Install Kolla-Ansible dependencies$'),
    ('certificates', 'both', r'^Make certificates$'),
    ('bootstrap-servers', 'both', r'^Bootstrap servers$'),
]
FIRST_HEADER = re.compile(r'^Bootstrap Kolla-Ansible into a venv$')
INVENTORY_HEADER = re.compile(r'^Bootstrap inventory for topology')
PIN_AS_ROOT = re.compile(r'^Pin .* as root$')
PIN_AS_USER = re.compile(r'^Give \S+ /etc/kolla and pin ')
END_HEADER = re.compile(r'^Kolla-Ansible bootstrapped\.$')
KNOWN_HEADERS = [FIRST_HEADER, INVENTORY_HEADER, PIN_AS_ROOT, PIN_AS_USER, END_HEADER] + [
    re.compile(pattern) for _, _, pattern in SECTIONS]

# What to report, in order: (key, label).
ROWS = [
    ('step', 'Deploy Kolla-Ansible step'),
    ('bootstrap', '  bootstrap sub-step'),
    ('to-inventory', '    first header to inventory'),
    ('install-launcher', '    install the launcher'),
    ('install-engine', '    install a container engine'),
    ('make-venv', '    make venv'),
    ('posix', '    upgrade ansible.posix'),
    ('install-patched', '    install patched Kolla-Ansible'),
