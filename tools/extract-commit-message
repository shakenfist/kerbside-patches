#!/usr/bin/python
import sys

from patch_message import extract

# The commit message parsing lives in patch_message.py so that
# tools/check-depends-on.py validates exactly the text this writes out.
message = extract(sys.argv[1])

outfile = f'{sys.argv[1]}-message'
print(f'Creating {outfile}')
with open(outfile, 'w') as f:
    f.write(message)
