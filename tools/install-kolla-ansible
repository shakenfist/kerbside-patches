#!/bin/bash -e

. /etc/os-release
. ./_build/common.sh
. /srv/kolla-ansible/venv/bin/activate

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Install Kolla-Ansible${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

echo -e "${H2}Pull images${Color_Off}"
kolla-ansible pull -i /etc/kolla/inventory
echo

echo -e "${H2}Run pre-checks${Color_Off}"
kolla-ansible prechecks -i /etc/kolla/inventory
echo

echo -e "${H2}Deploy servers${Color_Off}"
kolla-ansible deploy -i /etc/kolla/inventory
echo

trap - EXIT

echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Kolla-Ansible installed.${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"