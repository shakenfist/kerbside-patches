#!/bin/bash -e

. /etc/os-release
echo "Claimed OS name: ${NAME}"
if [ "${NAME}" == "Rocky Linux" ]; then
    TOPDIR="/home/cloud-user/kerbside-patches"

else
    TOPDIR="/home/debian/kerbside-patches"
fi

cd "${TOPDIR}"
. buildconfig.sh
. /srv/kolla-ansible/venv/bin/activate

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Install Kolla-Ansible${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

# This is in response to the rabbitmq pre-check being super thingie about
# exactly what result it gets back here. The API interface value must be the
# _first_ value returned.
echo -e "${H2}Log DNS result for target node${Color_Off}"
getent ahostsv4 kolla
echo

echo -e "${H2}Run pre-checks${Color_Off}"
kolla-ansible prechecks -i /etc/kolla/all-in-one
echo

echo -e "${H2}Deploy servers${Color_Off}"
kolla-ansible deploy -i /etc/kolla/all-in-one
echo

trap - EXIT

echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Kolla-Ansible installed.${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"