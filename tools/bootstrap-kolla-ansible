#!/bin/bash -e

. ./_build/common.sh
. /etc/os-release

target_release=${build_targets[0]}

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Bootstrap Kolla-Ansible into a venv${Color_Off}"
echo
echo -e "${H1}Arguments: ${*}${Color_Off}"
echo -e "${H1}python3: "$(which python3)"${Color_Off}"
echo -e "${H1}pip3: "$(which pip3)"${Color_Off}"
echo -e "${H1}Target release: ${target_release}${Color_Off}"
echo -e "${H1}Topology: ${topology}${Color_Off}"
echo -e "${H1}Registry token: ${registry_token}${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

echo -e "${H2}Log state of source${Color_Off}"
cd ${topsrcdir}
ls -lrth
echo

echo -e "${H2}Make venv for '${ID}' distro${Color_Off}"
if [ "${ID}" == "rocky" ]; then
    echo "Install missing Rocky dependencies."
    dnf install -y python3-libselinux libselinux-python3 wget curl
fi

python3 -mvenv --system-site-packages /srv/kolla-ansible/venv
. /srv/kolla-ansible/venv/bin/activate

echo -e "${H2}Log python binary locations${Color_Off}"
echo "pip3 ${Arrow} "$(which pip3)
echo "python3 ${Arrow} "$(which python3)
echo

echo -e "${H2}Log python version${Color_Off}"
python3 --version
echo

echo -e "${H2}Install dependencies${Color_Off}"
ansible_core=""
if [ "${target_release}" == "2024.1" ]; then
    ansible_core="ansible-core<2.17"
elif [ "${target_release}" == "2024.2" ]; then
    ansible_core="ansible-core>=2.15,<2.18"
elif [ "${target_release}" == "2025.1" ]; then
    ansible_core="ansible-core>=2.17,<2.19"
elif [ "${target_release}" == "2025.2" ]; then
    ansible_core="ansible-core>=2.17,<2.19"
else
    ansible_core="ansible-core>=2.19,<2.21"
fi
pip3 install -U ${ansible_core} ansible dbus-python selinux
echo

echo -e "${H2}Upgrade the POSIX ansible collection${Color_Off}"
ansible-galaxy collection install ansible.posix --upgrade
echo

echo -e "${H2}Install docker python libraries${Color_Off}"
pip3 install docker
echo

echo -e "${H2}Log state of source${Color_Off}"
cd ${topsrcdir}
ls -lrth
echo

echo -e "${H2}Install patched Kolla-Ansible${Color_Off}"
cd "${topsrcdir}/kolla-ansible"
pip3 install -e .
echo

echo -e "${H2}Install Kolla-Ansible dependencies${Color_Off}"
export PATH=$PATH:/usr/local/bin
kolla-ansible install-deps
echo

echo -e "${H2}Bootstrap inventory for topology ${topology} running ${target_release}${Color_Off}"
mkdir -p /etc/kolla
cp -r etc/kolla /etc/
cd "${topdir}"
if [ ! -e etc/inventory-${topology}-${target_release} ]; then
    echo "Looked for inventory etc/inventory-${topology}-${target_release}"
    echo "Inventory file missing!"
    exit 1
fi

cat etc/inventory-${topology}-${target_release} | \
        sed "s|USER|${SUDO_USER}|g" \
        > /etc/kolla/inventory
echo

echo -e "${H2}Copy globals.yml${Color_Off}"
cat etc/globals-${target_release}.yml | \
    sed "s/DOCKER_REGISTRY_TOKEN/${registry_token}/" | \
    sed "s/IMAGE_TAG/${image_tag}/" \
    > /etc/kolla/globals.yml
echo

sed -i "s/127.0.0.1 kolla.local kolla//" /etc/hosts
sed -i "s/127.0.0.1 localhost.localdomain localhost//" /etc/hosts
sed -i "s/::1 kolla.local kolla//" /etc/hosts

if [ "${topology}" != "all-in-one" ]; then
    sed -i "1s/^/10.0.2.2 deploy\n\n/" /etc/hosts
    sed -i "1s/^/10.0.2.10 control-1\n\n/" /etc/hosts
    sed -i "1s/^/10.0.2.11 control-2\n\n/" /etc/hosts
    sed -i "1s/^/10.0.2.20 compute-1\n\n/" /etc/hosts
    sed -i "1s/^/10.0.2.21 compute-2\n\n/" /etc/hosts
    sed -i "1s/^/10.0.2.30 kerbside-1\n\n/" /etc/hosts
    sed -i "1s/^/10.0.2.31 kerbside-2\n\n/" /etc/hosts
fi
echo

cloud_init_template=""
if [ -e /etc/cloud/templates/hosts.debian.tmpl ]; then
    cloud_init_template="/etc/cloud/templates/hosts.debian.tmpl"
fi
if [ -e /etc/cloud/templates/hosts.redhat.tmpl ]; then
    cloud_init_template="/etc/cloud/templates/hosts.redhat.tmpl"
fi

if [ ! -z "${cloud_init_template}" ]; then
    echo -e "${H2}Tweak /etc/hosts template for cloud-init${Color_Off}"
    sed -i "s/127.0.0.1 kolla.local kolla//" ${cloud_init_template}
    sed -i "s/127.0.0.1 localhost.localdomain localhost//" ${cloud_init_template}

    if [ "${topology}" != "all-in-one" ]; then
        sed -i "1s/^/10.0.2.2 deploy\n\n/" ${cloud_init_template}
        sed -i "1s/^/10.0.2.10 control-1\n\n/" ${cloud_init_template}
        sed -i "1s/^/10.0.2.11 control-2\n\n/" ${cloud_init_template}
        sed -i "1s/^/10.0.2.20 compute-1\n\n/" ${cloud_init_template}
        sed -i "1s/^/10.0.2.21 compute-2\n\n/" ${cloud_init_template}
        sed -i "1s/^/10.0.2.30 kerbside-1\n\n/" ${cloud_init_template}
        sed -i "1s/^/10.0.2.31 kerbside-2\n\n/" ${cloud_init_template}
    fi
    echo
fi

echo -e "${H2}Tweak hostname for single node deployments${Color_Off}"
if [ "${topology}" == "all-in-one" ]; then
    hostnamectl set-hostname kolla

    # Add kolla to /etc/hosts to ensure it's resolvable. This is required on
    # systems like Rocky Linux that don't have nss-myhostname enabled by
    # default (Debian has it, so the hostname is resolvable automatically).
    if ! getent ahostsv4 kolla > /dev/null 2>&1; then
        echo -e "${H2}Adding kolla to /etc/hosts for hostname resolution${Color_Off}"
        sed -i "1s/^/127.0.0.1 kolla\n\n/" /etc/hosts
    fi
fi

echo -e "${H2}Generate passwords${Color_Off}"
kolla-genpwd
echo

echo -e "${H2}Add docker registry password${Color_Off}"
echo "docker_registry_password: ${registry_token}" >> /etc/kolla/passwords.yml
echo

echo -e "${H2}Make certificates${Color_Off}"
kolla-ansible certificates -i /etc/kolla/inventory
echo

echo -e "${H2}Bootstrap servers${Color_Off}"
kolla-ansible bootstrap-servers -i /etc/kolla/inventory
echo

trap - EXIT

echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Kolla-Ansible bootstrapped.${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"
