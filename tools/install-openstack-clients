#!/bin/bash -e

. /etc/os-release
echo "Claimed OS name: ${NAME}"
if [ "${NAME}" == "Rocky Linux" ]; then
    TOPDIR="/home/cloud-user/kerbside-patches"
else
    TOPDIR="/home/debian/kerbside-patches"
fi

. "${TOPDIR}/buildconfig.sh"
. /srv/kolla-ansible/venv/bin/activate

echo
echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}Install OpenStack clients${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"

cd "${TOPDIR}/src"

for client in openstacksdk python-novaclient python-openstackclient; do
  cd ${client}

  echo -e "${H2}Installing ${client}${Color_Off}"
  pip3 install -e .
  echo

  for executable in $(pip3 show -f ${client} | grep "/bin/" | sed 's/.*\///'); do
    ln -s /srv/kolla-ansible/venv/bin/${executable} /usr/local/bin/
    echo "Linked /srv/kolla-ansible/venv/bin/${executable} ${Arrow} /usr/local/bin/"
  done
  echo

  cd ..
done

trap - EXIT

echo -e "${H1}==================================================${Color_Off}"
echo -e "${H1}OpenStack clients installed.${Color_Off}"
echo -e "${H1}==================================================${Color_Off}"