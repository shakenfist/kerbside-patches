[DEFAULT]
base = debian
debug = true
push = false

[openstack-base]
type = local
location = TOPSRCDIR/requirements

[kerbside-plugin-openstacksdk]
type = local
location = TOPSRCDIR/openstacksdk
reference = master

[kerbside-base]
type = local
location = TOPSRCDIR/kerbside

[nova-base]
type = local
location = TOPSRCDIR/nova

[nova-plugin-os-traits]
type = local
location = TOPSRCDIR/os-traits