From 5ce7b49c6b0e4d4800da49f1dc9adb75cead2061 Mon Sep 17 00:00:00 2001
From: Michael Still <mikal@stillhq.com>
Date: Fri, 30 Oct 2026 08:45:50 +1100
Subject: [PATCH 2/3] gstreamer-encoder: fall back to software when a hardware
 encoder fails

Finding a hardware encoding plugin in the GStreamer registry does not
mean it works. The registry keeps listing a plugin's elements when the
device they were registered for has gone, or cannot be opened from
where the server runs. The pipeline then fails to build, if the element
cannot be created, or to start. Today the first makes
gstreamer_encoder_new() fail, so the stream falls back to another
codec, and the second fails each frame until, after three failures, the
stream stops encoding and sends its frames as images. So:

- probe each element by creating it and taking it to the READY state,
  which opens its device, and remember the result for each codec, so
  that the GPU check and the probe run once per codec rather than for
  every pipeline;
- if a pipeline with a hardware encoder cannot be built or started, or
  fails to encode a frame, rebuild it with the software encoder rather
  than counting an error;
- use the software encoder for a frame size the hardware encoder does
  not take. radeonsi's vah264enc takes nothing smaller than 128x128,
  and vapostproc would scale a smaller frame up to fit, so the client
  would get frames of the wrong size. qemu's non-GL display path makes
  streams as narrow as 32 pixels.

Hardware encoding is still tried only where udev finds an Intel GPU.
These paths were tested on an AMD GPU with the next patch applied.
With a render node that could not be opened and a GStreamer registry
that still listed the va elements, the probe rejected them and the
stream was encoded by x264enc. Streams 32 pixels wide were encoded by
x264enc, and 640x480 streams by vah264enc.

Assisted-by: Claude Opus 5.5
---
 server/gstreamer-encoder.c | 219 ++++++++++++++++++++++++++++++-------
 1 file changed, 178 insertions(+), 41 deletions(-)

diff --git a/server/gstreamer-encoder.c b/server/gstreamer-encoder.c
index 328a36ff..65323e64 100644
--- a/server/gstreamer-encoder.c
+++ b/server/gstreamer-encoder.c
@@ -128,6 +128,14 @@ typedef struct SpiceGstEncoder {
     GstElement *gstenc;
     GParamSpec *gstenc_bitrate_param;
 
+    /* True if the pipeline uses a hardware encoder. */
+    gboolean hw_pipeline;
+
+    /* True once a hardware pipeline has failed, or cannot take this video's
+     * frame size, so that only software pipelines are built from then on.
+     */
+    gboolean hw_disabled;
+
     /* True if the encoder's bitrate can be modified while playing. */
     gboolean gstenc_bitrate_is_dynamic;
 
@@ -958,6 +966,26 @@ static bool gst_features_lookup(const gchar *feature_name)
     return true;
 }
 
+/* Returns true if an element can be created from the feature and can open its
+ * device. A plugin's elements stay in the registry when the device they were
+ * registered for cannot be opened, for instance because the registry was built
+ * where the device was visible. Elements open their device when they go from
+ * the NULL to the READY state.
+ */
+static bool gst_element_usable(const gchar *feature_name)
+{
+    GstElement *element = gst_element_factory_make(feature_name, NULL);
+    if (!element) {
+        return false;
+    }
+    gst_object_ref_sink(element);
+
+    bool usable = gst_element_set_state(element, GST_STATE_READY) != GST_STATE_CHANGE_FAILURE;
+    gst_element_set_state(element, GST_STATE_NULL);
+    gst_object_unref(element);
+    return usable;
+}
+
 static gchar *find_best_hw_plugin(const gchar *codec_name)
 {
     static const char plugins[][8] = {"msdk", "va", "vaapi"};
@@ -967,7 +995,7 @@ static gchar *find_best_hw_plugin(const gchar *codec_name)
     for (i = 0; i < G_N_ELEMENTS(plugins); i++) {
         feature_name = !codec_name ? g_strconcat(plugins[i], "postproc", NULL) :
                        g_strconcat(plugins[i], codec_name, "enc", NULL);
-        if (!gst_features_lookup(feature_name)) {
+        if (!gst_features_lookup(feature_name) || !gst_element_usable(feature_name)) {
             g_free(feature_name);
             feature_name = NULL;
             continue;
@@ -977,6 +1005,44 @@ static gchar *find_best_hw_plugin(const gchar *codec_name)
     return feature_name;
 }
 
+typedef struct {
+    bool probed;
+    /* NULL if there is no usable hardware encoder for the codec */
+    gchar *encoder;
+    gchar *vpp;
+} HwPlugins;
+
+/* Probes for a usable hardware encoder and converter once per codec, as
+ * probing opens the device.
+ */
+static const HwPlugins *get_hw_plugins(SpiceVideoCodecType codec_type)
+{
+    static GMutex lock;
+    static HwPlugins hw_plugins[G_N_ELEMENTS(video_codecs)];
+    const char *codec_name = video_codecs[codec_type];
+    HwPlugins *plugins = &hw_plugins[codec_type];
+
+    g_mutex_lock(&lock);
+    if (!plugins->probed) {
+        plugins->probed = true;
+        if (spice_udev_detect_gpu(INTEL_VENDOR_ID) == VENDOR_GPU_DETECTED) {
+            plugins->encoder = find_best_hw_plugin(codec_name);
+            plugins->vpp = plugins->encoder ? find_best_hw_plugin(NULL) : NULL;
+            if (!plugins->vpp) {
+                g_clear_pointer(&plugins->encoder, g_free);
+            }
+        }
+        if (plugins->encoder) {
+            spice_debug("hardware %s encoding: %s with %s", codec_name,
+                        plugins->encoder, plugins->vpp);
+        } else {
+            spice_debug("no usable hardware %s encoder", codec_name);
+        }
+    }
+    g_mutex_unlock(&lock);
+    return plugins;
+}
+
 static gchar *get_hw_gstenc_opts(const gchar *encoder, const gchar *codec_name)
 {
     gchar *gstenc_opts;
@@ -1007,37 +1073,59 @@ static gchar *get_hw_gstenc_opts(const gchar *encoder, const gchar *codec_name)
     return gstenc_opts;
 }
 
-static void try_intel_hw_plugins(const gchar *codec_name, gchar **converter,
+static bool try_intel_hw_plugins(SpiceVideoCodecType codec_type, gchar **converter,
                                  gchar **gstenc_name, gchar **gstenc_opts)
 {
-    gchar *encoder, *vpp;
+    const char *codec_name = video_codecs[codec_type];
 
     if (strcmp(codec_name, "vp8") == 0) {
-        return;
+        return false;
     }
 
-    encoder = find_best_hw_plugin(codec_name);
-    if (!encoder) {
-        return;
-    }
-    vpp = find_best_hw_plugin(NULL);
-    if (!vpp) {
-        g_free(encoder);
-        return;
+    const HwPlugins *plugins = get_hw_plugins(codec_type);
+    if (!plugins->encoder) {
+        return false;
     }
 
     g_free(*converter);
     g_free(*gstenc_name);
     g_free(*gstenc_opts);
-    *gstenc_name = encoder;
-    *gstenc_opts = get_hw_gstenc_opts(encoder, codec_name);
+    *gstenc_name = g_strdup(plugins->encoder);
+    *gstenc_opts = get_hw_gstenc_opts(plugins->encoder, codec_name);
 
-    if (g_str_has_prefix(vpp, "vaapi")) {
-        *converter = g_strconcat(vpp, " ! video/x-raw(memory:VASurface),format=NV12", NULL);
+    if (g_str_has_prefix(plugins->vpp, "vaapi")) {
+        *converter = g_strconcat(plugins->vpp, " ! video/x-raw(memory:VASurface),format=NV12", NULL);
     } else {
-        *converter = g_strconcat(vpp, " ! video/x-raw(memory:VAMemory),format=NV12", NULL);
+        *converter = g_strconcat(plugins->vpp, " ! video/x-raw(memory:VAMemory),format=NV12", NULL);
     }
-    g_free(vpp);
+    return true;
+}
+
+/* Hardware encoders take a narrower range of frame sizes than software ones:
+ * radeonsi's vah264enc takes nothing smaller than 128x128, for instance. The
+ * hardware converter in front of the encoder would scale a frame outside that
+ * range to fit, and the client would get frames of the wrong size.
+ */
+static gboolean gstenc_accepts_frame_size(const SpiceGstEncoder *encoder)
+{
+    GstPad *pad = gst_element_get_static_pad(encoder->gstenc, "sink");
+    if (!pad) {
+        return TRUE;
+    }
+    GstCaps *caps = gst_pad_get_pad_template_caps(pad);
+    gst_object_unref(pad);
+
+    GstStructure *frame = gst_structure_new("video/x-raw",
+                                            "width", G_TYPE_INT, (gint)encoder->width,
+                                            "height", G_TYPE_INT, (gint)encoder->height,
+                                            NULL);
+    gboolean accepts = gst_caps_is_any(caps);
+    for (guint i = 0; !accepts && i < gst_caps_get_size(caps); i++) {
+        accepts = gst_structure_can_intersect(gst_caps_get_structure(caps, i), frame);
+    }
+    gst_structure_free(frame);
+    gst_caps_unref(caps);
+    return accepts;
 }
 
 /* At this time, only the following formats are supported by x264enc. */
@@ -1077,7 +1165,7 @@ static gchar *get_gst_converter(void)
     return g_strdup(gst_once.retval);
 }
 
-static gboolean create_pipeline(SpiceGstEncoder *encoder)
+static gboolean create_pipeline_with(SpiceGstEncoder *encoder, bool try_hw)
 {
     gchar* gstenc_name = g_strdup(get_gst_codec_name(encoder));
     if (!gstenc_name) {
@@ -1131,12 +1219,8 @@ static gboolean create_pipeline(SpiceGstEncoder *encoder)
         return FALSE;
     }
 
-    const char *codec_name = video_codecs[encoder->base.codec_type];
-    GpuVendor vendor = spice_udev_detect_gpu(INTEL_VENDOR_ID);
-    if (vendor == VENDOR_GPU_DETECTED) {
-        try_intel_hw_plugins(codec_name, &converter, &gstenc_name,
-                             &gstenc_opts);
-    }
+    encoder->hw_pipeline = try_hw &&
+        try_intel_hw_plugins(encoder->base.codec_type, &converter, &gstenc_name, &gstenc_opts);
 
     GError *err = NULL;
     gchar *desc = g_strdup_printf("appsrc is-live=true format=time do-timestamp=true name=src !"
@@ -1195,6 +1279,29 @@ static gboolean create_pipeline(SpiceGstEncoder *encoder)
     return TRUE;
 }
 
+/* Stops using the hardware encoder for this video. The pipeline is freed so
+ * that the next frame builds a software one.
+ */
+static void disable_hw_pipeline(SpiceGstEncoder *encoder)
+{
+    free_pipeline(encoder);
+    encoder->hw_pipeline = FALSE;
+    encoder->hw_disabled = TRUE;
+}
+
+static gboolean create_pipeline(SpiceGstEncoder *encoder)
+{
+    if (create_pipeline_with(encoder, !encoder->hw_disabled)) {
+        return TRUE;
+    }
+    if (!encoder->hw_pipeline) {
+        return FALSE;
+    }
+    spice_warning("GStreamer: could not build a pipeline with a hardware encoder, using software");
+    disable_hw_pipeline(encoder);
+    return create_pipeline_with(encoder, false);
+}
+
 /* A helper for configure_pipeline() */
 static void set_gstenc_bitrate(SpiceGstEncoder *encoder)
 {
@@ -1254,8 +1361,8 @@ static void set_gstenc_bitrate(SpiceGstEncoder *encoder)
     spice_debug("setting the GStreamer %s to %" G_GUINT64_FORMAT, prop, gst_bit_rate);
 }
 
-/* A helper for spice_gst_encoder_encode_frame() */
-static gboolean configure_pipeline(SpiceGstEncoder *encoder)
+/* A helper for configure_pipeline() */
+static gboolean configure_and_start_pipeline(SpiceGstEncoder *encoder)
 {
     if (!encoder->pipeline && !create_pipeline(encoder)) {
         return FALSE;
@@ -1296,6 +1403,41 @@ static gboolean configure_pipeline(SpiceGstEncoder *encoder)
     return TRUE;
 }
 
+/* A helper for spice_gst_encoder_encode_frame() */
+static gboolean configure_pipeline(SpiceGstEncoder *encoder)
+{
+    if (configure_and_start_pipeline(encoder)) {
+        return TRUE;
+    }
+    if (!encoder->hw_pipeline) {
+        return FALSE;
+    }
+    /* The probe opened the device, but the pipeline can still fail to start,
+     * for instance if the device has gone away since.
+     */
+    spice_warning("GStreamer: could not start the hardware encoder, using software");
+    disable_hw_pipeline(encoder);
+    return configure_and_start_pipeline(encoder);
+}
+
+/* A helper for the encode functions, for when a frame could not be encoded.
+ * The input buffer will be stuck in the pipeline, preventing later ones from
+ * being processed. Furthermore something went wrong with this pipeline, so it
+ * may be safer to rebuild it from scratch. If it was a hardware pipeline,
+ * rebuild it with a software encoder rather than count an error, so that
+ * the video is not left without an encoder.
+ */
+static void handle_encode_failure(SpiceGstEncoder *encoder)
+{
+    if (encoder->hw_pipeline) {
+        spice_warning("GStreamer: the hardware encoder failed, using software");
+        disable_hw_pipeline(encoder);
+        return;
+    }
+    free_pipeline(encoder);
+    encoder->errors++;
+}
+
 /* A helper for the *_copy() functions */
 static int is_chunk_stride_aligned(const SpiceBitmap *bitmap, uint32_t index)
 {
@@ -1667,6 +1809,13 @@ spice_gst_encoder_configure_pipeline(SpiceGstEncoder *encoder,
         encoder->width = width;
         encoder->height = height;
 
+        if (encoder->pipeline && encoder->hw_pipeline &&
+            !gstenc_accepts_frame_size(encoder)) {
+            spice_debug("the hardware encoder does not take %ux%u frames, using software",
+                        width, height);
+            disable_hw_pipeline(encoder);
+        }
+
         if (encoder->bit_rate == 0) {
             encoder->history[0].mm_time = frame_mm_time;
             encoder->max_bit_rate = get_bit_rate_cap(encoder);
@@ -1738,13 +1887,7 @@ spice_gst_encoder_encode_frame(VideoEncoder *video_encoder,
     if (rc == VIDEO_ENCODER_FRAME_ENCODE_DONE) {
         rc = pull_compressed_buffer(encoder, outbuf);
         if (rc != VIDEO_ENCODER_FRAME_ENCODE_DONE) {
-            /* The input buffer will be stuck in the pipeline, preventing
-             * later ones from being processed. Furthermore something went
-             * wrong with this pipeline, so it may be safer to rebuild it
-             * from scratch.
-             */
-            free_pipeline(encoder);
-            encoder->errors++;
+            handle_encode_failure(encoder);
         }
     }
 
@@ -1836,13 +1979,7 @@ spice_gst_encoder_encode_dmabuf(VideoEncoder *video_encoder,
 
     rc = pull_compressed_buffer(encoder, outbuf);
     if (rc != VIDEO_ENCODER_FRAME_ENCODE_DONE) {
-        /* The input buffer will be stuck in the pipeline, preventing
-         * later ones from being processed. Furthermore something went
-         * wrong with this pipeline, so it may be safer to rebuild it
-         * from scratch.
-         */
-        free_pipeline(encoder);
-        encoder->errors++;
+        handle_encode_failure(encoder);
         return rc;
     }
 
