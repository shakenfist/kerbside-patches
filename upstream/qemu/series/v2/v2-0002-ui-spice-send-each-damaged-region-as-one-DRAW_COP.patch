+/*
+ * Turn damage into updates. The mirror diff shrinks each damage
+ * rectangle to the bounding box of the pixels that actually changed,
+ * splits it where SPICE_DISPLAY_SPLIT_ROWS rows did not change, and
+ * drops it if nothing did.
+ *
+ * Each resulting box is sent as a single DRAW_COPY rather than sliced
+ * into columns: the spice server's video stream detection looks for a
+ * run of same-sized DRAW_COPYs at the same position, and a guest that
+ * changes the same region every frame should produce exactly that.
+ */
 static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
 {
+    int bpp = surface_bytes_per_pixel(ssd->ds);
+    uint8_t *guest = surface_data(ssd->ds);
