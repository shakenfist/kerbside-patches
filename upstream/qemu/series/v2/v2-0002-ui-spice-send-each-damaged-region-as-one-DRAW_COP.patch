+/*
+ * Offset of the first byte that differs between @a and @b, or @len if
+ * none does. memcmp() is much faster than a byte loop at telling whether
+ * two buffers differ, so bisect with it before comparing bytes.
+ */
+static size_t first_diff(const uint8_t *a, const uint8_t *b, size_t len)
+{
+    size_t lo = 0, hi = len, mid;
+
+    if (memcmp(a, b, len) == 0) {
+        return len;
+    }
+    /* The first difference is in [lo, hi). */
+    while (hi - lo > 16) {
+        mid = lo + (hi - lo) / 2;
+        if (memcmp(a + lo, b + lo, mid - lo) != 0) {
+            hi = mid;
+        } else {
+            lo = mid;
+        }
+    }
+    while (a[lo] == b[lo]) {
+        lo++;
+    }
+    return lo;
+}
+
+/* One past the last byte that differs between @a and @b, or 0. */
+static size_t last_diff_end(const uint8_t *a, const uint8_t *b, size_t len)
+{
+    size_t lo = 0, hi = len, mid;
+
+    if (memcmp(a, b, len) == 0) {
+        return 0;
+    }
+    /* The last difference is in [lo, hi). */
+    while (hi - lo > 16) {
+        mid = lo + (hi - lo) / 2;
+        if (memcmp(a + mid, b + mid, hi - mid) != 0) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    while (a[hi - 1] == b[hi - 1]) {
+        hi--;
+    }
+    return hi;
+}
+
+void simple_spice_damage_diff(const SimpleSpiceRect *rect, int bpp,
+                              const uint8_t *a, size_t a_stride,
+                              const uint8_t *b, size_t b_stride,
+                              int split_rows,
+                              SimpleSpiceRectFunc func, void *opaque)
+{
+    SimpleSpiceRect box = { .top = -1 };
+    size_t len = (size_t)(rect->right - rect->left) * bpp;
+    size_t lw, mw, rw, off;
+    bool changed;
+    int y;
+
+    if (rect->right <= rect->left) {
+        return;
+    }
+
+    for (y = rect->top; y < rect->bottom; y++) {
+        const uint8_t *ra = a + y * a_stride + (size_t)rect->left * bpp;
+        const uint8_t *rb = b + y * b_stride + (size_t)rect->left * bpp;
+
+        if (box.top != -1 && y - box.bottom >= split_rows) {
+            /* Nothing further down can join this box any more. */
+            func(opaque, &box);
+            box.top = -1;
+        }
+
+        if (box.top == -1) {
+            off = first_diff(ra, rb, len);
+            if (off == len) {
+                continue;
+            }
+            box.top = y;
+            box.bottom = y + 1;
+            box.left = rect->left + off / bpp;
+            off = (size_t)(box.left - rect->left) * bpp;
+            box.right = box.left +
+                DIV_ROUND_UP(last_diff_end(ra + off, rb + off, len - off),
+                             bpp);
+            continue;
+        }
+
+        /*
+         * Split the row into the parts left of, inside and right of the
+         * box. Only changes outside the box can widen it, and the inside
+         * only needs checking if nothing outside changed, so every byte
+         * of the row is compared at most once or twice.
+         */
+        lw = (size_t)(box.left - rect->left) * bpp;
+        mw = (size_t)(box.right - box.left) * bpp;
+        rw = len - lw - mw;
+        changed = false;
+
+        off = first_diff(ra, rb, lw);
+        if (off < lw) {
+            box.left = rect->left + off / bpp;
+            changed = true;
+        }
+        off = last_diff_end(ra + lw + mw, rb + lw + mw, rw);
+        if (off) {
+            box.right += DIV_ROUND_UP(off, bpp);
+            changed = true;
+        }
+        if (changed || memcmp(ra + lw, rb + lw, mw) != 0) {
+            box.bottom = y + 1;
+        }
+    }
+
+    if (box.top != -1) {
+        func(opaque, &box);
+    }
+}
