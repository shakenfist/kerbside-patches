diff --git a/include/ui/spice-damage.h b/include/ui/spice-damage.h
index 5550de06a9..e52f83b6dd 100644
--- a/include/ui/spice-damage.h
+++ b/include/ui/spice-damage.h
@@ -53,4 +53,22 @@ static inline bool simple_spice_damage_is_empty(const SimpleSpiceDamage *d)
 void simple_spice_damage_add(SimpleSpiceDamage *damage,
                              int x, int y, int w, int h);
 
+typedef void (*SimpleSpiceRectFunc)(void *opaque, const SimpleSpiceRect *r);
+
+/*
+ * Compare the pixels inside @rect of two images with the same geometry,
+ * @a and @b, and call @func for each box of changed pixels. Each box is
+ * the bounding box of the changes in a band of rows; a new band starts
+ * when at least @split_rows unchanged rows separate two changes. Nothing
+ * is reported if the images are identical inside @rect.
+ *
+ * @a and @b point at pixel (0, 0) of their image; @bpp is the number of
+ * bytes per pixel and @a_stride and @b_stride the bytes per row.
+ */
+void simple_spice_damage_diff(const SimpleSpiceRect *rect, int bpp,
+                              const uint8_t *a, size_t a_stride,
+                              const uint8_t *b, size_t b_stride,
+                              int split_rows,
+                              SimpleSpiceRectFunc func, void *opaque);
+
 #endif /* UI_SPICE_DAMAGE_H */
diff --git a/tests/unit/test-spice-damage.c b/tests/unit/test-spice-damage.c
index 276d354872..46a168e3f6 100644
--- a/tests/unit/test-spice-damage.c
+++ b/tests/unit/test-spice-damage.c
@@ -187,6 +187,195 @@ static void test_add_random(void)
     g_rand_free(rand);
 }
 
+/* diff tests */
+
+#define W 300
+#define H 200
+
+typedef struct Boxes {
+    SimpleSpiceRect box[H];
+    int num;
+} Boxes;
+
+static void collect(void *opaque, const SimpleSpiceRect *r)
+{
+    Boxes *boxes = opaque;
+
+    g_assert_cmpint(boxes->num, <, H);
+    boxes->box[boxes->num++] = *r;
+}
+
+static void diff(const SimpleSpiceRect *rect, int bpp,
+                 const uint8_t *a, const uint8_t *b, int split, Boxes *out)
+{
+    out->num = 0;
+    simple_spice_damage_diff(rect, bpp, a, W * bpp, b, W * bpp, split,
+                             collect, out);
+}
+
+static void set_pixel(uint8_t *buf, int bpp, int x, int y)
+{
+    /* Change only the last byte of the pixel. */
+    buf[(y * W + x) * bpp + bpp - 1] ^= 0xff;
+}
+
+static void test_diff_basic(void)
+{
+    static const int bpps[] = { 1, 2, 3, 4 };
+    SimpleSpiceRect all = { .left = 0, .top = 0, .right = W, .bottom = H };
+    Boxes boxes;
+    int k;
+
+    for (k = 0; k < ARRAY_SIZE(bpps); k++) {
+        int bpp = bpps[k];
+        g_autofree uint8_t *a = g_malloc0(W * H * bpp);
+        g_autofree uint8_t *b = g_malloc0(W * H * bpp);
+
+        /* Identical */
+        diff(&all, bpp, a, b, 32, &boxes);
+        g_assert_cmpint(boxes.num, ==, 0);
+
+        /* One pixel, at each corner and in the middle */
+        set_pixel(a, bpp, 0, 0);
+        diff(&all, bpp, a, b, 32, &boxes);
+        g_assert_cmpint(boxes.num, ==, 1);
+        g_assert_true(rect_eq(&boxes.box[0], 0, 0, 1, 1));
+        set_pixel(a, bpp, 0, 0);
+
+        set_pixel(a, bpp, W - 1, H - 1);
+        diff(&all, bpp, a, b, 32, &boxes);
+        g_assert_cmpint(boxes.num, ==, 1);
+        g_assert_true(rect_eq(&boxes.box[0], W - 1, H - 1, W, H));
+        set_pixel(a, bpp, W - 1, H - 1);
+
+        set_pixel(a, bpp, 150, 100);
+        diff(&all, bpp, a, b, 32, &boxes);
+        g_assert_cmpint(boxes.num, ==, 1);
+        g_assert_true(rect_eq(&boxes.box[0], 150, 100, 151, 101));
+
+        /* A second change 10 rows below widens the same box. */
+        set_pixel(a, bpp, 20, 110);
+        set_pixel(a, bpp, 280, 111);
+        diff(&all, bpp, a, b, 32, &boxes);
+        g_assert_cmpint(boxes.num, ==, 1);
+        g_assert_true(rect_eq(&boxes.box[0], 20, 100, 281, 112));
+
+        /* A change 32 unchanged rows further down starts a new box. */
+        set_pixel(a, bpp, 40, 144);
+        diff(&all, bpp, a, b, 32, &boxes);
+        g_assert_cmpint(boxes.num, ==, 2);
+        g_assert_true(rect_eq(&boxes.box[0], 20, 100, 281, 112));
+        g_assert_true(rect_eq(&boxes.box[1], 40, 144, 41, 145));
+
+        /* ...but not with a larger split threshold. */
+        diff(&all, bpp, a, b, 33, &boxes);
+        g_assert_cmpint(boxes.num, ==, 1);
+        g_assert_true(rect_eq(&boxes.box[0], 20, 100, 281, 145));
+    }
+}
+
+static void test_diff_clip(void)
+{
+    const int bpp = 4;
+    g_autofree uint8_t *a = g_malloc0(W * H * bpp);
+    g_autofree uint8_t *b = g_malloc0(W * H * bpp);
+    SimpleSpiceRect rect = { .left = 50, .top = 50, .right = 100,
+                             .bottom = 100 };
+    SimpleSpiceRect empty = { .left = 50, .top = 50, .right = 50,
+                              .bottom = 100 };
+    Boxes boxes;
+
+    /* Changes outside the rectangle are not reported. */
+    set_pixel(a, bpp, 49, 60);
+    set_pixel(a, bpp, 100, 60);
+    set_pixel(a, bpp, 60, 49);
+    set_pixel(a, bpp, 60, 100);
+    diff(&rect, bpp, a, b, 32, &boxes);
+    g_assert_cmpint(boxes.num, ==, 0);
+
+    set_pixel(a, bpp, 50, 50);
+    set_pixel(a, bpp, 99, 99);
+    diff(&rect, bpp, a, b, 64, &boxes);
+    g_assert_cmpint(boxes.num, ==, 1);
+    g_assert_true(rect_eq(&boxes.box[0], 50, 50, 100, 100));
+
+    diff(&empty, bpp, a, b, 32, &boxes);
+    g_assert_cmpint(boxes.num, ==, 0);
+}
+
+/*
+ * Straightforward per-pixel implementation of the same contract, to
+ * check the optimised one against.
+ */
+static void diff_reference(const SimpleSpiceRect *rect, int bpp,
+                           const uint8_t *a, const uint8_t *b, int split,
+                           Boxes *out)
+{
+    SimpleSpiceRect box = { .top = -1 };
+    int x, y;
+
+    out->num = 0;
+    for (y = rect->top; y < rect->bottom; y++) {
+        for (x = rect->left; x < rect->right; x++) {
+            size_t off = (y * W + x) * bpp;
+
+            if (memcmp(a + off, b + off, bpp) == 0) {
+                continue;
+            }
+            if (box.top != -1 && y - box.bottom >= split) {
+                collect(out, &box);
+                box.top = -1;
+            }
+            if (box.top == -1) {
+                box = (SimpleSpiceRect) {
+                    .top = y, .left = x, .bottom = y + 1, .right = x + 1,
+                };
+            }
+            box.bottom = y + 1;
+            box.left = MIN(box.left, x);
+            box.right = MAX(box.right, x + 1);
+        }
+    }
+    if (box.top != -1) {
+        collect(out, &box);
+    }
+}
+
+static void test_diff_random(void)
+{
+    GRand *rand = g_rand_new_with_seed(2);
+    Boxes got, want;
+    int iter, i, n;
+
+    for (iter = 0; iter < 500; iter++) {
+        int bpp = g_rand_int_range(rand, 1, 5);
+        int split = g_rand_int_range(rand, 1, 40);
+        g_autofree uint8_t *a = g_malloc0(W * H * bpp);
+        g_autofree uint8_t *b = g_malloc0(W * H * bpp);
+        SimpleSpiceRect rect;
+
+        rect.left = g_rand_int_range(rand, 0, W);
+        rect.right = g_rand_int_range(rand, rect.left, W + 1);
+        rect.top = g_rand_int_range(rand, 0, H);
+        rect.bottom = g_rand_int_range(rand, rect.top, H + 1);
+
+        n = g_rand_int_range(rand, 0, 40);
+        for (i = 0; i < n; i++) {
+            a[g_rand_int_range(rand, 0, W * H * bpp)] ^= 1;
+        }
+
+        diff(&rect, bpp, a, b, split, &got);
+        diff_reference(&rect, bpp, a, b, split, &want);
+        g_assert_cmpint(got.num, ==, want.num);
+        for (i = 0; i < got.num; i++) {
+            g_assert_true(rect_eq(&got.box[i], want.box[i].left,
+                                  want.box[i].top, want.box[i].right,
+                                  want.box[i].bottom));
+        }
+    }
+    g_rand_free(rand);
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -199,6 +388,9 @@ int main(int argc, char **argv)
     g_test_add_func("/spice-damage/add/cascade", test_add_cascade);
     g_test_add_func("/spice-damage/add/overflow", test_add_overflow);
     g_test_add_func("/spice-damage/add/random", test_add_random);
+    g_test_add_func("/spice-damage/diff/basic", test_diff_basic);
+    g_test_add_func("/spice-damage/diff/clip", test_diff_clip);
+    g_test_add_func("/spice-damage/diff/random", test_diff_random);
 
     return g_test_run();
 }
