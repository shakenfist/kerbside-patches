+typedef struct DiffState {
+    int bpp;
+    const uint8_t *a;
+    const uint8_t *b;
+    size_t a_stride;
+    size_t b_stride;
+    int split_rows;
+    int split_cols;
+    SimpleSpiceRectFunc func;
+    void *opaque;
+} DiffState;
+
+static void diff_rect(const DiffState *s, const SimpleSpiceRect *rect);
+
+/* True if @col has a run of at least @n zeroes. */
+static bool has_gap(const uint8_t *col, int w, int n)
+{
+    int x, run = 0;
+
+    for (x = 0; x < w; x++) {
+        run = col[x] ? 0 : run + 1;
+        if (run >= n) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/*
+ * Report @box, the bounding box of the changes in a band of rows, after
+ * splitting it where at least split_cols whole columns did not change:
+ * side by side changes, such as a video and a clock on the same rows,
+ * would otherwise be reported as one box spanning both.
+ */
+static void emit_box(const DiffState *s, const SimpleSpiceRect *box)
+{
+    int w = box->right - box->left;
+    g_autofree uint8_t *col = NULL;
+    int x, y, start, end, run;
+
+    /* Too narrow to hold a gap between two changes. */
+    if (s->split_cols <= 0 || w < s->split_cols + 2) {
+        s->func(s->opaque, box);
+        return;
+    }
+
+    col = g_malloc0(w);
+    for (y = box->top; y < box->bottom; y++) {
+        const uint8_t *ra = s->a + y * s->a_stride + (size_t)box->left * s->bpp;
+        const uint8_t *rb = s->b + y * s->b_stride + (size_t)box->left * s->bpp;
+
+        if (s->bpp == 4) {
+            for (x = 0; x < w; x++) {
+                uint32_t pa, pb;
+
+                memcpy(&pa, ra + x * 4, 4);
+                memcpy(&pb, rb + x * 4, 4);
+                col[x] |= pa != pb;
+            }
+        } else {
+            for (x = 0; x < w; x++) {
+                col[x] |= memcmp(ra + x * s->bpp, rb + x * s->bpp, s->bpp) != 0;
+            }
+        }
+        /* Stop early once no gap is left, e.g. when everything changed. */
+        if ((y - box->top) % 16 == 0 && !has_gap(col, w, s->split_cols)) {
+            s->func(s->opaque, box);
+            return;
+        }
+    }
+
+    if (!has_gap(col, w, s->split_cols)) {
+        s->func(s->opaque, box);
+        return;
+    }
+
+    /*
+     * The outermost columns of @box always changed, so the gap is inside
+     * it. Diff each run of changed columns again on its own: it may cover
+     * fewer rows than the whole band.
+     */
+    x = 0;
+    while (x < w) {
+        while (x < w && !col[x]) {
+            x++;
+        }
+        if (x == w) {
+            break;
+        }
+        start = x;
+        end = x + 1;
+        for (run = 0; x < w && run < s->split_cols; x++) {
+            if (col[x]) {
+                end = x + 1;
+                run = 0;
+            } else {
+                run++;
+            }
+        }
+        diff_rect(s, &(SimpleSpiceRect) {
+            .top = box->top,
+            .left = box->left + start,
+            .bottom = box->bottom,
+            .right = box->left + end,
+        });
+    }
+}
+
+static void diff_rect(const DiffState *s, const SimpleSpiceRect *rect)
 {
     SimpleSpiceRect box = { .top = -1 };
+    int bpp = s->bpp;
     size_t len = (size_t)(rect->right - rect->left) * bpp;
     size_t lw, mw, rw, off;
     bool changed;
@@ -154,12 +259,12 @@ void simple_spice_damage_diff(const SimpleSpiceRect *rect, int bpp,
     }
 
     for (y = rect->top; y < rect->bottom; y++) {
-        const uint8_t *ra = a + y * a_stride + (size_t)rect->left * bpp;
-        const uint8_t *rb = b + y * b_stride + (size_t)rect->left * bpp;
+        const uint8_t *ra = s->a + y * s->a_stride + (size_t)rect->left * bpp;
+        const uint8_t *rb = s->b + y * s->b_stride + (size_t)rect->left * bpp;
 
-        if (box.top != -1 && y - box.bottom >= split_rows) {
+        if (box.top != -1 && y - box.bottom >= s->split_rows) {
             /* Nothing further down can join this box any more. */
-            func(opaque, &box);
+            emit_box(s, &box);
             box.top = -1;
         }
 
@@ -205,6 +310,27 @@ void simple_spice_damage_diff(const SimpleSpiceRect *rect, int bpp,
     }
 
     if (box.top != -1) {
-        func(opaque, &box);
+        emit_box(s, &box);
     }
 }
+
+void simple_spice_damage_diff(const SimpleSpiceRect *rect, int bpp,
+                              const uint8_t *a, size_t a_stride,
+                              const uint8_t *b, size_t b_stride,
+                              int split_rows, int split_cols,
+                              SimpleSpiceRectFunc func, void *opaque)
+{
+    DiffState s = {
+        .bpp = bpp,
+        .a = a,
+        .b = b,
+        .a_stride = a_stride,
+        .b_stride = b_stride,
+        .split_rows = split_rows,
+        .split_cols = split_cols,
+        .func = func,
+        .opaque = opaque,
+    };
+
+    diff_rect(&s, rect);
+}
