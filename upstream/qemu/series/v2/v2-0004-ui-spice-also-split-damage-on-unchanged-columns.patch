@@ -236,6 +238,7 @@ static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
                                  guest, surface_stride(ssd->ds),
                                  mirror, pixman_image_get_stride(ssd->mirror),
                                  SPICE_DISPLAY_SPLIT_ROWS,
