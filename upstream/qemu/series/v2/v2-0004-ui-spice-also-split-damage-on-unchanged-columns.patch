index 651ab74139..126677b67b 100644
--- a/ui/spice-damage.c
+++ b/ui/spice-damage.c
@@ -137,13 +137,118 @@ static size_t last_diff_end(const uint8_t *a, const uint8_t *b, size_t len)
     return hi;
 }
 
-void simple_spice_damage_diff(const SimpleSpiceRect *rect, int bpp,
-                              const uint8_t *a, size_t a_stride,
-                              const uint8_t *b, size_t b_stride,
-                              int split_rows,
