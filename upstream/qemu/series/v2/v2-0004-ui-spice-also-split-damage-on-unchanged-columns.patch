-                           Boxes *out)
+static bool pixel_changed(int bpp, const uint8_t *a, const uint8_t *b,
+                          int x, int y)
+{
+    size_t off = (y * W + x) * bpp;
+
+    return memcmp(a + off, b + off, bpp) != 0;
+}
+
+static void ref_rect(const SimpleSpiceRect *rect, int bpp,
+                     const uint8_t *a, const uint8_t *b,
+                     int split_rows, int split_cols, Boxes *out);
+
+static void ref_box(const SimpleSpiceRect *box, int bpp,
+                    const uint8_t *a, const uint8_t *b,
+                    int split_rows, int split_cols, Boxes *out)
+{
+    int x, y, gap = 0, start = -1, end = -1;
+    bool split = false;
+
+    if (split_cols > 0) {
+        for (x = box->left; x < box->right; x++) {
+            bool changed = false;
+
+            for (y = box->top; y < box->bottom && !changed; y++) {
+                changed = pixel_changed(bpp, a, b, x, y);
+            }
+            if (!changed) {
+                gap++;
+                continue;
+            }
+            if (start != -1 && gap >= split_cols) {
+                split = true;
+                ref_rect(&(SimpleSpiceRect) {
+                    .top = box->top, .left = start,
+                    .bottom = box->bottom, .right = end,
+                }, bpp, a, b, split_rows, split_cols, out);
+                start = -1;
+            }
+            if (start == -1) {
+                start = x;
+            }
+            end = x + 1;
+            gap = 0;
+        }
+    }
+    if (!split) {
+        collect(out, box);
+        return;
+    }
+    ref_rect(&(SimpleSpiceRect) {
+        .top = box->top, .left = start, .bottom = box->bottom, .right = end,
+    }, bpp, a, b, split_rows, split_cols, out);
+}
+
+static void ref_rect(const SimpleSpiceRect *rect, int bpp,
+                     const uint8_t *a, const uint8_t *b,
+                     int split_rows, int split_cols, Boxes *out)
 {
     SimpleSpiceRect box = { .top = -1 };
     int x, y;
 
-    out->num = 0;
     for (y = rect->top; y < rect->bottom; y++) {
         for (x = rect->left; x < rect->right; x++) {
-            size_t off = (y * W + x) * bpp;
-
-            if (memcmp(a + off, b + off, bpp) == 0) {
+            if (!pixel_changed(bpp, a, b, x, y)) {
                 continue;
             }
-            if (box.top != -1 && y - box.bottom >= split) {
-                collect(out, &box);
+            if (box.top != -1 && y - box.bottom >= split_rows) {
+                ref_box(&box, bpp, a, b, split_rows, split_cols, out);
                 box.top = -1;
             }
             if (box.top == -1) {
@@ -337,10 +395,68 @@ static void diff_reference(const SimpleSpiceRect *rect, int bpp,
         }
     }
     if (box.top != -1) {
-        collect(out, &box);
+        ref_box(&box, bpp, a, b, split_rows, split_cols, out);
     }
 }
 
+static void diff_reference(const SimpleSpiceRect *rect, int bpp,
+                           const uint8_t *a, const uint8_t *b,
+                           int split_rows, int split_cols, Boxes *out)
+{
+    out->num = 0;
+    ref_rect(rect, bpp, a, b, split_rows, split_cols, out);
+}
+
+static void test_diff_columns(void)
+{
+    const int bpp = 4;
+    g_autofree uint8_t *a = g_malloc0(W * H * bpp);
+    g_autofree uint8_t *b = g_malloc0(W * H * bpp);
+    SimpleSpiceRect all = { .left = 0, .top = 0, .right = W, .bottom = H };
+    Boxes boxes;
+    int x, y;
+
+    /* A "video" at 10..110 x 20..120 and a "clock" beside it. */
+    for (y = 20; y < 120; y++) {
+        for (x = 10; x < 110; x++) {
+            set_pixel(a, bpp, x, y);
+        }
+    }
+    for (y = 50; y < 60; y++) {
+        for (x = 200; x < 240; x++) {
+            set_pixel(a, bpp, x, y);
+        }
+    }
+
+    /* Rows only: one box around both. */
+    diff_split(&all, bpp, a, b, 32, 0, &boxes);
+    g_assert_cmpint(boxes.num, ==, 1);
+    g_assert_true(rect_eq(&boxes.box[0], 10, 20, 240, 120));
+
+    /* With columns: each keeps its own box, trimmed vertically too. */
+    diff_split(&all, bpp, a, b, 32, 32, &boxes);
+    g_assert_cmpint(boxes.num, ==, 2);
+    g_assert_true(rect_eq(&boxes.box[0], 10, 20, 110, 120));
+    g_assert_true(rect_eq(&boxes.box[1], 200, 50, 240, 60));
+
+    /* A gap narrower than split_cols does not split. */
+    diff_split(&all, bpp, a, b, 32, 91, &boxes);
+    g_assert_cmpint(boxes.num, ==, 1);
+    diff_split(&all, bpp, a, b, 32, 90, &boxes);
+    g_assert_cmpint(boxes.num, ==, 2);
+
+    /*
+     * Splitting on columns can expose a split on rows: the clock sits in
+     * the rows of a second change further right, which is far below it.
+     */
+    set_pixel(a, bpp, 220, 150);
+    diff_split(&all, bpp, a, b, 32, 32, &boxes);
+    g_assert_cmpint(boxes.num, ==, 3);
+    g_assert_true(rect_eq(&boxes.box[0], 10, 20, 110, 120));
+    g_assert_true(rect_eq(&boxes.box[1], 200, 50, 240, 60));
+    g_assert_true(rect_eq(&boxes.box[2], 220, 150, 221, 151));
+}
