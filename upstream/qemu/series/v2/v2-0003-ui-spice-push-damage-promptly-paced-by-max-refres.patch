From 7a6a5368f1b98b2f5ecc1105ff5dcdeaee2f2bce Mon Sep 17 00:00:00 2001
From: Michael Still <mikal@stillhq.com>
Date: Wed, 23 Sep 2026 21:36:32 +1000
Subject: [PATCH v2 3/4] ui/spice: push damage promptly, paced by
 max-refresh-rate

Without gl=on, damage reported through dpy_gfx_update() only reaches
the spice server on the next display refresh, which runs every
GUI_REFRESH_INTERVAL_DEFAULT (30ms). Devices that report damage as it
happens, such as virtio-gpu on RESOURCE_FLUSH, therefore see up to
30ms of added latency, and frame pacing is set by the refresh timer
rather than by the guest.

Arm a timer when damage arrives so that it is converted to QXL
commands and the spice worker is woken straight away, but no more
often than max-refresh-rate allows (default 30, i.e. every 33ms). If
the server still holds the previous updates, the timer retries after
another interval. The refresh path is unchanged, so VGA and other
devices that only report damage from their gfx_update callback behave
as before, as does qxl in VGA mode, which has its own display listener.

max-refresh-rate already caps how often the GL path submits draws to
the server; applying it here too keeps a single knob with one meaning,
and the default matches spice-server's own 30 fps limit for video
streams, so no new option is needed. With a Linux guest playing a
30 fps video on virtio-vga, damage to QXL command latency drops from
p50 15ms / p95 28ms to p50 0.2ms / p95 1.8ms (0.3ms with
max-refresh-rate=60).

Prompt: Decide how the prompt push interval is configured, looking at
how max-refresh-rate and the GL refresh are handled upstream, and
implement the least surprising option with documentation.

Co-Authored-By: Claude Opus 5.5 (1M context, low effort) <noreply@anthropic.com>
---
 include/ui/spice-display.h |  2 ++
 qemu-options.hx            |  2 ++
 ui/spice-display.c         | 55 +++++++++++++++++++++++++++++++++++---
 3 files changed, 56 insertions(+), 3 deletions(-)

diff --git a/include/ui/spice-display.h b/include/ui/spice-display.h
index 2b873131c3..a89a77da0a 100644
--- a/include/ui/spice-display.h
+++ b/include/ui/spice-display.h
@@ -97,6 +97,8 @@ struct SimpleSpiceDisplay {
 
     SimpleSpiceDamage dirty;
     int notify;
+    QEMUTimer *update_timer;
+    int64_t last_update_ms;
 
     /*
      * All struct members below this comment can be accessed from
diff --git a/qemu-options.hx b/qemu-options.hx
index e44b47de68..a2a66212e1 100644
--- a/qemu-options.hx
+++ b/qemu-options.hx
@@ -2541,6 +2541,8 @@ SRST
     ``max-refresh-rate=rate``
         Provide the maximum refresh rate (or FPS) at which the encoding
         requests should be sent to the Spice server. Default would be 30.
+        Without ``gl=on``, display updates are sent to the Spice server
+        as soon as the guest reports them, but no more often than this.
 
     ``gl=on|off``
         Enable/disable OpenGL context. Default is off.
diff --git a/ui/spice-display.c b/ui/spice-display.c
index 9237af119f..903ffca6fe 100644
--- a/ui/spice-display.c
+++ b/ui/spice-display.c
@@ -357,6 +357,15 @@ void qemu_spice_display_init_common(SimpleSpiceDisplay *ssd)
 
 /* display listener callbacks */
 
+/*
+ * Minimum interval between two batches of damage pushed to the spice
+ * server outside the display refresh timer.
+ */
+static int64_t qemu_spice_update_interval_ms(void)
+{
+    return 1000 / spice_max_refresh_rate;
+}
+
 void qemu_spice_display_update(SimpleSpiceDisplay *ssd,
                                int x, int y, int w, int h)
 {
@@ -366,6 +375,16 @@ void qemu_spice_display_update(SimpleSpiceDisplay *ssd,
         ssd->notify++;
     }
     simple_spice_damage_add(&ssd->dirty, x, y, w, h);
+
+    /*
+     * Push the damage to the spice server now rather than on the next
+     * display refresh, but no more often than max-refresh-rate allows.
+     */
+    if (ssd->update_timer && !timer_pending(ssd->update_timer)) {
+        timer_mod(ssd->update_timer,
+                  MAX(qemu_clock_get_ms(QEMU_CLOCK_REALTIME),
+                      ssd->last_update_ms + qemu_spice_update_interval_ms()));
+    }
 }
 
 void qemu_spice_display_switch(SimpleSpiceDisplay *ssd,
@@ -467,12 +486,13 @@ void qemu_spice_cursor_refresh_bh(void *opaque)
     }
 }
 
-void qemu_spice_display_refresh(SimpleSpiceDisplay *ssd)
+static void qemu_spice_display_flush(SimpleSpiceDisplay *ssd)
 {
-    qemu_console_hw_update(ssd->dcl.con);
-
     WITH_QEMU_LOCK_GUARD(&ssd->lock) {
         if (QTAILQ_EMPTY(&ssd->updates) && ssd->ds) {
+            if (!simple_spice_damage_is_empty(&ssd->dirty)) {
+                ssd->last_update_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+            }
             qemu_spice_create_update(ssd);
             ssd->notify++;
         }
@@ -485,6 +505,30 @@ void qemu_spice_display_refresh(SimpleSpiceDisplay *ssd)
     }
 }
 
+void qemu_spice_display_refresh(SimpleSpiceDisplay *ssd)
+{
+    qemu_console_hw_update(ssd->dcl.con);
+    qemu_spice_display_flush(ssd);
+}
+
+static void qemu_spice_update_timer_cb(void *opaque)
+{
+    SimpleSpiceDisplay *ssd = opaque;
+
+    qemu_spice_display_flush(ssd);
+
+    /*
+     * If the spice server has not consumed the previous updates yet, the
+     * damage is still pending: retry after another interval rather than
+     * leaving it to the display refresh.
+     */
+    if (!simple_spice_damage_is_empty(&ssd->dirty)) {
+        timer_mod(ssd->update_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_REALTIME) +
+                  qemu_spice_update_interval_ms());
+    }
+}
+
 /* spice display interface callbacks */
 
 static void interface_attached_worker(QXLInstance *sin)
@@ -1383,6 +1427,10 @@ static void qemu_spice_display_init_one(QemuConsole *con)
         ssd->have_scanout = false;
     }
 #endif
+    if (!spice_opengl) {
+        ssd->update_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                         qemu_spice_update_timer_cb, ssd);
+    }
     ssd->qxl.base.sif = &dpy_interface.base;
     qemu_spice_add_display_interface(&ssd->qxl, con);
 
@@ -1437,6 +1485,7 @@ void qemu_spice_display_cleanup(void)
         g_clear_pointer(&ssd->surface, pixman_image_unref);
         g_clear_pointer(&ssd->mirror, pixman_image_unref);
         g_clear_pointer(&ssd->buf, g_free);
+        g_clear_pointer(&ssd->update_timer, timer_free);
 #ifdef HAVE_SPICE_GL
         g_clear_pointer(&ssd->gl_unblock_bh, qemu_bh_delete);
         g_clear_pointer(&ssd->gl_unblock_timer, timer_free);
-- 
2.47.3

