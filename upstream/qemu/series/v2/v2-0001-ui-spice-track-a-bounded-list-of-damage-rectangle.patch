--- /dev/null
+++ b/include/ui/spice-damage.h
@@ -0,0 +1,56 @@
+/*
+ * Damage tracking helpers for the simple spice display
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef UI_SPICE_DAMAGE_H
+#define UI_SPICE_DAMAGE_H
+
+/*
+ * A rectangle in pixels, with exclusive right and bottom edges; the
+ * same layout as QXLRect but without the dependency on spice headers.
+ */
+typedef struct SimpleSpiceRect {
+    int top;
+    int left;
+    int bottom;
+    int right;
+} SimpleSpiceRect;
+
+/*
+ * Maximum number of damage rectangles tracked between two updates.
+ * Beyond that, rectangles are merged into their neighbours.
+ */
+#define SIMPLE_SPICE_DAMAGE_MAX_RECTS 16
+
+/*
+ * A bounded list of pairwise disjoint (neither overlapping nor
+ * touching) damage rectangles.
+ */
+typedef struct SimpleSpiceDamage {
+    SimpleSpiceRect rects[SIMPLE_SPICE_DAMAGE_MAX_RECTS];
+    int num_rects;
+} SimpleSpiceDamage;
+
+static inline void simple_spice_damage_clear(SimpleSpiceDamage *damage)
+{
+    damage->num_rects = 0;
+}
+
+static inline bool simple_spice_damage_is_empty(const SimpleSpiceDamage *d)
+{
+    return d->num_rects == 0;
+}
+
+/*
+ * Add the rectangle at (@x, @y) of size @w x @h to @damage. Empty
+ * rectangles are ignored. A rectangle that overlaps or touches existing
+ * damage is merged with it into their bounding box. When the list is
+ * full, the new rectangle is merged with the existing one whose bounding
+ * box grows the least.
+ */
+void simple_spice_damage_add(SimpleSpiceDamage *damage,
+                             int x, int y, int w, int h);
+
+#endif /* UI_SPICE_DAMAGE_H */
