new file mode 100644
index 0000000000..c30be4e266
--- /dev/null
+++ b/ui/spice-damage.c
@@ -0,0 +1,88 @@
+/*
+ * Damage tracking helpers for the simple spice display
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "ui/spice-damage.h"
+
+/* True if @a and @b overlap or share an edge. */
+static bool rect_adjacent(const SimpleSpiceRect *a, const SimpleSpiceRect *b)
+{
+    return a->left <= b->right && b->left <= a->right &&
+           a->top <= b->bottom && b->top <= a->bottom;
+}
+
+static void rect_union(SimpleSpiceRect *dest, const SimpleSpiceRect *r)
+{
+    dest->top = MIN(dest->top, r->top);
+    dest->left = MIN(dest->left, r->left);
+    dest->bottom = MAX(dest->bottom, r->bottom);
+    dest->right = MAX(dest->right, r->right);
+}
+
+static int64_t rect_area(const SimpleSpiceRect *r)
+{
+    return (int64_t)(r->right - r->left) * (r->bottom - r->top);
+}
+
+/* Remove rects[@i], keeping the list compact. */
+static void damage_remove(SimpleSpiceDamage *damage, int i)
+{
+    damage->rects[i] = damage->rects[--damage->num_rects];
+}
+
+void simple_spice_damage_add(SimpleSpiceDamage *damage,
+                             int x, int y, int w, int h)
+{
+    SimpleSpiceRect merged = {
+        .top = y,
+        .left = x,
+        .bottom = y + h,
+        .right = x + w,
+    };
+    int i, best;
+    int64_t growth, best_growth;
+
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+
+    for (;;) {
+        /* Absorb everything the new rectangle overlaps or touches. */
+        for (i = 0; i < damage->num_rects; i++) {
+            if (rect_adjacent(&damage->rects[i], &merged)) {
+                rect_union(&merged, &damage->rects[i]);
+                damage_remove(damage, i);
+                /* The union may now reach rectangles already checked. */
+                i = -1;
+            }
+        }
+
+        if (damage->num_rects < SIMPLE_SPICE_DAMAGE_MAX_RECTS) {
+            damage->rects[damage->num_rects++] = merged;
+            return;
+        }
+
+        /*
+         * The list is full: merge with the rectangle whose bounding box
+         * with the new one grows the least, then check the result for
+         * overlaps again.
+         */
+        best = 0;
+        best_growth = INT64_MAX;
+        for (i = 0; i < damage->num_rects; i++) {
+            SimpleSpiceRect u = merged;
+
+            rect_union(&u, &damage->rects[i]);
+            growth = rect_area(&u) - rect_area(&damage->rects[i]);
+            if (growth < best_growth) {
+                best = i;
+                best_growth = growth;
+            }
+        }
+        rect_union(&merged, &damage->rects[best]);
+        damage_remove(damage, best);
+    }
+}
