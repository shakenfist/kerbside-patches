diff --git a/tests/unit/test-spice-damage.c b/tests/unit/test-spice-damage.c
new file mode 100644
index 0000000000..276d354872
--- /dev/null
+++ b/tests/unit/test-spice-damage.c
@@ -0,0 +1,204 @@
+/*
+ * Unit tests for the simple spice display damage helpers
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "ui/spice-damage.h"
+
+static bool rect_eq(const SimpleSpiceRect *r,
+                    int left, int top, int right, int bottom)
+{
+    return r->left == left && r->top == top &&
+           r->right == right && r->bottom == bottom;
+}
+
+static bool rect_contains(const SimpleSpiceRect *outer,
+                          const SimpleSpiceRect *inner)
+{
+    return outer->left <= inner->left && outer->top <= inner->top &&
+           outer->right >= inner->right && outer->bottom >= inner->bottom;
+}
+
+static bool rect_adjacent(const SimpleSpiceRect *a, const SimpleSpiceRect *b)
+{
+    return a->left <= b->right && b->left <= a->right &&
+           a->top <= b->bottom && b->top <= a->bottom;
+}
+
+static void test_add_empty(void)
+{
+    SimpleSpiceDamage d;
+
+    simple_spice_damage_clear(&d);
+    g_assert_true(simple_spice_damage_is_empty(&d));
+    simple_spice_damage_add(&d, 10, 10, 0, 5);
+    simple_spice_damage_add(&d, 10, 10, 5, 0);
+    simple_spice_damage_add(&d, 10, 10, -1, 5);
+    g_assert_true(simple_spice_damage_is_empty(&d));
+}
+
+static void test_add_disjoint(void)
+{
+    SimpleSpiceDamage d;
+
+    simple_spice_damage_clear(&d);
+    simple_spice_damage_add(&d, 0, 0, 10, 10);
+    simple_spice_damage_add(&d, 100, 100, 10, 10);
+    g_assert_cmpint(d.num_rects, ==, 2);
+    g_assert_true(rect_eq(&d.rects[0], 0, 0, 10, 10));
+    g_assert_true(rect_eq(&d.rects[1], 100, 100, 110, 110));
+
+    simple_spice_damage_clear(&d);
+    g_assert_true(simple_spice_damage_is_empty(&d));
+}
+
+static void test_add_overlap(void)
+{
+    SimpleSpiceDamage d;
+
+    simple_spice_damage_clear(&d);
+    simple_spice_damage_add(&d, 0, 0, 10, 10);
+    simple_spice_damage_add(&d, 5, 5, 10, 10);
+    g_assert_cmpint(d.num_rects, ==, 1);
+    g_assert_true(rect_eq(&d.rects[0], 0, 0, 15, 15));
+
+    /* Contained damage changes nothing. */
+    simple_spice_damage_add(&d, 2, 2, 3, 3);
+    g_assert_cmpint(d.num_rects, ==, 1);
+    g_assert_true(rect_eq(&d.rects[0], 0, 0, 15, 15));
+}
+
+static void test_add_touching(void)
+{
+    SimpleSpiceDamage d;
+
+    /* Scanline bands reported one after the other end up as one. */
+    simple_spice_damage_clear(&d);
+    simple_spice_damage_add(&d, 0, 0, 640, 10);
+    simple_spice_damage_add(&d, 0, 10, 640, 10);
+    g_assert_cmpint(d.num_rects, ==, 1);
+    g_assert_true(rect_eq(&d.rects[0], 0, 0, 640, 20));
+}
+
+static void test_add_bridge(void)
+{
+    SimpleSpiceDamage d;
+
+    /* A rectangle joining two others absorbs both. */
+    simple_spice_damage_clear(&d);
+    simple_spice_damage_add(&d, 0, 0, 10, 10);
+    simple_spice_damage_add(&d, 50, 0, 10, 10);
+    simple_spice_damage_add(&d, 200, 200, 10, 10);
+    g_assert_cmpint(d.num_rects, ==, 3);
+    simple_spice_damage_add(&d, 5, 5, 50, 1);
+    g_assert_cmpint(d.num_rects, ==, 2);
+    g_assert_true(rect_eq(&d.rects[0], 200, 200, 210, 210) ||
+                  rect_eq(&d.rects[1], 200, 200, 210, 210));
+    g_assert_true(rect_eq(&d.rects[0], 0, 0, 60, 10) ||
+                  rect_eq(&d.rects[1], 0, 0, 60, 10));
+}
+
+static void test_add_cascade(void)
+{
+    SimpleSpiceDamage d;
+
+    /*
+     * The union of the new rectangle and the first one it meets reaches
+     * a rectangle that the new one alone does not touch.
+     */
+    simple_spice_damage_clear(&d);
+    simple_spice_damage_add(&d, 100, 0, 10, 100);   /* tall, at x 100 */
+    simple_spice_damage_add(&d, 0, 90, 10, 10);     /* bottom left */
+    g_assert_cmpint(d.num_rects, ==, 2);
+    simple_spice_damage_add(&d, 105, 0, 1, 1);      /* inside the tall one */
+    g_assert_cmpint(d.num_rects, ==, 2);
+    simple_spice_damage_add(&d, 5, 0, 1, 1);        /* top left */
+    g_assert_cmpint(d.num_rects, ==, 3);
+    /* Joins top left and tall; the union then covers bottom left too. */
+    simple_spice_damage_add(&d, 6, 0, 94, 1);
+    g_assert_cmpint(d.num_rects, ==, 1);
+    g_assert_true(rect_eq(&d.rects[0], 0, 0, 110, 100));
+}
+
+static void test_add_overflow(void)
+{
+    SimpleSpiceDamage d;
+    int i;
+
+    /* A row of small rectangles, 100 pixels apart. */
+    simple_spice_damage_clear(&d);
+    for (i = 0; i < SIMPLE_SPICE_DAMAGE_MAX_RECTS; i++) {
+        simple_spice_damage_add(&d, i * 100, 0, 10, 10);
+    }
+    g_assert_cmpint(d.num_rects, ==, SIMPLE_SPICE_DAMAGE_MAX_RECTS);
+
+    /* One more, closest to the first: only that pair merges. */
+    simple_spice_damage_add(&d, 20, 0, 10, 10);
+    g_assert_cmpint(d.num_rects, ==, SIMPLE_SPICE_DAMAGE_MAX_RECTS);
+    for (i = 0; i < d.num_rects; i++) {
+        if (d.rects[i].left == 0) {
+            g_assert_true(rect_eq(&d.rects[i], 0, 0, 30, 10));
+        } else {
+            g_assert_cmpint(d.rects[i].right - d.rects[i].left, ==, 10);
+        }
+    }
+}
+
+static void test_add_random(void)
+{
+    SimpleSpiceDamage d;
+    SimpleSpiceRect added[256];
+    GRand *rand = g_rand_new_with_seed(1);
+    int iter, n, i, j;
+
+    for (iter = 0; iter < 200; iter++) {
+        simple_spice_damage_clear(&d);
+        for (n = 0; n < ARRAY_SIZE(added); n++) {
+            int x = g_rand_int_range(rand, 0, 1920);
+            int y = g_rand_int_range(rand, 0, 1080);
+            int w = g_rand_int_range(rand, 1, 64);
+            int h = g_rand_int_range(rand, 1, 64);
+
+            added[n] = (SimpleSpiceRect) {
+                .left = x, .top = y, .right = x + w, .bottom = y + h,
+            };
+            simple_spice_damage_add(&d, x, y, w, h);
+
+            g_assert_cmpint(d.num_rects, >=, 1);
+            g_assert_cmpint(d.num_rects, <=, SIMPLE_SPICE_DAMAGE_MAX_RECTS);
+            for (i = 0; i < d.num_rects; i++) {
+                for (j = i + 1; j < d.num_rects; j++) {
+                    g_assert_false(rect_adjacent(&d.rects[i], &d.rects[j]));
+                }
+            }
+        }
+        /* Nothing that was added is lost. */
+        for (n = 0; n < ARRAY_SIZE(added); n++) {
+            for (i = 0; i < d.num_rects; i++) {
+                if (rect_contains(&d.rects[i], &added[n])) {
+                    break;
+                }
+            }
+            g_assert_cmpint(i, <, d.num_rects);
+        }
+    }
+    g_rand_free(rand);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    g_test_add_func("/spice-damage/add/empty", test_add_empty);
+    g_test_add_func("/spice-damage/add/disjoint", test_add_disjoint);
+    g_test_add_func("/spice-damage/add/overlap", test_add_overlap);
+    g_test_add_func("/spice-damage/add/touching", test_add_touching);
+    g_test_add_func("/spice-damage/add/bridge", test_add_bridge);
+    g_test_add_func("/spice-damage/add/cascade", test_add_cascade);
+    g_test_add_func("/spice-damage/add/overflow", test_add_overflow);
+    g_test_add_func("/spice-damage/add/random", test_add_random);
+
+    return g_test_run();
+}
