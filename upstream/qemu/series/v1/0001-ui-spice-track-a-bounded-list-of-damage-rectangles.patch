From 3240cb8aa3c928474ded99932fe8e7a710bed33d Mon Sep 17 00:00:00 2001
From: Michael Still <mikal@stillhq.com>
Date: Wed, 23 Sep 2026 18:23:04 +1000
Subject: [PATCH 1/3] ui/spice: track a bounded list of damage rectangles

SimpleSpiceDisplay accumulates every dpy_gfx_update() between two
refreshes into a single bounding box. Two small, distant updates (a
video region and a clock in the corner, say) therefore become one large
box, and the whole box is then diffed against the mirror surface.

Keep up to SPICE_DISPLAY_MAX_DIRTY_RECTS pairwise-disjoint rectangles
instead. A rectangle that overlaps pending damage is merged with it
into their bounding box, and if the list overflows all damage collapses
into one bounding box, which is the previous behaviour.

The per-rectangle update generation is unchanged in this patch: each
rectangle is still diffed and sliced into 32 pixel columns. The next
patch changes that.
---
 hw/display/qxl.c           |  2 +-
 include/ui/spice-display.h | 10 ++++-
 ui/spice-display.c         | 80 ++++++++++++++++++++++++++++++--------
 3 files changed, 74 insertions(+), 18 deletions(-)

diff --git a/hw/display/qxl.c b/hw/display/qxl.c
index 74258afa58..77cd84d519 100644
--- a/hw/display/qxl.c
+++ b/hw/display/qxl.c
@@ -1207,7 +1207,7 @@ static void qxl_reset_state(PCIQXLDevice *d)
     init_qxl_ram(d);
     d->num_free_res = 0;
     d->last_release = NULL;
-    memset(&d->ssd.dirty, 0, sizeof(d->ssd.dirty));
+    qemu_spice_display_clear_dirty(&d->ssd);
     qxl_update_irq(d);
 }
 
diff --git a/include/ui/spice-display.h b/include/ui/spice-display.h
index a382553fa8..2465ebe0b6 100644
--- a/include/ui/spice-display.h
+++ b/include/ui/spice-display.h
@@ -78,6 +78,12 @@ typedef struct QXLCookie {
 
 QXLCookie *qxl_cookie_new(int type, uint64_t io);
 
+/*
+ * Maximum number of disjoint damage rectangles tracked between two
+ * updates. When more arrive, the damage collapses into its bounding box.
+ */
+#define SPICE_DISPLAY_MAX_DIRTY_RECTS 16
+
 typedef struct SimpleSpiceDisplay SimpleSpiceDisplay;
 typedef struct SimpleSpiceUpdate SimpleSpiceUpdate;
 typedef struct SimpleSpiceCursor SimpleSpiceCursor;
@@ -94,7 +100,8 @@ struct SimpleSpiceDisplay {
     pixman_image_t *mirror;
     int32_t num_surfaces;
 
-    QXLRect dirty;
+    QXLRect dirty[SPICE_DISPLAY_MAX_DIRTY_RECTS];
+    int num_dirty;
     int notify;
 
     /*
@@ -169,6 +176,7 @@ void qemu_spice_display_init_common(SimpleSpiceDisplay *ssd);
 
 void qemu_spice_display_update(SimpleSpiceDisplay *ssd,
                                int x, int y, int w, int h);
+void qemu_spice_display_clear_dirty(SimpleSpiceDisplay *ssd);
 void qemu_spice_display_switch(SimpleSpiceDisplay *ssd,
                                DisplaySurface *surface);
 void qemu_spice_display_refresh(SimpleSpiceDisplay *ssd);
diff --git a/ui/spice-display.c b/ui/spice-display.c
index 75c7df7bb5..708e5a58aa 100644
--- a/ui/spice-display.c
+++ b/ui/spice-display.c
@@ -191,7 +191,8 @@ static void qemu_spice_create_one_update(SimpleSpiceDisplay *ssd,
     QTAILQ_INSERT_TAIL(&ssd->updates, update, next);
 }
 
-static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
+static void qemu_spice_create_rect_updates(SimpleSpiceDisplay *ssd,
+                                           const QXLRect *dirty)
 {
     static const int blksize = 32;
     int blocks = DIV_ROUND_UP(surface_width(ssd->ds), blksize);
@@ -200,10 +201,6 @@ static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
     int bpp = surface_bytes_per_pixel(ssd->ds);
     uint8_t *guest, *mirror;
 
-    if (qemu_spice_rect_is_empty(&ssd->dirty)) {
-        return;
-    };
-
     dirty_top = g_new(int, blocks);
     for (blk = 0; blk < blocks; blk++) {
         dirty_top[blk] = -1;
@@ -211,13 +208,13 @@ static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
 
     guest = surface_data(ssd->ds);
     mirror = (void *)pixman_image_get_data(ssd->mirror);
-    for (y = ssd->dirty.top; y < ssd->dirty.bottom; y++) {
+    for (y = dirty->top; y < dirty->bottom; y++) {
         yoff1 = y * surface_stride(ssd->ds);
         yoff2 = y * pixman_image_get_stride(ssd->mirror);
-        for (x = ssd->dirty.left; x < ssd->dirty.right; x += blksize) {
+        for (x = dirty->left; x < dirty->right; x += blksize) {
             xoff = x * bpp;
             blk = x / blksize;
-            bw = MIN(blksize, ssd->dirty.right - x);
+            bw = MIN(blksize, dirty->right - x);
             if (memcmp(guest + yoff1 + xoff,
                        mirror + yoff2 + xoff,
                        bw * bpp) == 0) {
@@ -239,13 +236,13 @@ static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
         }
     }
 
-    for (x = ssd->dirty.left; x < ssd->dirty.right; x += blksize) {
+    for (x = dirty->left; x < dirty->right; x += blksize) {
         blk = x / blksize;
-        bw = MIN(blksize, ssd->dirty.right - x);
+        bw = MIN(blksize, dirty->right - x);
         if (dirty_top[blk] != -1) {
             QXLRect update = {
                 .top    = dirty_top[blk],
-                .bottom = ssd->dirty.bottom,
+                .bottom = dirty->bottom,
                 .left   = x,
                 .right  = x + bw,
             };
@@ -253,8 +250,16 @@ static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
             dirty_top[blk] = -1;
         }
     }
+}
+
+static void qemu_spice_create_update(SimpleSpiceDisplay *ssd)
+{
+    int i;
 
-    memset(&ssd->dirty, 0, sizeof(ssd->dirty));
+    for (i = 0; i < ssd->num_dirty; i++) {
+        qemu_spice_create_rect_updates(ssd, &ssd->dirty[i]);
+    }
+    qemu_spice_display_clear_dirty(ssd);
 }
 
 static SimpleSpiceCursor*
@@ -371,6 +376,46 @@ void qemu_spice_display_init_common(SimpleSpiceDisplay *ssd)
     }
 }
 
+void qemu_spice_display_clear_dirty(SimpleSpiceDisplay *ssd)
+{
+    ssd->num_dirty = 0;
+}
+
+static bool qemu_spice_rect_intersects(const QXLRect *a, const QXLRect *b)
+{
+    return a->left < b->right && b->left < a->right &&
+           a->top < b->bottom && b->top < a->bottom;
+}
+
+/*
+ * Add @rect to the pending damage. The list is kept pairwise disjoint:
+ * a rectangle that overlaps existing damage absorbs it into their
+ * bounding box. When the list is full, all damage collapses into a
+ * single bounding box, which is what was tracked before the list.
+ */
+static void qemu_spice_add_dirty(SimpleSpiceDisplay *ssd, const QXLRect *rect)
+{
+    QXLRect merged = *rect;
+    int i;
+
+restart:
+    for (i = 0; i < ssd->num_dirty; i++) {
+        if (qemu_spice_rect_intersects(&ssd->dirty[i], &merged)) {
+            qemu_spice_rect_union(&merged, &ssd->dirty[i]);
+            ssd->dirty[i] = ssd->dirty[--ssd->num_dirty];
+            goto restart;
+        }
+    }
+
+    if (ssd->num_dirty == SPICE_DISPLAY_MAX_DIRTY_RECTS) {
+        for (i = 0; i < ssd->num_dirty; i++) {
+            qemu_spice_rect_union(&merged, &ssd->dirty[i]);
+        }
+        ssd->num_dirty = 0;
+    }
+    ssd->dirty[ssd->num_dirty++] = merged;
+}
+
 /* display listener callbacks */
 
 void qemu_spice_display_update(SimpleSpiceDisplay *ssd,
@@ -384,10 +429,13 @@ void qemu_spice_display_update(SimpleSpiceDisplay *ssd,
     update_area.top = y;
     update_area.bottom = y + h;
 
-    if (qemu_spice_rect_is_empty(&ssd->dirty)) {
+    if (qemu_spice_rect_is_empty(&update_area)) {
+        return;
+    }
+    if (ssd->num_dirty == 0) {
         ssd->notify++;
     }
-    qemu_spice_rect_union(&ssd->dirty, &update_area);
+    qemu_spice_add_dirty(ssd, &update_area);
 }
 
 void qemu_spice_display_switch(SimpleSpiceDisplay *ssd,
@@ -422,7 +470,7 @@ void qemu_spice_display_switch(SimpleSpiceDisplay *ssd,
                                      surface_height(surface),
                                      false);
 
-    memset(&ssd->dirty, 0, sizeof(ssd->dirty));
+    qemu_spice_display_clear_dirty(ssd);
     if (ssd->surface) {
         pixman_image_unref(ssd->surface);
         ssd->surface = NULL;
@@ -448,7 +496,7 @@ void qemu_spice_display_switch(SimpleSpiceDisplay *ssd,
         qemu_spice_create_host_primary(ssd);
     }
 
-    memset(&ssd->dirty, 0, sizeof(ssd->dirty));
+    qemu_spice_display_clear_dirty(ssd);
     ssd->notify++;
 
     qemu_mutex_lock(&ssd->lock);
-- 
